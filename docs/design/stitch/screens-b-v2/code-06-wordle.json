{"screenId":"961a9b58dff644419687fe2ed3eef430","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" name=\"viewport\"/>\n<title>VisionSetil - Wordle de Setas</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;family=Hanken+Grotesk:wght@400;600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"surface-dim\": \"#121412\",\n                    \"surface-variant\": \"#333533\",\n                    \"secondary-fixed\": \"#e4e4cc\",\n                    \"error\": \"#ffb4ab\",\n                    \"on-primary-fixed-variant\": \"#2e4d3c\",\n                    \"on-background\": \"#e3e3df\",\n                    \"on-primary\": \"#173627\",\n                    \"error-container\": \"#93000a\",\n                    \"on-primary-container\": \"#99bca6\",\n                    \"outline\": \"#8c928c\",\n                    \"tertiary-fixed-dim\": \"#ffb4a8\",\n                    \"on-tertiary-fixed-variant\": \"#920703\",\n                    \"surface-tint\": \"#accfb8\",\n                    \"primary-fixed\": \"#c7ebd4\",\n                    \"inverse-primary\": \"#466553\",\n                    \"on-surface\": \"#e3e3df\",\n                    \"on-secondary-fixed-variant\": \"#474836\",\n                    \"secondary\": \"#c8c8b0\",\n                    \"background\": \"#121412\",\n                    \"on-secondary-fixed\": \"#1b1d0e\",\n                    \"on-surface-variant\": \"#c2c8c1\",\n                    \"on-secondary\": \"#303221\",\n                    \"surface-container-low\": \"#1a1c1a\",\n                    \"surface-container-highest\": \"#333533\",\n                    \"on-tertiary-container\": \"#ff9787\",\n                    \"inverse-on-surface\": \"#2f312f\",\n                    \"secondary-fixed-dim\": \"#c8c8b0\",\n                    \"outline-variant\": \"#424843\",\n                    \"on-secondary-container\": \"#b9baa3\",\n                    \"secondary-container\": \"#494a38\",\n                    \"on-error\": \"#690005\",\n                    \"surface\": \"#121412\",\n                    \"tertiary-fixed\": \"#ffdad4\",\n                    \"surface-bright\": \"#383a38\",\n                    \"inverse-surface\": \"#e3e3df\",\n                    \"on-tertiary\": \"#690000\",\n                    \"surface-container-lowest\": \"#0d0f0d\",\n                    \"primary-container\": \"#2d4c3b\",\n                    \"surface-container-high\": \"#292a29\",\n                    \"primary\": \"#accfb8\",\n                    \"on-primary-fixed\": \"#012113\",\n                    \"on-tertiary-fixed\": \"#410000\",\n                    \"tertiary-container\": \"#900502\",\n                    \"tertiary\": \"#ffb4a8\",\n                    \"surface-container\": \"#1e201e\",\n                    \"primary-fixed-dim\": \"#accfb8\",\n                    \"on-error-container\": \"#ffdad6\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"gutter\": \"16px\",\n                    \"container-padding\": \"20px\",\n                    \"stack-lg\": \"48px\",\n                    \"base\": \"8px\",\n                    \"stack-sm\": \"12px\",\n                    \"stack-md\": \"24px\",\n                    \"margin-mobile\": \"20px\"\n            },\n            \"fontFamily\": {\n                    \"title-lg\": [\"Hanken Grotesk\"],\n                    \"body-lg\": [\"Hanken Grotesk\"],\n                    \"label-sm\": [\"Hanken Grotesk\"],\n                    \"label-lg\": [\"Hanken Grotesk\"],\n                    \"headline-md-mobile\": [\"Playfair Display\"],\n                    \"headline-md\": [\"Playfair Display\"],\n                    \"display-lg\": [\"Playfair Display\"],\n                    \"body-md\": [\"Hanken Grotesk\"]\n            },\n            \"fontSize\": {\n                    \"title-lg\": [\"20px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"600\"}],\n                    \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}],\n                    \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"700\"}],\n                    \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"fontWeight\": \"600\"}],\n                    \"headline-md-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}],\n                    \"headline-md\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                    \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}]\n            }\n          },\n        },\n      }\n    </script>\n<style>\n        body {\n            background-color: #121412;\n            color: #e3e3df;\n            -webkit-tap-highlight-color: transparent;\n        }\n        .glass-panel {\n            background: rgba(26, 28, 26, 0.65);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(228, 228, 204, 0.1);\n        }\n        .key-active { transform: scale(0.95); background: rgba(172, 207, 184, 0.2); }\n        .grid-cell {\n            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n        }\n        .cell-pop { transform: scale(1.1); border-color: #accfb8; }\n        \n        /* Shimmer for the top warning */\n        @keyframes shimmer {\n            0% { opacity: 0.8; }\n            50% { opacity: 1; }\n            100% { opacity: 0.8; }\n        }\n        .warning-glow { animation: shimmer 3s infinite ease-in-out; }\n\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n    </style>\n</head>\n<body class=\"font-body-md overflow-hidden h-screen flex flex-col\">\n<!-- Immersion Background -->\n<div class=\"fixed inset-0 z-0 pointer-events-none opacity-20 grayscale scale-110\">\n<img alt=\"Forest Background\" class=\"w-full h-full object-cover blur-sm\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLv9F1NngRZMGjTxRQYKiPvpD7A9hSxejzmW887CYfr7Y6IAC6tnmHS3l84f8AUutQQSCx6UODZ1xoPa_jSCsIzRVlLtubWlezlz-q9rZyVRFHLD5-TSETsFZ9lGDkJiIInVZKFvho-EvyyhKECC0SYj9iFGIFbH6Rr8mcC5QUHns1ylOeCOT01qbDLfmwrbrPJ_P-kTqN8NMMGoOlPv1WfI5CB7unldQNB-As5mKnuhGilDHqalB1yoKgs\"/>\n</div>\n<!-- TopAppBar -->\n<header class=\"docked full-width top-0 z-50 bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl border-b border-error/20 flex justify-between items-center px-margin-mobile w-full h-16 shrink-0\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary font-headline-md text-headline-md-mobile\" data-icon=\"microbiology\">microbiology</span>\n<h1 class=\"font-headline-md-mobile text-headline-md-mobile text-primary tracking-tight\">VisionSetil</h1>\n</div>\n<div class=\"warning-glow flex flex-col items-end\">\n<span class=\"font-label-sm text-error uppercase tracking-widest text-[10px]\">Solo orientaci├│n ┬À nunca consumo</span>\n<span class=\"font-label-lg text-label-lg text-primary\">Wordle de setas</span>\n</div>\n</header>\n<!-- Main Content Canvas -->\n<main class=\"flex-grow relative z-10 flex flex-col items-center justify-center px-margin-mobile pt-4 pb-24 overflow-y-auto\">\n<!-- Wordle Grid -->\n<div class=\"grid grid-cols-5 gap-2 mb-stack-md w-full max-w-[320px]\" id=\"grid\">\n<!-- Generated 5x6 Grid -->\n<!-- Row 1 (Simulated Active) -->\n<div class=\"grid-cell aspect-square glass-panel rounded-lg flex items-center justify-center text-title-lg font-title-lg text-primary border-primary\">A</div>\n<div class=\"grid-cell aspect-square glass-panel rounded-lg flex items-center justify-center text-title-lg font-title-lg text-primary border-primary\">M</div>\n<div class=\"grid-cell aspect-square glass-panel rounded-lg flex items-center justify-center text-title-lg font-title-lg text-primary border-primary\">A</div>\n<div class=\"grid-cell aspect-square glass-panel rounded-lg flex items-center justify-center text-title-lg font-title-lg text-primary border-primary\">N</div>\n<div class=\"grid-cell aspect-square glass-panel rounded-lg flex items-center justify-center text-title-lg font-title-lg text-primary border-primary cursor-blink border-2\">|</div>\n<!-- Row 2-6 (Empty) -->\n<script>\n                const grid = document.getElementById('grid');\n                for (let i = 0; i < 25; i++) {\n                    const cell = document.createElement('div');\n                    cell.className = 'grid-cell aspect-square glass-panel rounded-lg flex items-center justify-center text-title-lg font-title-lg border-outline-variant/30';\n                    grid.appendChild(cell);\n                }\n            </script>\n</div>\n<!-- Educational Note -->\n<div class=\"w-full max-w-[400px] glass-panel rounded-xl p-4 mb-stack-md border-l-4 border-l-primary/40\">\n<div class=\"flex items-center gap-2 mb-1\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\" data-icon=\"lightbulb\">lightbulb</span>\n<span class=\"font-label-sm text-primary uppercase\">Nota Educativa</span>\n</div>\n<p class=\"font-body-md text-on-surface-variant text-sm leading-relaxed\">\n                Identificar especies como <span class=\"italic text-primary\">Amanita</span> o <span class=\"italic text-primary\">Boletus</span> requiere a├▒os de observaci├│n. Este juego entrena tu l├®xico micol├│gico, pero la identificaci├│n real depende de esporas, h├íbitat y morfolog├¡a microsc├│pica.\n            </p>\n</div>\n<!-- Keyboard -->\n<div class=\"w-full max-w-[500px] select-none\">\n<div class=\"flex flex-col gap-2\">\n<!-- Keyboard Rows -->\n<div class=\"flex justify-center gap-1.5 px-1\">\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">Q</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">W</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">E</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">R</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">T</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">Y</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">U</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">I</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">O</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">P</button>\n</div>\n<div class=\"flex justify-center gap-1.5 px-4\">\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">A</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">S</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">D</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">F</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">G</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">H</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">J</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">K</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">L</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">├æ</button>\n</div>\n<div class=\"flex justify-center gap-1.5 px-1\">\n<button class=\"keyboard-key flex-[1.5] h-12 glass-panel rounded-md font-bold text-xs hover:bg-surface-bright/20 active:scale-95 transition-all\">ENTRAR</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">Z</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">X</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">C</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">V</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">B</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">N</button>\n<button class=\"keyboard-key flex-1 h-12 glass-panel rounded-md font-bold text-sm hover:bg-surface-bright/20 active:scale-95 transition-all\">M</button>\n<button class=\"keyboard-key flex-[1.5] h-12 glass-panel rounded-md flex items-center justify-center hover:bg-surface-bright/20 active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined\" data-icon=\"backspace\">backspace</span>\n</button>\n</div>\n</div>\n</div>\n</main>\n<!-- BottomNavBar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 pb-safe bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl border-t border-outline-variant/10 shadow-lg rounded-t-xl\">\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"home\">home</span>\n<span class=\"font-label-sm text-label-sm\">Inicio</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"center_focus_strong\">center_focus_strong</span>\n<span class=\"font-label-sm text-label-sm\">Identificar</span>\n</a>\n<a class=\"flex flex-col items-center justify-center bg-primary-container/80 text-on-primary-container rounded-full px-4 py-1 active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"extension\">extension</span>\n<span class=\"font-label-sm text-label-sm\">Juegos</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"menu_book\">menu_book</span>\n<span class=\"font-label-sm text-label-sm\">Enciclopedia</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"more_horiz\">more_horiz</span>\n<span class=\"font-label-sm text-label-sm\">M├ís</span>\n</a>\n</nav>\n<!-- Micro-interactions Script -->\n<script>\n        document.querySelectorAll('.keyboard-key').forEach(key => {\n            key.addEventListener('click', () => {\n                // Visual feedback for mobile taps\n                key.classList.add('key-active');\n                setTimeout(() => key.classList.remove('key-active'), 150);\n            });\n        });\n\n        // Add a subtle flicker to the warning strip to mimic a glowing scientific display\n        const warning = document.querySelector('.warning-glow');\n        setInterval(() => {\n            if (Math.random() > 0.95) {\n                warning.style.opacity = '0.4';\n                setTimeout(() => warning.style.opacity = '1', 50);\n            }\n        }, 2000);\n    </script>\n</body></html>"}

   Los pines GPS son privados. No se comparten metadatos EXIF en las exportaciones autom├íticas.\n                </p>\n</div>\n</section>\n<!-- Observations List -->\n<section class=\"flex flex-col gap-4 mb-8\">\n<!-- Observation Card 1 -->\n<div class=\"glass-card rounded-xl overflow-hidden flex flex-col active:scale-[0.98] transition-transform duration-300\">\n<div class=\"relative h-48 w-full\">\n<img alt=\"Amanita muscaria\" class=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLv9F1NngRZMGjTxRQYKiPvpD7A9hSxejzmW887CYfr7Y6IAC6tnmHS3l84f8AUutQQSCx6UODZ1xoPa_jSCsIzRVlLtubWlezlz-q9rZyVRFHLD5-TSETsFZ9lGDkJiIInVZKFvho-EvyyhKECC0SYj9iFGIFbH6Rr8mcC5QUHns1ylOeCOT01qbDLfmwrbrPJ_P-kTqN8NMMGoOlPv1WfI5CB7unldQNB-As5mKnuhGilDHqalB1yoKgs\"/>\n<div class=\"absolute top-3 right-3 bg-error-container/80 backdrop-blur-md px-3 py-1 rounded-full flex items-center gap-1\">\n<span class=\"font-label-sm text-[10px] text-on-error-container font-bold\">RIESGO MUY ALTO</span>\n</div>\n</div>\n<div class=\"p-4 flex flex-col gap-2\">\n<div class=\"flex justify-between items-start\">\n<h2 class=\"font-title-md text-title-md text-on-surface italic\">Amanita muscaria</h2>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">23 Oct 2023</span>\n</div>\n<div class=\"flex items-center gap-1 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-[16px]\">location_on</span>\n<span class=\"font-body-md text-[14px]\">Navacerrada</span>\n</div>\n</div>\n</div>\n<!-- Observation Card 2 -->\n<div class=\"glass-card rounded-xl overflow-hidden flex flex-col active:scale-[0.98] transition-transform duration-300\">\n<div class=\"relative h-48 w-full\">\n<img alt=\"Hongo desconocido\" class=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLu4DSAlNRfhxOQ5YYjs6lCpsuM_kBItJq1iFKNnCjeVCwqTzksGt6BU5ZCmVX4VAadGLm5HuhGnDwk49LQHZM22DoMdlN3qzOWiDCqxiCo1Bp7tn0TPev0OGqYhMvd7gJXDIoq7iLNDKqhItpE5FGZZuRVn4By08h_JEduzDA_DfCW
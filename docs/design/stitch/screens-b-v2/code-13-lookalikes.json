{"screenId":"37a8313767cb44d2a6c940392b363d2a","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" name=\"viewport\"/>\n<title>Lookalike Studio | VisionSetil</title>\n<!-- Fonts -->\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&amp;family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&amp;family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Material Symbols -->\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"secondary-container\": \"#414b47\",\n                        \"on-secondary\": \"#28332e\",\n                        \"inverse-on-surface\": \"#2c322d\",\n                        \"outline\": \"#8c9389\",\n                        \"background\": \"#101511\",\n                        \"secondary-fixed-dim\": \"#bec9c3\",\n                        \"surface-dim\": \"#101511\",\n                        \"primary-fixed\": \"#bfefbe\",\n                        \"on-tertiary\": \"#363022\",\n                        \"primary-container\": \"#8fbc8f\",\n                        \"inverse-primary\": \"#3e6842\",\n                        \"surface\": \"#101511\",\n                        \"on-primary-fixed\": \"#002107\",\n                        \"secondary\": \"#bec9c3\",\n                        \"on-tertiary-fixed\": \"#201b0f\",\n                        \"surface-bright\": \"#353a36\",\n                        \"secondary-fixed\": \"#dae5df\",\n                        \"on-primary\": \"#0e3817\",\n                        \"error\": \"#ffb4ab\",\n                        \"surface-tint\": \"#a4d2a4\",\n                        \"on-tertiary-container\": \"#4a4334\",\n                        \"on-secondary-fixed-variant\": \"#3f4944\",\n                        \"primary-fixed-dim\": \"#a4d2a4\",\n                        \"on-surface\": \"#dfe4dd\",\n                        \"on-secondary-container\": \"#b0bbb5\",\n                        \"on-tertiary-fixed-variant\": \"#4d4637\",\n                        \"tertiary-fixed\": \"#ede1cd\",\n                        \"surface-container\": \"#1c211c\",\n                        \"surface-container-low\": \"#181d19\",\n                        \"surface-container-highest\": \"#313631\",\n                        \"tertiary-container\": \"#bbb09d\",\n                        \"tertiary-fixed-dim\": \"#d1c5b2\",\n                        \"on-primary-fixed-variant\": \"#274f2c\",\n                        \"primary\": \"#aad8a9\",\n                        \"on-primary-container\": \"#234c29\",\n                        \"surface-container-high\": \"#262b27\",\n                        \"on-error-container\": \"#ffdad6\",\n                        \"tertiary\": \"#d7cbb8\",\n                        \"surface-container-lowest\": \"#0a0f0b\",\n                        \"on-error\": \"#690005\",\n                        \"surface-variant\": \"#313631\",\n                        \"on-secondary-fixed\": \"#141e1a\",\n                        \"on-background\": \"#dfe4dd\",\n                        \"outline-variant\": \"#424940\",\n                        \"inverse-surface\": \"#dfe4dd\",\n                        \"on-surface-variant\": \"#c2c9be\",\n                        \"error-container\": \"#93000a\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"base\": \"8px\",\n                        \"safe-area\": \"16px\",\n                        \"container-padding\": \"20px\",\n                        \"section-margin\": \"32px\",\n                        \"element-gap\": \"12px\"\n                    },\n                    \"fontFamily\": {\n                        \"headline-lg-mobile\": [\"Playfair Display\"],\n                        \"display-lg\": [\"Playfair Display\"],\n                        \"headline-lg\": [\"Playfair Display\"],\n                        \"label-sm\": [\"JetBrains Mono\"],\n                        \"body-md\": [\"Hanken Grotesk\"],\n                        \"body-lg\": [\"Hanken Grotesk\"],\n                        \"title-md\": [\"Playfair Display\"]\n                    },\n                    \"fontSize\": {\n                        \"headline-lg-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}],\n                        \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                        \"headline-lg\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                        \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                        \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}],\n                        \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}],\n                        \"title-md\": [\"20px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"500\"}]\n                    }\n                },\n            },\n        }\n    </script>\n<style>\n        .glass-card {\n            background: rgba(26, 36, 32, 0.6);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 0.5px solid rgba(143, 188, 143, 0.2);\n        }\n        .safety-glow {\n            box-shadow: 0 0 40px rgba(147, 0, 10, 0.15);\n        }\n        body {\n            background-color: #0F1410;\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"text-on-background min-h-screen pb-24 font-body-md text-body-md\">\n<!-- Top Sticky Warning (From JSON Component) -->\n<header class=\"fixed top-0 w-full z-50 bg-error-container flex items-center justify-center h-10 px-4 shadow-[0_0_20px_rgba(147,0,10,0.4)]\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-on-error-container\" style=\"font-size: 14px;\">warning</span>\n<span class=\"font-label-sm text-label-sm font-bold tracking-widest text-on-error-container uppercase\">SOLO ORIENTACI├ôN, NUNCA CONSUMO</span>\n</div>\n</header>\n<!-- Main Content Canvas -->\n<main class=\"pt-16 px-container-padding max-w-5xl mx-auto space-y-section-margin\">\n<!-- Header Section -->\n<div class=\"space-y-2\">\n<h1 class=\"font-display-lg text-display-lg text-primary\">Lookalike Studio</h1>\n<p class=\"font-title-md text-title-md text-on-surface-variant opacity-80\">Compara confusiones cr├¡ticas en el campo</p>\n</div>\n<!-- Educational Note / Safety Alert -->\n<div class=\"glass-card p-4 rounded-xl border-l-4 border-error safety-glow\">\n<div class=\"flex gap-4 items-start\">\n<span class=\"material-symbols-outlined text-error\" style=\"font-variation-settings: 'FILL' 1;\">gavel</span>\n<div>\n<h4 class=\"font-label-sm text-label-sm text-error uppercase font-bold mb-1\">Dato de Supervivencia</h4>\n<p class=\"text-on-surface opacity-90\">El 90% de las intoxicaciones mortales se deben a confusiones con la <span class=\"italic underline decoration-error/50\">Amanita phalloides</span> (Oronja Verde).</p>\n</div>\n</div>\n</div>\n<!-- Comparison Interface -->\n<div class=\"grid grid-cols-1 md:grid-cols-2 gap-element-gap\">\n<!-- Specimen 1: Amanita phalloides (Mortal) -->\n<div class=\"glass-card rounded-xl overflow-hidden flex flex-col group\">\n<div class=\"relative h-64 w-full\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A macro scientific field photograph of the Amanita phalloides mushroom in a dark, damp forest. The mushroom has a pale greenish-yellow cap and a prominent white ring on the stem, partially buried in moss. Low-light atmospheric lighting highlights the organic textures and dewdrops. The style is professional nature photography with high contrast and deep blacks.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBewLoqysnqvrgHWc3APg81sFj7ye1I87MQEtElaR3xYHpaRSdWnqlg3GjoUyGRyghXFVCqoP0XH-2Khc3Bt3HDsL-P-N88PEhJDCieVHlHrgOBhLFeQt0nobboULHta0oD1SAMO0JRQ3pQTHQPmIhi92DIxuTP4BYzzSC-ZPDcasyUdxy1KmXXtX8d_W3F6ROtxtU-gBP2itUpclmOmZI__lT_hALbVBowt-1guWZ4GcUDkAREbLAHvLBkRELMK1PX4rqasc8D3yHO\"/>\n<div class=\"absolute top-4 left-4 bg-error-container text-on-error-container px-3 py-1 rounded-full font-label-sm text-label-sm font-bold tracking-widest uppercase\">Mortal</div>\n<div class=\"absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-[#101511] to-transparent\">\n<span class=\"font-label-sm text-label-sm text-primary uppercase\">Especie Confusa</span>\n<h3 class=\"font-headline-lg-mobile text-headline-lg-mobile italic\">Amanita phalloides</h3>\n</div>\n</div>\n<div class=\"p-4 grid grid-cols-3 gap-2\">\n<div class=\"flex flex-col items-center p-2 rounded-lg bg-surface-container-high transition-colors hover:bg-surface-container-highest\">\n<span class=\"material-symbols-outlined text-on-surface-variant mb-1\">view_carousel</span>\n<span class=\"text-[10px] font-label-sm uppercase opacity-60\">Laminillas</span>\n</div>\n<div class=\"flex flex-col items-center p-2 rounded-lg bg-surface-container-high transition-colors hover:bg-surface-container-highest\">\n<span class=\"material-symbols-outlined text-on-surface-variant mb-1\">side_navigation</span>\n<span class=\"text-[10px] font-label-sm uppercase opacity-60\">Perfil</span>\n</div>\n<div class=\"flex flex-col items-center p-2 rounded-lg bg-surface-container-high transition-colors hover:bg-surface-container-highest\">\n<span class=\"material-symbols-outlined text-on-surface-variant mb-1\">zoom_in</span>\n<span class=\"text-[10px] font-label-sm uppercase opacity-60\">Detalle</span>\n</div>\n</div>\n</div>\n<!-- Specimen 2: Agaricus campestris (Comestible) -->\n<div class=\"glass-card rounded-xl overflow-hidden flex flex-col group\">\n<div class=\"relative h-64 w-full\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A detailed field photograph of Agaricus campestris mushrooms growing in a wild grassy meadow during twilight. The caps are white and slightly scaly, with pinkish-brown gills visible underneath. The lighting is soft and naturalistic, emphasizing the delicate textures of the mushroom caps against the dark, earthy soil. High-resolution naturalist style with organic greens and muted tones.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCMGIm1y-n5VKI0wyNSDg8PR-z8ZfTmyXTbRkwCm2nMhlHiWuj-fLvzs_G_EguaQURKsqdxoS1vFqt17blbv8PTcTQiYSGjgd-nfhmCyj8UPCmphZVhA2GISR_Qo-CSF04dHkVGkq2REPq4uGZe1a6jsRUWL4Rkmz4t4AHBpk0MWF2rjWW0NUIqVO37taoAGbCb2NlOMNxAmcw9-gYYb-X5IwtsIJUb2isRIMICjxlHFMurRpKxWHyoprtd1F1oYipH4hgZdMJcGD9R\"/>\n<div class=\"absolute top-4 left-4 bg-primary-container text-on-primary-container px-3 py-1 rounded-full font-label-sm text-label-sm font-bold tracking-widest uppercase\">Comestible</div>\n<div class=\"absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-[#101511] to-transparent\">\n<span class=\"font-label-sm text-label-sm text-primary uppercase\">Especie Buscada</span>\n<h3 class=\"font-headline-lg-mobile text-headline-lg-mobile italic\">Agaricus campestris</h3>\n</div>\n</div>\n<div class=\"p-4 grid grid-cols-3 gap-2\">\n<div class=\"flex flex-col items-center p-2 rounded-lg bg-surface-container-high transition-colors hover:bg-surface-container-highest\">\n<span class=\"material-symbols-outlined text-on-surface-variant mb-1\">view_carousel</span>\n<span class=\"text-[10px] font-label-sm uppercase opacity-60\">Laminillas</span>\n</div>\n<div class=\"flex flex-col items-center p-2 rounded-lg bg-surface-container-high transition-colors hover:bg-surface-container-highest\">\n<span class=\"material-symbols-outlined text-on-surface-variant mb-1\">side_navigation</span>\n<span class=\"text-[10px] font-label-sm uppercase opacity-60\">Perfil</span>\n</div>\n<div class=\"flex flex-col items-center p-2 rounded-lg bg-surface-container-high transition-colors hover:bg-surface-container-highest\">\n<span class=\"material-symbols-outlined text-on-surface-variant mb-1\">zoom_in</span>\n<span class=\"text-[10px] font-label-sm uppercase opacity-60\">Detalle</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Technical Breakdown Table -->\n<section class=\"space-y-4\">\n<div class=\"flex items-center gap-3 border-b border-primary/20 pb-2\">\n<span class=\"material-symbols-outlined text-primary\">analytics</span>\n<h2 class=\"font-title-md text-title-md uppercase tracking-wide\">Diferencias Cr├¡ticas</h2>\n</div>\n<div class=\"glass-card rounded-xl overflow-hidden\">\n<table class=\"w-full text-left border-collapse\">\n<thead>\n<tr class=\"bg-surface-container-highest/40 text-on-surface-variant font-label-sm text-label-sm\">\n<th class=\"p-4 uppercase tracking-tighter\">Atributo</th>\n<th class=\"p-4 text-error\">A. Phalloides</th>\n<th class=\"p-4 text-primary\">A. Campestris</th>\n</tr>\n</thead>\n<tbody class=\"divide-y divide-white/5\">\n<tr class=\"hover:bg-white/5 transition-colors\">\n<td class=\"p-4 font-bold text-on-surface\">Base (Volva)</td>\n<td class=\"p-4 text-on-surface-variant\">\n<div class=\"flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-error\"></span>\n                                    Presente (Saco blanco)\n                                </div>\n</td>\n<td class=\"p-4 text-on-surface-variant\">\n<div class=\"flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-primary\"></span>\n                                    Ausente (Base recta)\n                                </div>\n</td>\n</tr>\n<tr class=\"hover:bg-white/5 transition-colors\">\n<td class=\"p-4 font-bold text-on-surface\">Laminillas</td>\n<td class=\"p-4 text-on-surface-variant\">Siempre Blancas</td>\n<td class=\"p-4 text-on-surface-variant\">Rosadas a Marr├│n</td>\n</tr>\n<tr class=\"hover:bg-white/5 transition-colors\">\n<td class=\"p-4 font-bold text-on-surface\">Anillo</td>\n<td class=\"p-4 text-on-surface-variant\">Persistente, amplio</td>\n<td class=\"p-4 text-on-surface-variant\">Simple, fugaz</td>\n</tr>\n<tr class=\"hover:bg-white/5 transition-colors\">\n<td class=\"p-4 font-bold text-on-surface\">Olor</td>\n<td class=\"p-4 text-on-surface-variant\">Miel (envejecida)</td>\n<td class=\"p-4 text-on-surface-variant\">Agradable, f├║ngico</td>\n</tr>\n</tbody>\n</table>\n</div>\n</section>\n<!-- Detailed Detail View -->\n<div class=\"glass-card rounded-2xl overflow-hidden p-6 relative\">\n<div class=\"flex flex-col md:flex-row gap-8 items-center\">\n<div class=\"w-full md:w-1/3 aspect-square rounded-xl overflow-hidden shadow-2xl\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A extreme macro extreme close-up of mushroom gills, showing intricate branching patterns and fungal spores. The lighting is moody and dark, using a cool blue and green palette to highlight the biological complexity. High-end scientific photography style with sharp focus and deep depth of field against an OLED black background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAfgWHZ-E_aqV0AtC4noItgufNs_pOXC44IgagQZ7AyEKoCldjfpaolCtzCLXFzuJVjMciOmqZpQfQRZRqB9K14RNQxjC2CSarl7Lx1atZBJCPptDUWVPoSwGX9g5nmtlYAEAnDyryvfxK6Y2gTkLNi9uy0Mp2GjzSDsycy__Q9N50H0aZf00OLBBpaoGYOUbYl3R36wju2GJTLoB8YSizSXxqHVIO1IlL2u--u4h2ssvbmkVNx1HttW8JdQYe3YX_GKSSzNh61TiSK\"/>\n</div>\n<div class=\"flex-1 space-y-4\">\n<div class=\"flex items-center gap-2\">\n<span class=\"bg-surface-container-high px-2 py-1 rounded text-label-sm font-label-sm text-primary uppercase\">Vistas Cr├¡ticas</span>\n<span class=\"text-on-surface-variant opacity-60 text-sm italic\">ÔÇö Magnificaci├│n 10x</span>\n</div>\n<h3 class=\"font-title-md text-title-md text-on-surface\">Estructura de las Laminillas</h3>\n<p class=\"text-on-surface-variant leading-relaxed\">\n                        Observe cuidadosamente la inserci├│n de las l├íminas en el pie. En las Amanitas, estas son libres y nunca tocan el tallo, manteniendo un color blanco inmaculado incluso al madurar. En los Agaricus, cambian dr├ísticamente de color.\n                    </p>\n<div class=\"flex gap-2\">\n<span class=\"font-label-sm text-[10px] px-2 py-1 rounded-full border border-outline/30 text-outline\">L├íminas Libres</span>\n<span class=\"font-label-sm text-[10px] px-2 py-1 rounded-full border border-outline/30 text-outline\">Himenio</span>\n<span class=\"font-label-sm text-[10px] px-2 py-1 rounded-full border border-outline/30 text-outline\">Esporas</span>\n</div>\n</div>\n</div>\n</div>\n</main>\n<!-- Navigation (BottomNavBar from JSON) -->\n<nav class=\"fixed bottom-0 w-full z-50 rounded-t-xl backdrop-blur-xl bg-surface-container/60 border-t border-primary/20 flex justify-around items-center px-4 py-2 pb-safe shadow-none\">\n<!-- Inicio -->\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant active:scale-95 transition-all duration-300 hover:bg-white/5\" href=\"#\">\n<span class=\"material-symbols-outlined\">home</span>\n<span class=\"font-body-md text-[10px]\">Inicio</span>\n</a>\n<!-- Identificar -->\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant active:scale-95 transition-all duration-300 hover:bg-white/5\" href=\"#\">\n<span class=\"material-symbols-outlined\">center_focus_strong</span>\n<span class=\"font-body-md text-[10px]\">Identificar</span>\n</a>\n<!-- Juegos -->\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant active:scale-95 transition-all duration-300 hover:bg-white/5\" href=\"#\">\n<span class=\"material-symbols-outlined\">sports_esports</span>\n<span class=\"font-body-md text-[10px]\">Juegos</span>\n</a>\n<!-- Enciclopedia -->\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant active:scale-95 transition-all duration-300 hover:bg-white/5\" href=\"#\">\n<span class=\"material-symbols-outlined\">menu_book</span>\n<span class=\"font-body-md text-[10px]\">Enciclopedia</span>\n</a>\n<!-- M├ís (Active) -->\n<a class=\"flex flex-col items-center justify-center text-primary bg-primary-container/20 rounded-xl px-3 py-1 active:scale-95 transition-all duration-300\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">more_horiz</span>\n<span class=\"font-body-md text-[10px] font-bold\">M├ís</span>\n</a>\n</nav>\n<!-- Micro-interaction Script -->\n<script>\n        document.querySelectorAll('.glass-card').forEach(card => {\n            card.addEventListener('touchstart', () => {\n                card.style.transform = 'scale(0.98)';\n                card.style.transition = 'transform 0.2s cubic-bezier(0.4, 0, 0.2, 1)';\n            });\n            card.addEventListener('touchend', () => {\n                card.style.transform = 'scale(1)';\n            });\n        });\n    </script>\n</body></html>"}

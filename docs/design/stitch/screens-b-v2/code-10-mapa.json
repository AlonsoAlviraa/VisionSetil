{"screenId":"b9cab8a8e4b84a9d9e8fa0825bf32645","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" name=\"viewport\"/>\n<title>VisionSetil - Mapa de Cotos de Soria</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Tailwind Theme Config -->\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                \"on-primary-fixed-variant\": \"#274f2c\",\n                \"background\": \"#101511\",\n                \"on-error\": \"#690005\",\n                \"tertiary\": \"#d7cbb8\",\n                \"secondary-fixed\": \"#dae5df\",\n                \"secondary-container\": \"#414b47\",\n                \"on-secondary-fixed-variant\": \"#3f4944\",\n                \"primary\": \"#aad8a9\",\n                \"on-secondary-fixed\": \"#141e1a\",\n                \"primary-fixed-dim\": \"#a4d2a4\",\n                \"inverse-surface\": \"#dfe4dd\",\n                \"inverse-on-surface\": \"#2c322d\",\n                \"surface-container-lowest\": \"#0a0f0b\",\n                \"error-container\": \"#93000a\",\n                \"surface\": \"#101511\",\n                \"on-secondary-container\": \"#b0bbb5\",\n                \"outline\": \"#8c9389\",\n                \"on-primary\": \"#0e3817\",\n                \"on-surface\": \"#dfe4dd\",\n                \"on-primary-container\": \"#234c29\",\n                \"surface-container\": \"#1c211c\",\n                \"inverse-primary\": \"#3e6842\",\n                \"outline-variant\": \"#424940\",\n                \"on-background\": \"#dfe4dd\",\n                \"error\": \"#ffb4ab\",\n                \"tertiary-fixed\": \"#ede1cd\",\n                \"primary-fixed\": \"#bfefbe\",\n                \"on-tertiary\": \"#363022\",\n                \"on-secondary\": \"#28332e\",\n                \"on-tertiary-container\": \"#4a4334\",\n                \"surface-variant\": \"#313631\",\n                \"surface-container-highest\": \"#313631\",\n                \"tertiary-fixed-dim\": \"#d1c5b2\",\n                \"surface-bright\": \"#353a36\",\n                \"on-tertiary-fixed-variant\": \"#4d4637\",\n                \"on-surface-variant\": \"#c2c9be\",\n                \"surface-tint\": \"#a4d2a4\",\n                \"primary-container\": \"#8fbc8f\",\n                \"on-tertiary-fixed\": \"#201b0f\",\n                \"secondary-fixed-dim\": \"#bec9c3\",\n                \"surface-container-high\": \"#262b27\",\n                \"secondary\": \"#bec9c3\",\n                \"tertiary-container\": \"#bbb09d\",\n                \"on-error-container\": \"#ffdad6\",\n                \"surface-dim\": \"#101511\",\n                \"surface-container-low\": \"#181d19\",\n                \"on-primary-fixed\": \"#002107\"\n            },\n            \"borderRadius\": {\n                \"DEFAULT\": \"0.25rem\",\n                \"lg\": \"0.5rem\",\n                \"xl\": \"0.75rem\",\n                \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                \"section-padding\": \"32px\",\n                \"gutter-mobile\": \"12px\",\n                \"stack-gap\": \"16px\",\n                \"margin-mobile\": \"20px\"\n            },\n            \"fontFamily\": {\n                \"body-lg\": [\"\\\"Source Serif 4\\\"\"],\n                \"label-sm\": [\"\\\"Source Serif 4\\\"\"],\n                \"headline-lg\": [\"Playfair Display\"],\n                \"headline-md\": [\"Playfair Display\"],\n                \"body-md\": [\"\\\"Source Serif 4\\\"\"]\n            },\n            \"fontSize\": {\n                \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}],\n                \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"600\"}],\n                \"headline-lg\": [\"32px\", {\"lineHeight\": \"40px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                \"headline-md\": [\"24px\", {\"lineHeight\": \"32px\", \"fontWeight\": \"600\"}],\n                \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}]\n            }\n          },\n        },\n      }\n    </script>\n<style>\n        .glass-card {\n            background: rgba(26, 36, 32, 0.7);\n            backdrop-filter: blur(16px);\n            -webkit-backdrop-filter: blur(16px);\n            border-top: 1px solid rgba(232, 220, 200, 0.1);\n            border-left: 1px solid rgba(232, 220, 200, 0.1);\n        }\n        \n        .active-dot::after {\n            content: '';\n            position: absolute;\n            bottom: -4px;\n            width: 4px;\n            height: 4px;\n            background-color: #aad8a9;\n            border-radius: 50%;\n        }\n\n        /* Material Symbols Fill State */\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        \n        .filled-icon {\n            font-variation-settings: 'FILL' 1;\n        }\n\n        body {\n            background-color: #101511;\n            color: #dfe4dd;\n            overflow-x: hidden;\n        }\n\n        .map-overlay {\n            background-image: radial-gradient(circle at center, transparent 0%, #101511 85%);\n        }\n\n        .cta-active:active {\n            transform: scale(0.98);\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"font-body-md text-body-md min-h-screen flex flex-col\">\n<!-- Safety Banner (TopAppBar small) -->\n<header class=\"fixed top-0 w-full z-[60] h-8 bg-error-container flex items-center justify-center w-full text-center\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-widest text-on-error-container\">SOLO ORIENTACI├ôN ┬À NUNCA CONSUMO</span>\n</header>\n<!-- Main App Bar (TopAppBar medium) -->\n<nav class=\"fixed top-8 w-full z-50 bg-background/80 backdrop-blur-xl border-b border-tertiary/10 flex items-center justify-between px-gutter-mobile h-16 w-full\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary hover:opacity-80 transition-opacity active:scale-95 transition-transform cursor-pointer\">search</span>\n<span class=\"font-headline-md text-headline-md text-tertiary-fixed tracking-tight\">VisionSetil</span>\n</div>\n<span class=\"material-symbols-outlined text-primary hover:opacity-80 transition-opacity active:scale-95 transition-transform cursor-pointer\">account_circle</span>\n</nav>\n<!-- Map Canvas -->\n<main class=\"relative flex-grow mt-24 pb-32\">\n<!-- Interactive Map Background -->\n<div class=\"fixed inset-0 z-0\">\n<div class=\"w-full h-full grayscale opacity-40 brightness-50\" data-location=\"Soria, Spain\" style=\"\">\n<!-- Map integration placeholder logic -->\n<div class=\"w-full h-full bg-[#101511]\" data-alt=\"A detailed topographic map of the Soria region in Spain, specifically showing the forested areas of Pinar de Grande. The map uses an OLED-optimized dark theme with deep blacks, muted moss greens for forests, and subtle ochre lines for terrain elevation. Small glowing dots indicate mycological hotspots, all rendered in a sophisticated, minimalist academic cartography style with high contrast and clarity.\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAH22NH-_WXs6lgLx3tfkaStZw5Rr4csHuzCz6A8xjzlCr3Z_Jhj-kQdn2-EuuSnOZmVbTkQy-UYJhvX0WKTFa826zYio4o_OcrGD0tvtB2LntQ1JNzqsHNO40b7A6k1SZo2KMmPlrav6-Ax_JvUpxymg7bfwZkaEU5wBx7svK_1leyZ6q6wrT0ci98VRDwPMwN-lMrU7D8FYzLmBT3AW4HjfjrOSo5gu6hxYq4A2ZFm_-HEH4D3tAfOHoSF5oZor6wsdsu6TdoTYKj')\"></div>\n</div>\n<div class=\"absolute inset-0 map-overlay pointer-events-none\"></div>\n</div>\n<!-- Content Overlay -->\n<div class=\"relative z-10 px-gutter-mobile flex flex-col gap-6\">\n<!-- Map Legend / Filter Chips -->\n<div class=\"flex flex-wrap gap-2 py-2 overflow-x-auto no-scrollbar\">\n<button class=\"glass-card flex items-center gap-2 px-4 py-1.5 rounded-full border border-tertiary/10 active:scale-95 transition-transform\">\n<span class=\"w-2 h-2 rounded-full bg-primary\"></span>\n<span class=\"font-label-sm text-label-sm\">Zona Abierta</span>\n</button>\n<button class=\"glass-card flex items-center gap-2 px-4 py-1.5 rounded-full border border-tertiary/10 active:scale-95 transition-transform\">\n<span class=\"w-2 h-2 rounded-full bg-tertiary-container\"></span>\n<span class=\"font-label-sm text-label-sm\">Permiso Requerido</span>\n</button>\n<button class=\"glass-card flex items-center gap-2 px-4 py-1.5 rounded-full border border-tertiary/10 active:scale-95 transition-transform\">\n<span class=\"w-2 h-2 rounded-full bg-error\"></span>\n<span class=\"font-label-sm text-label-sm\">Reserva Protegida</span>\n</button>\n</div>\n<!-- Focus Specimen Details (Glass Card) -->\n<section class=\"glass-card rounded-xl p-5 mt-auto shadow-2xl\">\n<div class=\"flex gap-4 mb-4\">\n<div class=\"w-24 h-24 rounded-lg overflow-hidden shrink-0 border border-tertiary/20\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A macro photograph of an Amanita Caesarea mushroom, also known as the Caesar's mushroom, emerging from a bed of forest moss and damp leaves. The mushroom has a vibrant orange-red cap and a thick pale yellow stem with a delicate ring. The lighting is soft and atmospheric, highlighting the textures of the forest floor in a mysterious academic style. Deep shadows and vibrant earth tones dominate the composition.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCmaV0FWKnoCmMt-8NFYuanbs0EgFc_V8FBhmxsga6-qPPtCfXp90I1JxH0jXKPymFPZJxA1ZnykvYsHenbkKBIMN0dVFNnAXtwxZlawLPXooNrmYDAfDNg0XgfUWHXjFgCFfKqqWWWmNJSLmFM5QNzNzxos5ratX9LuQSVA0HZRehCTSR52eFd0t-slxip3C83NXIb8S4Vbc7fQF6p2rtKrLa5cGqsEDZLf-4NovwzZPXUoEhtWy2A-ZB2cKefcmFUFzMehthIYFqF\"/>\n</div>\n<div class=\"flex flex-col justify-center\">\n<h2 class=\"font-headline-md text-headline-md text-primary mb-0.5\">Pinar de Grande</h2>\n<p class=\"font-label-sm text-label-sm text-on-surface-variant/70\">(SO-50001) ┬À Soria, Castilla y Le├│n</p>\n<div class=\"flex items-center gap-2 mt-2\">\n<span class=\"bg-primary/10 text-primary px-2 py-0.5 rounded text-[10px] uppercase font-bold tracking-wider border border-primary/20\">Coto Activo</span>\n</div>\n</div>\n</div>\n<div class=\"grid grid-cols-2 gap-4 mb-6\">\n<div class=\"border-l border-tertiary/20 pl-3\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant uppercase mb-1\">Especie Dominante</p>\n<p class=\"font-body-lg text-body-lg italic\">Boletus edulis</p>\n</div>\n<div class=\"border-l border-tertiary/20 pl-3\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant uppercase mb-1\">Suelo / Humedad</p>\n<p class=\"font-body-lg text-body-lg\">H├║medo (65%)</p>\n</div>\n</div>\n<div class=\"flex flex-col gap-3\">\n<button class=\"w-full bg-primary-container text-on-primary-fixed py-3.5 rounded-lg font-bold font-label-sm text-label-sm uppercase tracking-widest cta-active transition-all\">\n                        Comprar Permiso Online\n                    </button>\n<button class=\"w-full border border-primary/30 text-primary py-3 rounded-lg font-label-sm text-label-sm uppercase tracking-widest cta-active transition-all backdrop-blur-sm\">\n                        Ver Normativa Local\n                    </button>\n</div>\n</section>\n<!-- Legal Disclaimer Area -->\n<div class=\"glass-card rounded-lg p-4 mb-4 border-none bg-surface-container/40\">\n<div class=\"flex gap-3\">\n<span class=\"material-symbols-outlined text-error shrink-0\">info</span>\n<p class=\"text-[11px] leading-relaxed text-on-surface-variant/80 font-body-md italic\">\n                        Aviso: El mapa tiene car├ícter informativo. No identifica especies ni autoriza la recolecci├│n sin permiso legal. Respete la propiedad privada y las cuotas de recolecci├│n diarias.\n                    </p>\n</div>\n</div>\n</div>\n</main>\n<!-- FAB: Identificar multi-vista -->\n<button class=\"fixed bottom-24 right-4 z-50 w-14 h-14 bg-primary text-on-primary rounded-2xl flex items-center justify-center shadow-lg active:scale-90 transition-transform\">\n<span class=\"material-symbols-outlined filled-icon\" style=\"font-variation-settings: 'FILL' 1;\">camera</span>\n<div class=\"absolute -top-12 right-0 glass-card px-3 py-1.5 rounded-lg border border-primary/30 whitespace-nowrap pointer-events-none opacity-0 group-hover:opacity-100\">\n<span class=\"font-label-sm text-label-sm text-primary\">Identificar multi-vista</span>\n</div>\n</button>\n<!-- Navigation (BottomNavBar) -->\n<nav class=\"fixed bottom-0 w-full z-50 rounded-t-xl bg-surface-container/70 backdrop-blur-lg border-t border-tertiary/10 flex justify-around items-center pt-3 pb-safe px-4 w-full h-16\">\n<div class=\"flex flex-col items-center gap-1 text-on-surface-variant/60 hover:text-primary/80 active:scale-90 transition-transform duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined\">home</span>\n<span class=\"font-label-sm text-label-sm\">Inicio</span>\n</div>\n<div class=\"flex flex-col items-center gap-1 text-on-surface-variant/60 hover:text-primary/80 active:scale-90 transition-transform duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined\">visibility</span>\n<span class=\"font-label-sm text-label-sm\">Identificar</span>\n</div>\n<div class=\"flex flex-col items-center gap-1 text-primary relative after:content-[''] after:absolute after:-bottom-1 after:w-1 after:h-1 after:bg-primary after:rounded-full active:scale-90 transition-transform duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined filled-icon\" style=\"font-variation-settings: 'FILL' 1;\">map</span>\n<span class=\"font-label-sm text-label-sm\">Mapa</span>\n</div>\n<div class=\"flex flex-col items-center gap-1 text-on-surface-variant/60 hover:text-primary/80 active:scale-90 transition-transform duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined\">menu_book</span>\n<span class=\"font-label-sm text-label-sm\">Enciclopedia</span>\n</div>\n<div class=\"flex flex-col items-center gap-1 text-on-surface-variant/60 hover:text-primary/80 active:scale-90 transition-transform duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined\">more_horiz</span>\n<span class=\"font-label-sm text-label-sm\">M├ís</span>\n</div>\n</nav>\n<script>\n        // Simple haptic feedback simulation and interaction\n        document.querySelectorAll('button, nav div').forEach(el => {\n            el.addEventListener('touchstart', () => {\n                if (window.navigator.vibrate) {\n                    window.navigator.vibrate(5);\n                }\n            });\n        });\n\n        // Dynamic Map Zoom Interaction simulation\n        let lastScrollTop = 0;\n        window.addEventListener('scroll', () => {\n            const st = window.pageYOffset || document.documentElement.scrollTop;\n            const mapImg = document.querySelector('[data-location] div');\n            if (st > lastScrollTop) {\n                // Scrolling down - zoom in slightly\n                mapImg.style.transform = `scale(${1 + st/5000})`;\n            } else {\n                // Scrolling up\n                mapImg.style.transform = `scale(${1 + st/5000})`;\n            }\n            lastScrollTop = st <= 0 ? 0 : st;\n        }, false);\n    </script>\n</body></html>"}

\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"sm\": \"12px\",\n                    \"lg\": \"40px\",\n                    \"xs\": \"4px\",\n                    \"margin-desktop\": \"120px\",\n                    \"md\": \"24px\",\n                    \"gutter\": \"16px\",\n                    \"margin-mobile\": \"20px\",\n                    \"base\": \"8px\",\n                    \"xl\": \"64px\"\n            },\n            \"fontFamily\": {\n                    \"headline-md\": [\"Playfair Display\"],\n                    \"display-lg\": [\"Playfair Display\"],\n                    \"body-md\": [\"\\\"Source Serif 4\\\"\"],\n                    \"headline-lg\": [\"Playfair Display\"],\n                    \"body-lg\": [\"\\\"Source Serif 4\\\"\"],\n                    \"label-lg\": [\"\\\"Source Serif 4\\\"\"],\n                    \"label-sm\": [\"\\\"Source Serif 4\\\"\"],\n                    \"headline-lg-mobile\": [\"Playfair Display\"]\n            },\n            \"fontSize\": {\n                    \"headline-md\": [\"24px\", {\"lineHeight\": \"32px\", \"fontWeight\": \"600\"}],\n                    \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}],\n                    \"headline-lg\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                    \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}],\n                    \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"600\"}],\n                    \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"headline-lg-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}]\n            }\n          },\n        },\n      }\n    </script>\n<style>\n        body {\n            background-color: #0F1410; /* Strict Brand OLED Background */\n            color: #dfe4dd;\n            overflow-x: hidden;\n        }\n        .glass-card {\n            background: rgba(26, 36, 32, 0.6);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(143, 188, 143, 0.1);\n        }\n        .warning-strip {\n            background: linear-gradient(90deg, #93000a 0%, #690005 100%);\n        }\n        .hide-scrollbar::-webkit-scrollbar {\n            display: none;\n        }\n        .hide-scrollbar {\n            -ms-overflow-style: none;\n            scrollbar-width: none;\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"font-body-md text-body-md selection:bg-primary/30\">\n<!-- Top App Bar & Warning Strip -->\n<header class=\"fixed top-0 left-0 w-full z-50\">\n<div class=\"warning-strip w-full py-1.5 px-4 text-center\">\n<span class=\"font-label-sm text-[10px] uppercase tracking-[0.2em] text-on-error-container\">Solo orientaci├│n ┬À nunca consumo</span>\n</div>\n<div class=\"flex justify-between items-center px-margin-mobile w-full h-16 bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl border-b border-error/20\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary text-2xl\">microbiology</span>\n<span class=\"font-headline-md text-headline-md text-primary tracking-tight\">VisionSetil</span>\n</div>\n<button class=\"w-10 h-10 flex items-center justify-center rounded-full bg-surface-bright/20 hover:bg-surface-bright/40 transition-colors\">\n<span class=\"material-symbols-outlined text-primary\">search</span>\n</button>\n</div>\n</header>\n<main class=\"pt-24 pb-32 max-w-screen-xl mx-auto px-4 md:px-margin-desktop\">\n<!-- Hero Gallery -->\n<section class=\"relative w-full aspect-[4/3] md:aspect-[21/9] rounded-3xl overflow-hidden mb-8 shadow-2xl\">\n<div class=\"flex h-full w-full overflow-x-auto snap-x snap-mandatory hide-scrollbar\" id=\"gallery\">\n<div class=\"snap-center shrink-0 w-full h-full relative\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Close-up high-resolution photograph of a classic Amanita muscaria mushroom in a dark, atmospheric forest setting. The bright red cap with white warts glows under a soft, moonlit beam. The surrounding forest floor is covered in deep green moss and damp autumn leaves, creating a moody, scholarly field guide aesthetic.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDdDBKj2KKqnwT84QTFEwULYizGxlFFQQdGCqyDZhn6anMRWvS1Guar_uVyZ8sM84Ohwagyg90uDSmUdRP1e_6Yx64sq_jcd6fq2nAV90RsuJcQsY6NBLHsMIzbS0TuHnQNP-Es4lyqEzmnfIkGINZq24ePAEyWewy97TUmrMt774xUdkbCEqL5vGO9V_j_xq3FWms0svuCwg47wj5NkwvAaj7pT7iHkNX0Udf4UBe14LERBxOnh7tQuAaRC9K2NckQUA2bxPJmbYaI\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#0F1410] via-transparent to-transparent\"></div>\n</div>\n<div class=\"snap-center shrink-0 w-full h-full relative\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Microscopic-style detail shot of the white gills beneath the cap of an Amanita muscaria. The lighting is dramatic and low-key, highlighting the intricate radial structure and the delicate veil remnants on the stem. The color palette consists of creamy whites and deep forest shadows, emphasizing scientific precision and texture.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAKXXFnXCc-MM79erh4BRQfkGeHXWTGCOt-uo5dlKoZ-mWv_CbfB8jPCfCoTLpc6CPM-5Yrdh1fwqoWXNWRLq6Jg7lVkRK1ViOc6dL2FVMo5ekpJawLQoML-Fct0tXTFT16QzcFYNOtQSAiRDTCdISEIXac-oEbMv_8K_wIqjDq_O1-dpbBeNxFKDSMKNEIz9TYU7I6Llsdv9qgNwFbU8pBG4buuhizytUr6lQorTEFOKSFlL8oaBceLs694Fv7KRGZFgms3Yl58nXD\"/>\n</div>\n</div>\n<div class=\"absolute bottom-6 right-6 flex gap-2\">\n<div class=\"px-3 py-1 bg-surface-container/80 backdrop-blur-md rounded-full border border-outline-variant/30 text-xs font-label-sm text-primary\">1 / 5</div>\n</div>\n</section>\n<!-- Species Header -->\n<section class=\"mb-10 px-2\">\n<div class=\"flex flex-wrap items-end justify-between gap-4 mb-4\">\n<div>\n<h2 class=\"italic font-headline-md text-headline-md text-primary/80 mb-1\">Amanita muscaria</h2>\n<h1 class=\"font-display-lg text-headline-lg-mobile md:text-display-lg text-on-surface leading-none\">Matamoscas</h1>\n</div>\n<div class=\"flex flex-col items-end gap-2\">\n<span class=\"bg-error-container text-on-error-container px-4 py-2 rounded-xl font-label-lg flex items-center gap-2 border border-error/20\">\n<span class=\"material-symbols-outlined text-[20px]\" style=\"font-variation-settings: 'FILL' 1;\">dangerous</span>\n                        RIESGO MORTAL\n                    </span>\n</div>\n</div>\n<div class=\"glass-card rounded-2xl p-4 flex flex-wrap items-center gap-6 border-l-4 border-l-primary\">\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] uppercase tracking-widest text-on-surface-variant font-label-sm mb-0.5\">Index Fungorum</span>\n<span class=\"font-body-md text-primary-fixed\">#144673 ┬À (L.) Lam.</span>\n</div>\n<div class=\"w-px h-8 bg-outline-variant/30 hidden sm:block\"></div>\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] uppercase tracking-widest text-on-surface-variant font-label-sm mb-0.5\">Familia</span>\n<span class=\"font-body-md\">Amanitaceae</span>\n</div>\n</div>\n</section>\n<!-- Diagnostic Coach -->\n<section class=\"mb-12\">\n<h3 class=\"font-headline-md text-headline-md text-on-surface mb-6 px-2\">Coach de Diagn├│stico</h3>\n<div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n<!-- Laminillas -->\n<div class=\"glass-card rounded-3xl p-3 flex flex-col gap-3 group cursor-pointer active:scale-95 transition-transform\">\n<div class=\"aspect-square rounded-2xl overflow-hidden bg-surface-container-high\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Macro detail of Amanita muscaria gills, showing the free, crowded, and white lamellae structure. The lighting highlights the razor-sharp edges and the space between the gills and the stem. Atmospheric dark green and brown forest tones in the background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuArxjCIeB4UyxFhf-uaUEaSz2p1KmdorGe7IIvPaTJtyc47zoLAcLz4bNCMzSrKjvmLVnj0iAy1ElzlSuRohEmBBBIOoff4pJL0wr4DtSJLctzw8iBBLIqi8OJ-5GyNuPYeIYJkwjHIroRdHK3qQZJllyPj5N6A-3BOpdDvJlrmQ_0_IMKXlu1M4RSqbvCczuNtZv3nmG_bMzuOGayqHS9E0MW-lBYRJDjJcchuKTRQoRFuKMUboRG8O-EuwagoVDa9ALAOUfjuUnOs\"/>\n</div>\n<div class=\"px-2 pb-1\">\n<p class=\"font-label-lg text-primary mb-0.5\">Laminillas</p>\n<p class=\"text-[11px] text-on-surface-variant leading-tight\">Libres, blancas, muy apretadas.</p>\n</div>\n</div>\n<!-- Perfil -->\n<div class=\"glass-card rounded-3xl p-3 flex flex-col gap-3 group cursor-pointer active:scale-95 transition-transform\">\n<div class=\"aspect-square rounded-2xl overflow-hidden bg-surface-container-high\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Side profile view of a mature Amanita muscaria against a dark forest background. Showing the bulbous base, the ring (annulus) hanging like a skirt, and the flattened red cap. Professional mycological photography style with sharp focus on botanical features.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAFBimUFGYDNAeJOMUxjPh-lDeeGW9HX2Wrvkp9wMdvtlcNpuI9GuOFPNCQDH_CkAqCMz2ga7jNm9Yc5Ulrhzwj8w4aTYJSFntw3KpeLjikLE4_teERNtod6ZWb1kgoYBFEWBsRqOw8QDaZcDO45xh5buGScT0RO1AexIf0aM_cwbbw2c5s01lTr8hFPsKBv3HVRmU26Ffo9YLZfiek9CpoEXS3woc4d-VC1BahjFWQBsG-G0063lGzeK1-VYdSw362EGN5rzp4jxzW\"/>\n</div>\n<div class=\"px-2 pb-1\">\n<p class=\"font-label-lg text-primary mb-0.5\">Perfil</p>\n<p class=\"text-[11px] text-on-surface-variant leading-tight\">Pie cil├¡ndrico, anillo amplio y base bulbosa.</p>\n</div>\n</div>\n<!-- H├íbitat -->\n<div class=\"glass-card rounded-3xl p-3 flex flex-col gap-3 group cursor-pointer active:scale-95 transition-transform\">\n<div class=\"aspect-square rounded-2xl overflow-hidden bg-surface-container-high\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A wide forest landscape shot showing several red mushrooms emerging from a bed of pine needles and damp earth beneath birch and pine trees. The lighting is diffused and atmospheric, evoking a cool, damp autumn morning in a temperate woodland.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDLZ1W2kP7yGLZI5AxrjXpwj4UJ6eW1NFxZpAjXvTJkWYjPqQmutvEl-MqvkeV8ORz2d41rn014pHzO4thiPLi-vKrr0syFF4PgYWHpqjefVnzNPntiHD0YKGkwfPwBFX69oCUYPY8RKBCXL6BKyabP3vvWtMOODezAzhQF_lCYXgdf1SgU-J9QRjB13JobJ2X5Ua7cb8J4nqz-ji8uEKoy8LgW2ZqUrP7u1fudhFFpSn2Ky6M0lIzKYkBmhkiN71fPPxrHQ5Mo2M87\"/>\n</div>\n<div class=\"px-2 pb-1\">\n<p class=\"font-label-lg text-primary mb-0.5\">H├íbitat</p>\n<p class=\"text-[11px] text-on-surface-variant leading-tight\">Bosques de con├¡feras y frondosas (abedules).</p>\n</div>\n</div>\n<!-- Detalle -->\n<div class=\"glass-card rounded-3xl p-3 flex flex-col gap-3 group cursor-pointer active:scale-95 transition-transform\">\n<div class=\"aspect-square rounded-2xl overflow-hidden bg-surface-container-high\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Extreme close-up of the white pyramidal warts on the bright red surface of a mushroom cap. The focus is sharp on the texture of the remnants of the universal veil, contrasting against the smooth, wet skin of the cap. Moody, dark lighting with high-end contrast.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDj4JlVX31XrM77Uh4wyGh9AClHJ9m5QGNUOa-mrMZugLbfBwVnzvm9kltQC8d-B-jdqrUW80fZ_u7Kyavw0UNrb5o86dB-nOgtAG6NVdSVy0spoN-4ZnSRsdoZiuyVtFWfPnYuN8w16DCf6cTnJcu_BxdodmmQyg0_jaS3Sde60uS8K_Rtc16mOOrnZFkMIMqq6LlR2wbp-1o_NY5CTaSlJAuQ7IOFmd2qjuNAhBu1cQPQs3uP2_w3Zm0vevtVY7M_puC6eeQfKyVR\"/>\n</div>\n<div class=\"px-2 pb-1\">\n<p class=\"font-label-lg text-primary mb-0.5\">Detalle Velo</p>\n<p class=\"text-[11px] text-on-surface-variant leading-tight\">Restos de velo blanco en forma de verrugas.</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Tabs Content -->\n<section class=\"mb-12\">\n<div class=\"flex border-b border-outline-variant/30 mb-8 overflow-x-auto hide-scrollbar\">\n<button class=\"px-6 py-4 font-label-lg text-primary border-b-2 border-primary whitespace-nowrap\">Descripci├│n</button>\n<button class=\"px-6 py-4 font-label-lg text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap\">H├íbitat Detallado</button>\n<button class=\"px-6 py-4 font-label-lg text-on-surface-variant hover:text-primary transition-colors whitespace-nowrap\">Lookalikes (Similares)</button>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-8 px-2\">\n<div class=\"md:col-span-2 space-y-6\">\n<p class=\"font-body-lg text-on-surface leading-relaxed\">\n                        Seta espectacular y emblem├ítica, f├ícilmente reconocible por su sombrero rojo vivo cubierto de puntos blancos. Aunque tradicionalmente se asocia con cuentos de hadas, es una especie t├│xica que contiene ├ícido ibot├®nico y muscimol, potentes neurotoxinas.\n                    </p>\n<div class=\"space-y-4\">\n<div class=\"flex gap-4\">\n<span class=\"material-symbols-outlined text-primary-container shrink-0\">radio_button_checked</span>\n<div>\n<h4 class=\"font-label-lg text-primary\">Sombrero</h4>\n<p class=\"text-on-surface-variant\">De 8 a 20 cm, globoso al principio, luego aplanado. Color rojo escarlata a naranja.</p>\n</div>\n</div>\n<div class=\"flex gap-4\">\n<span class=\"material-symbols-outlined text-primary-container shrink-0\">radio_button_checked</span>\n<div>\n<h4 class=\"font-label-lg text-primary\">Pie</h4>\n<p class=\"text-on-surface-variant\">Blanco, robusto, con anillo persistente y base provista de una volva fragmentada en c├¡rculos conc├®ntricos.</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"space-y-6\">\n<div class=\"glass-card rounded-3xl p-6 border-t border-primary/20\">\n<h4 class=\"font-headline-md text-[20px] mb-4 text-on-surface\">Toxicidad</h4>\n<p class=\"text-sm text-on-surface-variant mb-6 leading-relaxed\">Provoca el s├¡ndrome micoatrop├¡nico. Los s├¡ntomas incluyen mareos, alucinaciones, espasmos y un sue├▒o profundo.</p>\n<div class=\"w-full h-px bg-outline-variant/20 mb-6\"></div>\n<button class=\"w-full bg-primary text-on-primary font-label-lg py-4 rounded-2xl active:scale-95 transition-all flex items-center justify-center gap-2\">\n<span class=\"material-symbols-outlined\">book</span>\n                            Guardar en Cuaderno\n                        </button>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- Navigation Shell (BottomNavBar) -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 pb-safe bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl border-t border-outline-variant/10 shadow-lg rounded-t-xl\">\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined mb-1\">home</span>\n<span class=\"font-label-sm text-label-sm\">Inicio</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined mb-1\">center_focus_strong</span>\n<span class=\"font-label-sm text-label-sm\">Identificar</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined mb-1\">extension</span>\n<span class=\"font-label-sm text-label-sm\">Juegos</span>\n</a>\n<!-- ACTIVE TAB: Enciclopedia -->\n<a class=\"flex flex-col items-center justify-center bg-primary-container/80 text-on-primary-container rounded-full px-4 py-1 active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined mb-0.5\" style=\"font-variation-settings: 'FILL' 1;\">menu_book</span>\n<span class=\"font-label-sm text-label-sm font-bold\">Enciclopedia</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined mb-1\">more_horiz</span>\n<span class=\"font-label-sm text-label-sm\">M├ís</span>\n</a>\n</nav>\n<script>\n        // Simple micro-interaction for gallery scroll indicator\n        const gallery = document.getElementById('gallery');\n        const indicator = document.querySelector('.absolute.bottom-6.right-6 div');\n        \n        gallery.addEventListener('scroll', () => {\n            const index = Math.round(gallery.scrollLeft / gallery.clientWidth) + 1;\n            indicator.textContent = `${index} / 5`;\n        });\n\n        // Atmospheric effect: Subtle light movement\n        document.addEventListener('mousemove', (e) => {\n            const x = e.clientX / window.innerWidth;\n            const y = e.clientY / window.innerHeight;\n            \n            document.body.style.backgroundImage = `radial-gradient(circle at ${x * 100}% ${y * 100}%, rgba(143, 188, 143, 0.03) 0%, transparent 50%)`;\n        });\n    </script>\n</body></html>"}

{"screenId":"a7cc8b0c45224e128730285563f7f584","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>VisionSetil - Enciclopedia</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&amp;family=Geist:wght@300;400;500;600&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"on-error-container\": \"#ffdad6\",\n                    \"on-primary-fixed\": \"#002107\",\n                    \"surface-container\": \"#1e201d\",\n                    \"on-tertiary-fixed\": \"#201b0f\",\n                    \"on-tertiary-fixed-variant\": \"#4d4637\",\n                    \"on-surface\": \"#e2e3dd\",\n                    \"on-background\": \"#e2e3dd\",\n                    \"on-tertiary-container\": \"#4a4334\",\n                    \"on-primary\": \"#0e3817\",\n                    \"tertiary-container\": \"#bbb09d\",\n                    \"inverse-primary\": \"#3e6842\",\n                    \"on-secondary-container\": \"#b0bbb5\",\n                    \"background\": \"#0F1410\",\n                    \"on-secondary\": \"#28332e\",\n                    \"secondary-fixed\": \"#dae5df\",\n                    \"error-container\": \"#93000a\",\n                    \"on-primary-fixed-variant\": \"#274f2c\",\n                    \"error\": \"#ffb4ab\",\n                    \"secondary-fixed-dim\": \"#bec9c3\",\n                    \"secondary\": \"#bec9c3\",\n                    \"tertiary-fixed\": \"#ede1cd\",\n                    \"secondary-container\": \"#414b47\",\n                    \"tertiary-fixed-dim\": \"#d1c5b2\",\n                    \"surface-container-highest\": \"#333532\",\n                    \"on-surface-variant\": \"#c2c9be\",\n                    \"outline\": \"#8c9389\",\n                    \"on-error\": \"#690005\",\n                    \"outline-variant\": \"#424940\",\n                    \"surface-dim\": \"#121411\",\n                    \"inverse-on-surface\": \"#2f312d\",\n                    \"surface-bright\": \"#373a36\",\n                    \"on-secondary-fixed\": \"#141e1a\",\n                    \"primary-container\": \"#8fbc8f\",\n                    \"primary-fixed\": \"#bfefbe\",\n                    \"on-primary-container\": \"#234c29\",\n                    \"primary\": \"#aad8a9\",\n                    \"surface\": \"#121411\",\n                    \"surface-container-high\": \"#282b27\",\n                    \"inverse-surface\": \"#e2e3dd\",\n                    \"on-secondary-fixed-variant\": \"#3f4944\",\n                    \"surface-container-lowest\": \"#0c0f0c\",\n                    \"surface-tint\": \"#a4d2a4\",\n                    \"surface-variant\": \"#333532\",\n                    \"surface-container-low\": \"#1a1c19\",\n                    \"tertiary\": \"#d7cbb8\",\n                    \"primary-fixed-dim\": \"#a4d2a4\",\n                    \"on-tertiary\": \"#363022\",\n                    \"warning-red\": \"#EF4444\",\n                    \"warning-amber\": \"#F59E0B\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.125rem\",\n                    \"lg\": \"0.25rem\",\n                    \"xl\": \"0.5rem\",\n                    \"full\": \"0.75rem\"\n            },\n            \"spacing\": {\n                    \"gutter\": \"16px\",\n                    \"stack-md\": \"12px\",\n                    \"unit\": \"8px\",\n                    \"container-margin\": \"24px\",\n                    \"stack-lg\": \"24px\",\n                    \"stack-sm\": \"4px\"\n            },\n            \"fontFamily\": {\n                    \"body-lg\": [\"Geist\"],\n                    \"headline-md\": [\"Playfair Display\"],\n                    \"label-sm\": [\"Geist\"],\n                    \"label-md\": [\"Geist\"],\n                    \"headline-lg\": [\"Playfair Display\"],\n                    \"body-md\": [\"Geist\"],\n                    \"headline-lg-mobile\": [\"Playfair Display\"],\n                    \"display-lg\": [\"Playfair Display\"]\n            },\n            \"fontSize\": {\n                    \"body-lg\": [\"18px\", {\"lineHeight\": \"1.6\", \"fontWeight\": \"400\"}],\n                    \"headline-md\": [\"24px\", {\"lineHeight\": \"1.3\", \"fontWeight\": \"500\"}],\n                    \"label-sm\": [\"12px\", {\"lineHeight\": \"1.2\", \"fontWeight\": \"600\"}],\n                    \"label-md\": [\"14px\", {\"lineHeight\": \"1.4\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                    \"headline-lg\": [\"32px\", {\"lineHeight\": \"1.2\", \"fontWeight\": \"600\"}],\n                    \"body-md\": [\"16px\", {\"lineHeight\": \"1.6\", \"fontWeight\": \"400\"}],\n                    \"headline-lg-mobile\": [\"28px\", {\"lineHeight\": \"1.2\", \"fontWeight\": \"600\"}],\n                    \"display-lg\": [\"48px\", {\"lineHeight\": \"1.1\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}]\n            }\n          },\n        },\n      }\n    </script>\n<style>\n        body {\n            background-color: #0F1410;\n            color: #e2e3dd;\n            font-family: 'Geist', sans-serif;\n            -webkit-font-smoothing: antialiased;\n        }\n        .glass-card {\n            background-color: rgba(26, 36, 32, 0.6);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(143, 188, 143, 0.1);\n            transition: all 0.3s ease;\n        }\n        .glass-card:hover {\n            border-color: rgba(143, 188, 143, 0.3);\n            background-color: rgba(26, 36, 32, 0.8);\n        }\n        .inner-glow {\n            border-top: 1px solid rgba(143, 188, 143, 0.2);\n        }\n        ::-webkit-scrollbar {\n            display: none;\n        }\n        .active-tab-glow {\n            box-shadow: 0 0 15px rgba(164, 210, 164, 0.3);\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"min-h-screen pb-32\">\n<!-- Top Sticky Warning -->\n<div class=\"sticky top-0 z-[60] bg-error-container/90 backdrop-blur-md w-full py-2 px-4 flex justify-center items-center gap-2 border-b border-on-error/20\">\n<span class=\"material-symbols-outlined text-sm text-on-error-container\">warning</span>\n<p class=\"font-label-sm text-label-sm text-on-error-container tracking-wider\">\n            SOLO ORIENTACI├ôN ┬À NUNCA CONSUMO\n        </p>\n</div>\n<!-- Top AppBar -->\n<header class=\"fixed top-10 w-full z-50 bg-background/60 backdrop-blur-xl border-b border-on-surface-variant/10 flex items-center justify-between px-container-margin h-16 w-full\">\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-primary hover:opacity-80 transition-opacity active:scale-95 duration-200\">search</span>\n<h1 class=\"font-headline-md text-headline-md text-primary tracking-tight\">VisionSetil</h1>\n</div>\n<div class=\"w-10 h-10 rounded-full border border-primary/20 overflow-hidden active:scale-95 duration-200\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A professional studio portrait of a botanist in a dark, moody environment. The lighting is soft and directional, highlighting the textures of academic attire. The background is a deep, atmospheric dark green, consistent with a high-end, scientific OLED aesthetic. The overall mood is focused, intellectual, and prestigious.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBrmp9QVMio2_dcgljNnEh1JhmpxlyiAX9rhN0peN0wTT0bnj8I6V6ISZIAMc8Ksl_qV6HkVCcvW2KcIn4gKVqBIC1CSH_UuUGLocZHZUtCosxvOfy_6mCMBpgdfxBJYO6QciRSjGQzeCICMKMuEmtL7q-16GlsGWYbCDcP-cy0ukAhQZ7sEn9vtAh4kBnOtIWHrVnukMub3-FURgc6d428hvVn5tbzdjR2JVMzCnHzHPD17u2KBiv-T5WN3ErFgg4maCLg5iVDBnNo\"/>\n</div>\n</header>\n<main class=\"mt-28 px-container-margin max-w-[1200px] mx-auto\">\n<!-- Header Content -->\n<section class=\"mb-stack-lg\">\n<h2 class=\"font-headline-lg-mobile text-headline-lg-mobile text-tertiary mb-stack-md md:font-headline-lg md:text-headline-lg\">Enciclopedia Iberia</h2>\n<!-- Glass Search Bar -->\n<div class=\"glass-card inner-glow flex items-center px-4 py-3 rounded-xl mb-stack-lg\">\n<span class=\"material-symbols-outlined text-primary/60 mr-3\">search</span>\n<input class=\"bg-transparent border-none focus:ring-0 text-on-surface w-full font-body-md placeholder:text-on-surface-variant/40\" placeholder=\"Buscar especie o h├íbitat...\" type=\"text\"/>\n<span class=\"material-symbols-outlined text-primary/60\">filter_list</span>\n</div>\n</section>\n<!-- Filter Chips -->\n<section class=\"mb-stack-lg -mx-container-margin px-container-margin overflow-x-auto\">\n<div class=\"flex gap-stack-md whitespace-nowrap pb-2\">\n<button class=\"px-4 py-2 rounded-full bg-primary-container text-on-primary-container font-label-md text-label-md shadow-lg active-tab-glow\">Todos</button>\n<button class=\"px-4 py-2 rounded-full glass-card text-warning-red font-label-md text-label-md hover:bg-warning-red/10 transition-colors\">Riesgo: Mortal</button>\n<button class=\"px-4 py-2 rounded-full glass-card text-warning-amber font-label-md text-label-md hover:bg-warning-amber/10 transition-colors\">Riesgo: T├│xico</button>\n<button class=\"px-4 py-2 rounded-full glass-card text-primary font-label-md text-label-md\">Comestible (Precauci├│n)</button>\n<button class=\"px-4 py-2 rounded-full glass-card text-on-surface-variant font-label-md text-label-md\">Por H├íbitat</button>\n</div>\n</section>\n<!-- Species Grid -->\n<section class=\"grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4\">\n<!-- Species Card 1 -->\n<div class=\"glass-card inner-glow rounded-2xl overflow-hidden flex flex-col group cursor-pointer\">\n<div class=\"aspect-[4/5] relative overflow-hidden\">\n<img class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" data-alt=\"A high-resolution field photograph of an Amanita muscaria mushroom in a dark, atmospheric forest setting at dusk. The iconic red cap with white spots is vibrant against a background of deep shadows and mossy forest floor. Soft light catches the gills and the stem. Premium, scientific photography style with an atmospheric science aesthetic.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAJPBg2OCXE8m_VMDTylTzj9qETXvCKpKL71uERTFsxStCqOdExgmZ9bx_vqv92CSD7EQZPCbgnRZ3x8myuAOAcQiI3DpL_9PVrS8ssY-6EawfWuY10360wPj4XTFiIYQLjKUaIp-DCpSUrr2oyFnn2xWeVsO5Ylcz8zlgoZbVsnPppnBwVmek4M1e2xAbVbA3QK6bVu0dCgeRUxSa-N6EM54j5tKvAuXh0_y7fThUAWVn14VXOWJsIiOUlupIe_76SXM3_K1s7PvpM\"/>\n<div class=\"absolute top-2 right-2 px-2 py-1 bg-warning-amber/20 backdrop-blur-md rounded-md\">\n<span class=\"text-[10px] font-bold text-warning-amber tracking-tighter uppercase\">T├│xico</span>\n</div>\n</div>\n<div class=\"p-3\">\n<h3 class=\"font-headline-md text-[16px] text-tertiary-fixed leading-tight italic\">Amanita muscaria</h3>\n<p class=\"font-label-sm text-[10px] text-on-surface-variant mt-1 uppercase tracking-widest\">Matamoscas</p>\n</div>\n</div>\n<!-- Species Card 2 -->\n<div class=\"glass-card inner-glow rounded-2xl overflow-hidden flex flex-col group cursor-pointer\">\n<div class=\"aspect-[4/5] relative overflow-hidden\">\n<img class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" data-alt=\"A stunning field photograph of the deadly Amanita phalloides in a damp, shadowy woodland. The pale olive-green cap is captured with incredible detail against a background of dark soil and scattered leaves. The lighting is ethereal and moody, emphasizing the dangerous beauty of the fungus. Professional scientific cinematography.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuARHlY8YPG0-aUCI233jY76tqR2O4mF5E87KmcAjVpfiZuKLrpu51E0LsWoyMpdClvTOiGNcsL41NY-IJoqdSHeffQZVT96WuVN6aK5yshCebHttJJ4LY4-jptgWHal8A20O-uSZkpFsrRACLAHenoyrOtDHQtGXZV0facJ32DDKnK2z0vzM3LeYVrHPIo-GAVNXnFdxJYfRYg5r_9psza8Th3niuomsm9c1sGlraCGmG8FJzrTi4XMCxESJ7vqKThqmgAqTOxFgE13\"/>\n<div class=\"absolute top-2 right-2 px-2 py-1 bg-warning-red/20 backdrop-blur-md rounded-md\">\n<span class=\"text-[10px] font-bold text-warning-red tracking-tighter uppercase\">Mortal</span>\n</div>\n</div>\n<div class=\"p-3\">\n<h3 class=\"font-headline-md text-[16px] text-tertiary-fixed leading-tight italic\">Amanita phalloides</h3>\n<p class=\"font-label-sm text-[10px] text-on-surface-variant mt-1 uppercase tracking-widest\">Oronja Verde</p>\n</div>\n</div>\n<!-- Species Card 3 -->\n<div class=\"glass-card inner-glow rounded-2xl overflow-hidden flex flex-col group cursor-pointer\">\n<div class=\"aspect-[4/5] relative overflow-hidden\">\n<img class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" data-alt=\"A macro photograph of a Boletus edulis nestled in a bed of deep green moss. The thick brown cap is moist, catching soft moonlight. The background is a velvety midnight green, creating a sense of quiet discovery in a prestigious botanical collection. High-end, sharp detail on the texture of the stem and cap.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCaOeJTqTJFzPCh0f3i_up8_HIiYucbCuFFeDSZ1vMaRQDUHNPH0stiCIRS4A65AdFlMcL1iN6N_Kp3Mp38byPTfnsQLN84gEXswRlpUOVZO2Nb1DcK5YtyCj32l-ppQAPAvrfWNdewskP2-kHQ9gnOjWY2oWJYW0NV3hspcZW3W5xj6ePGadaeHscwIM8mO3GYCwbh7kERJuAo5yOpCAbjHwGUr9DPRUUodLL8pDeANyvREtbK9-YtH0V7XhIuRK4CcosNrgv8CkZR\"/>\n<div class=\"absolute top-2 right-2 px-2 py-1 bg-primary/20 backdrop-blur-md rounded-md\">\n<span class=\"text-[10px] font-bold text-primary tracking-tighter uppercase\">Comestible</span>\n</div>\n</div>\n<div class=\"p-3\">\n<h3 class=\"font-headline-md text-[16px] text-tertiary-fixed leading-tight italic\">Boletus edulis</h3>\n<p class=\"font-label-sm text-[10px] text-on-surface-variant mt-1 uppercase tracking-widest\">Calabaza</p>\n</div>\n</div>\n<!-- Species Card 4 -->\n<div class=\"glass-card inner-glow rounded-2xl overflow-hidden flex flex-col group cursor-pointer\">\n<div class=\"aspect-[4/5] relative overflow-hidden\">\n<img class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" data-alt=\"Close-up field photo of Macrolepiota procera in an open clearing during twilight. The large, scaly cap is showcased against a dim, out-of-focus background of grass and night sky. The aesthetic is academic and immersive, utilizing deep black and moss green tones to highlight the specimen's unique physical structure.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDNWdDaz1Ph1_5q8VU1tdcT3G-5CEDNQWlT9dlZn2taxFhKTjn17-08yvvGXperbdVa3MQn_Z69iWmAB1zoEXvaZbMqGozf92dY3Xvm0em7JKk34J_kzYRJ-zulBsdZjBXl-CCRYH2ep5aHfn8SWKrRWVIldo7tAEMfnSOowwy0pY6zc6mtrzIES1JN56YFdub488ChJ-rN3eiPxwAJJqpptZZOoyNkjox0xJongn2oSzKx9O5cxaRTpDTYzM18gcm4rWoiGxderaFg\"/>\n<div class=\"absolute top-2 right-2 px-2 py-1 bg-primary/20 backdrop-blur-md rounded-md\">\n<span class=\"text-[10px] font-bold text-primary tracking-tighter uppercase\">Comestible</span>\n</div>\n</div>\n<div class=\"p-3\">\n<h3 class=\"font-headline-md text-[16px] text-tertiary-fixed leading-tight italic\">Macrolepiota procera</h3>\n<p class=\"font-label-sm text-[10px] text-on-surface-variant mt-1 uppercase tracking-widest\">Parasol</p>\n</div>\n</div>\n<!-- Species Card 5 -->\n<div class=\"glass-card inner-glow rounded-2xl overflow-hidden flex flex-col group cursor-pointer\">\n<div class=\"aspect-[4/5] relative overflow-hidden\">\n<img class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" data-alt=\"Atmospheric laboratory style photo of Omphalotus olearius specimens. The orange mushrooms are shown in a dark setting, subtly suggesting their bioluminescence. The lighting is low-key, preserving the OLED black background while highlighting the sharp edges of the gills. Sophisticated scientific presentation.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBRwl0PNay24xMtg2mdKRZ7FTeidTOWJ4J34UQAqjS_5YOALouDjHh6s4DCU9Ncy7eWtY6OC6ykcCPv_oZgmkSjYTBPeOdy-ximqSQ4LxtNCaqcjDouu-HjOGArMpoqd2g5YYvveTaJFMqC8JOkMmxgnyRZCZixy16PDoNjbu1gL_y7lSLR6uqp5sbh6rwCgIO-zLlAhKQdjEOLOfbyJNTZ8L2fAOJ8uhcVaRPHiVJAMfDqbnqF6w7LbTNcFAtUX7M3Rd4q474pZCuN\"/>\n<div class=\"absolute top-2 right-2 px-2 py-1 bg-warning-amber/20 backdrop-blur-md rounded-md\">\n<span class=\"text-[10px] font-bold text-warning-amber tracking-tighter uppercase\">T├│xico</span>\n</div>\n</div>\n<div class=\"p-3\">\n<h3 class=\"font-headline-md text-[16px] text-tertiary-fixed leading-tight italic\">Omphalotus olearius</h3>\n<p class=\"font-label-sm text-[10px] text-on-surface-variant mt-1 uppercase tracking-widest\">Seta del Olivo</p>\n</div>\n</div>\n<!-- Species Card 6 -->\n<div class=\"glass-card inner-glow rounded-2xl overflow-hidden flex flex-col group cursor-pointer\">\n<div class=\"aspect-[4/5] relative overflow-hidden\">\n<img class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" data-alt=\"A detailed field photograph of Cantharellus cibarius emerging from a dark, wet forest floor. The vibrant yellow color of the chanterelle contrasts sharply with the deep green and black surroundings. The lighting is soft and diffuse, emphasizing the elegant, wavy shape of the cap. Minimalist and premium botanical art style.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDCU0dsglio09PvFxIROuGRWqfmK90-tyZfUDm52--nptuxJYEoiLkExgIjui60ZqKFU-1tb5UznyxcRoOksBfrcoD3JdCUo3GixdFjI4YoPaTqJ0GWlB2eEMsutgqC83qqg6p65HfeJOWIbFzzzOwulUPieIrNEeL99qRiLKX2ZF9cFoYR4Hi9InKAjmef_khimG7KVYk1MfYG0VE3p70BZ20yYCXW3UXhwFHlw1HfWvBiBEL-Bm1mDTUMYYUjKPZDGU514YsTio2Y\"/>\n<div class=\"absolute top-2 right-2 px-2 py-1 bg-primary/20 backdrop-blur-md rounded-md\">\n<span class=\"text-[10px] font-bold text-primary tracking-tighter uppercase\">Comestible</span>\n</div>\n</div>\n<div class=\"p-3\">\n<h3 class=\"font-headline-md text-[16px] text-tertiary-fixed leading-tight italic\">Cantharellus cibarius</h3>\n<p class=\"font-label-sm text-[10px] text-on-surface-variant mt-1 uppercase tracking-widest\">Rebozuelo</p>\n</div>\n</div>\n</section>\n</main>\n<!-- Bottom Navigation Bar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-3 pb-safe bg-background/60 backdrop-blur-xl border-t border-primary/20 rounded-t-full\">\n<!-- Inicio -->\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant opacity-60 hover:text-primary transition-colors active:scale-90 duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined\">home</span>\n<span class=\"font-label-sm text-label-sm\">Inicio</span>\n</a>\n<!-- Identificar -->\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant opacity-60 hover:text-primary transition-colors active:scale-90 duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined\">center_focus_strong</span>\n<span class=\"font-label-sm text-label-sm\">Identificar</span>\n</a>\n<!-- Juegos -->\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant opacity-60 hover:text-primary transition-colors active:scale-90 duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined\">extension</span>\n<span class=\"font-label-sm text-label-sm\">Juegos</span>\n</a>\n<!-- Enciclopedia (ACTIVE) -->\n<a class=\"flex flex-col items-center justify-center text-primary font-bold active:scale-90 duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">menu_book</span>\n<span class=\"font-label-sm text-label-sm\">Enciclopedia</span>\n</a>\n<!-- M├ís -->\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant opacity-60 hover:text-primary transition-colors active:scale-90 duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined\">more_horiz</span>\n<span class=\"font-label-sm text-label-sm\">M├ís</span>\n</a>\n</nav>\n<script>\n        // Micro-interaction for filter chips\n        const chips = document.querySelectorAll('button.glass-card, button.bg-primary-container');\n        chips.forEach(chip => {\n            chip.addEventListener('click', () => {\n                chips.forEach(c => {\n                    c.classList.remove('bg-primary-container', 'text-on-primary-container', 'shadow-lg', 'active-tab-glow');\n                    c.classList.add('glass-card');\n                });\n                chip.classList.remove('glass-card');\n                chip.classList.add('bg-primary-container', 'text-on-primary-container', 'shadow-lg', 'active-tab-glow');\n            });\n        });\n\n        // Search bar focus effect\n        const searchInput = document.querySelector('input');\n        const searchBar = searchInput.parentElement;\n        searchInput.addEventListener('focus', () => {\n            searchBar.style.borderColor = 'rgba(143, 188, 143, 0.5)';\n            searchBar.style.boxShadow = '0 0 20px rgba(143, 188, 143, 0.1)';\n        });\n        searchInput.addEventListener('blur', () => {\n            searchBar.style.borderColor = 'rgba(143, 188, 143, 0.1)';\n            searchBar.style.boxShadow = 'none';\n        });\n    </script>\n</body></html>"}

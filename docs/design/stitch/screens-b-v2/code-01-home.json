"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"gutter\": \"16px\",\n                        \"xs\": \"4px\",\n                        \"md\": \"24px\",\n                        \"sm\": \"12px\",\n                        \"lg\": \"40px\",\n                        \"margin-mobile\": \"20px\",\n                        \"base\": \"8px\",\n                        \"xl\": \"64px\",\n                        \"margin-desktop\": \"120px\"\n                    },\n                    \"fontFamily\": {\n                        \"body-md\": [\"\\\"Source Serif 4\\\"\"],\n                        \"headline-lg\": [\"Playfair Display\"],\n                        \"label-sm\": [\"\\\"Source Serif 4\\\"\"],\n                        \"headline-md\": [\"Playfair Display\"],\n                        \"body-lg\": [\"\\\"Source Serif 4\\\"\"],\n                        \"display-lg\": [\"Playfair Display\"],\n                        \"headline-lg-mobile\": [\"Playfair Display\"],\n                        \"label-lg\": [\"\\\"Source Serif 4\\\"\"]\n                    },\n                    \"fontSize\": {\n                        \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}],\n                        \"headline-lg\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                        \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                        \"headline-md\": [\"24px\", {\"lineHeight\": \"32px\", \"fontWeight\": \"600\"}],\n                        \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}],\n                        \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                        \"headline-lg-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}],\n                        \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"600\"}]\n                    }\n                },\n            },\n        }\n    </script>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .backdrop-blur-xl {\n            backdrop-filter: blur(24px);\n            -webkit-backdrop-filter: blur(24px);\n        }\n        .glass-card {\n            background: rgba(26, 36, 32, 0.6);\n            backdrop-filter: blur(20px);\n            -webkit-backdrop-filter: blur(20px);\n            border: 1px solid rgba(143, 188, 143, 0.1);\n        }\n        body {\n            background-color: #0F1410;\n        }\n    </style>\n</head>\n<body class=\"text-on-surface selection:bg-primary/30 min-h-screen flex flex-col font-body-md overflow-x-hidden\">\n<!-- Sticky Safety Strip -->\n<div class=\"fixed top-0 left-0 w-full z-[60] bg-error-container/90 backdrop-blur-md h-8 flex items-center justify-center\">\n<p class=\"text-[11px] font-label-lg text-on-error-container tracking-wider uppercase\">\n            Solo orientaci├│n ┬À nunca consumo\n        </p>\n</div>\n<!-- TopAppBar from JSON -->\n<header class=\"fixed top-8 left-0 w-full z-50 h-16 flex justify-between items-center px-margin-mobile bg-surface-container/60 backdrop-blur-xl border-b border-error/20\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary text-2xl\" data-icon=\"microbiology\">microbiology</span>\n<h1 class=\"font-headline-md text-headline-md text-primary tracking-tight\">VisionSetil</h1>\n</div>\n<div class=\"hidden md:flex items-center gap-6\">\n<span class=\"text-on-surface-variant font-label-lg text-label-lg hover:bg-surface-bright/20 transition-colors px-3 py-1 rounded-lg\">Solo orientaci├│n ┬À nunca consumo</span>\n</div>\n</header>\n<main class=\"flex-grow pt-24 pb-32\">\n<!-- Hero Section -->\n<section class=\"relative h-[85vh] w-full px-margin-mobile flex flex-col justify-end pb-12 overflow-hidden\">\n<!-- Background Image -->\n<div class=\"absolute inset-0 -z-10 bg-black\">\n<div class=\"w-full h-full opacity-60 bg-cover bg-center\" style=\"background-image: url('https://lh3.googleusercontent.com/aida/AP1WRLv9F1NngRZMGjTxRQYKiPvpD7A9hSxejzmW887CYfr7Y6IAC6tnmHS3l84f8AUutQQSCx6UODZ1xoPa_jSCsIzRVlLtubWlezlz-q9rZyVRFHLD5-TSETsFZ9lGDkJiIInVZKFvho-EvyyhKECC0SYj9iFGIFbH6Rr8mcC5QUHns1ylOeCOT01qbDLfmwrbrPJ_P-kTqN8NMMGoOlPv1WfI5CB7unldQNB-As5mKnuhGilDHqalB1yoKgs')\"></div>\n<div class=\"absolute inset-0 bg-gradient-to-t from-background via-background/20 to-transparent\"></div>\n</div>\n<div class=\"relative z-10 max-w-2xl\">\n<h2 class=\"font-display-lg text-display-lg text-on-surface mb-2 leading-tight\">VisionSetil</h2>\n<p class=\"font-body-lg text-body-lg text-secondary mb-8 max-w-sm\">\n                    Identificaci├│n multi-vista de campo. Captura cada detalle para una gu├¡a acad├®mica precisa.\n                </p>\n<!-- Primary Action -->\n<button class=\"glass-card w-full max-w-xs group flex items-center justify-between p-1 pl-6 rounded-full border border-primary/20 active:scale-95 transition-transform\">\n<span class=\"font-label-lg text-label-lg text-on-surface tracking-wide\">Probar Identificar</span>\n<div class=\"w-12 h-12 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container shadow-lg group-hover:bg-primary transition-colors\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">center_focus_strong</span>\n</div>\n</button>\n<!-- Multi-view Chips -->\n<div class=\"flex flex-wrap gap-2 mt-6\">\n<div class=\"glass-card px-4 py-1.5 rounded-full border border-white/5\">\n<span class=\"text-[12px] font-label-sm text-on-surface-variant\">Laminillas</span>\n</div>\n<div class=\"glass-card px-4 py-1.5 rounded-full border border-white/5\">\n<span class=\"text-[12px] font-label-sm text-on-surface-variant\">Perfil</span>\n</div>\n<div class=\"glass-card px-4 py-1.5 rounded-full border border-white/5\">\n<span class=\"text-[12px] font-label-sm text-on-surface-variant\">H├íbitat</span>\n</div>\n<div class=\"glass-card px-4 py-1.5 rounded-full border border-white/5\">\n<span class=\"text-[12px] font-label-sm text-on-surface-variant\">Detalle</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Trust Row -->\n<section class=\"px-margin-mobile py-lg\">\n<div class=\"flex flex-col md:flex-row md:items-center justify-between gap-6 border-t border-outline-variant/10 pt-base opacity-80\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary-container\" data-icon=\"hub\">hub</span>\n<span class=\"font-label-lg text-label-lg uppercase tracking-widest text-outline\">Open-set Engine</span>\n</div>\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary-container\" data-icon=\"auto_stories\">auto_stories</span>\n<span class=\"font-label-lg text-label-lg uppercase tracking-widest text-outline\">Enciclopedia Iberia</span>\n</div>\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-error\" data-icon=\"do_not_disturb_on\">do_not_disturb_on</span>\n<span class=\"font-label-lg text-label-lg uppercase tracking-widest text-outline\">Nunca consumo</span>\n</div>\n</div>\n</section>\n<!-- Secondary Quick Access -->\n<section class=\"px-margin-mobile\">\n<div class=\"grid grid-cols-3 gap-4\">\n<a class=\"glass-card p-4 rounded-xl flex flex-col items-center gap-2 hover:bg-surface-bright/30 transition-colors\" href=\"#\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"extension\">extension</span>\n<span class=\"font-label-sm text-label-sm text-secondary\">Juegos</span>\n</a>\n<a class=\"glass-card p-4 rounded-xl flex flex-col items-center gap-2 hover:bg-surface-bright/30 transition-colors\" href=\"#\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"menu_book\">menu_book</span>\n<span class=\"font-label-sm text-label-sm text-secondary\">Enciclopedia</span>\n</a>\n<a class=\"glass-card p-4 rounded-xl flex flex-col items-center gap-2 hover:bg-surface-bright/30 transition-colors\" href=\"#\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"map\">map</span>\n<span class=\"font-label-sm text-label-sm text-secondary\">Mapa</span>\n</a>\n</div>\n</section>\n<!-- Atmospheric Highlight Card -->\n<section class=\"px-margin-mobile mt-xl\">\n<div class=\"glass-card rounded-2xl p-6 relative overflow-hidden group\">\n<div class=\"absolute top-0 right-0 p-4 opacity-20\">\n<span class=\"material-symbols-outlined text-6xl\" data-icon=\"forest\">forest</span>\n</div>\n<h3 class=\"font-headline-md text-headline-md text-primary mb-2\">Observaci├│n Nocturna</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant max-w-xs mb-6\">\n                    Optimizado para luz tenue. El brillo de la interfaz no interferir├í con tu visi├│n nocturna de campo.\n                </p>\n<div class=\"flex gap-4\">\n<div class=\"flex -space-x-3 overflow-hidden\">\n<img class=\"inline-block h-8 w-8 rounded-full ring-2 ring-background object-cover\" data-alt=\"Close up of a wild mushroom gills in a dark forest background with soft mossy green lighting.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBKQDPq-IRlTWFw0wt9L_WYqxnXrOjnI4XnO3aUJudDOHS8T5NjfFIJXYfJ4QcYg74wj6FGglZWBa_vJXv34Zi-WlgCypMEotB7F9kNFDqqDPX4qsyxPs4sd64VO1QvnSySZMvdZuZVBww8BYxmu98km8AoCqDXemI2HX1g3B7ioCHXmwGMEqNaxZirUEiskjBS9bHBRRW_2d3NIkfI9ojLKG-3tWvAavdqJkkHGvezZScb0YUr7268VdpxQdTfPaNuJ571cyGhq6ex\"/>\n<img class=\"inline-block h-8 w-8 rounded-full ring-2 ring-background object-cover\" data-alt=\"Macro photo of a yellow fungus on a dark decayed log with atmospheric bokeh lights.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCfAumZXkz14JTZczSgP8u5HDleW3mxGJnhUAatPItAtx3D5UFcnsf-c-CvOUiB-vDXggAl2YdoqeCSWi7jlt9ejYrdjhMP6KkpQ4wzJQzBlfgdZBsB0J-5lWI6z6gJvC1nQkp4yz7XLWP4QCZ4Gzf-y5_TZ4Lo-V7KMJ4kWyJENUcaQSnvQ-22QiGv4-SWfurgpKlUT9rm5xPYS3orICw74QMWIWFP9T0xsCD00M2u5WB5i_3N6bKjW3y9ta5cCxcLAYM8fV_KyIuM\"/>\n<img class=\"inline-block h-8 w-8 rounded-full ring-2 ring-background object-cover\" data-alt=\"Detail of a mushroom cap with droplets of dew in a moonlit forest environment.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAfw9ju0g5yNWqdPMxUF0lfW4o7tK4kVcTAK0NLyOUoUelNgYWBm3qFlmi0eAeLulLYm0p28jqaAIjACgbY84L5UccX_m7KJEO1NHe5ZTwiagUvHCHzYgLTvvRsZ2tLVoO2w2021gI2T9DI4lTocLBzCq_P756_s1yv0Gt8zqYhZFrU7xYF7feFvhB4ZvyLEe7lNa7CxJwn6u1h0Ovp54DxJknGUxX0JN988erOqAYeHlXN0KRZ-BYhJuB6Jg_rwBsIXbKCGjaiT7Hw\"/>\n</div>\n<span class=\"text-label-sm font-label-sm text-outline flex items-center\">+12 Observaciones hoy</span>\n</div>\n</div>\n</section>\n</main>\n<!-- BottomNavBar from JSON -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 pb-safe bg-surface-container/60 backdrop-blur-xl border-t border-outline-variant/10 shadow-lg rounded-t-xl\">\n<a class=\"flex flex-col items-center justify-center bg-primary-container/80 text-on-primary-container rounded-full px-4 py-1 active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"home\" style=\"font-variation-settings: 'FILL' 1;\">home</span>\n<span class=\"font-label-sm text-label-sm\">Inicio</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"center_focus_strong\">center_focus_strong</span>\n<span class=\"font-label-sm text-label-sm\">Identificar</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"extension\">extension</span>\n<span class=\"font-label-sm text-label-sm\">Juegos</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"menu_book\">menu_book</span>\n<span class=\"font-label-sm text-label-sm\">Enciclopedia</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"more_horiz\">more_horiz</span>\n<span class=\"font-label-sm text-label-sm\">M├ís</span>\n</a>\n</nav>\n<!-- Micro-interaction script -->\n<script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const buttons = document.querySelectorAll('button, a');\n            buttons.forEach(btn => {\n                btn.addEventListener('touchstart', () => {\n                    btn.classList.add('scale-95');\n                });\n                btn.addEventListener('touchend', () => {\n                    btn.classList.remove('scale-95');\n                });\n            });\n        });\n    </script>\n</body></html>"}

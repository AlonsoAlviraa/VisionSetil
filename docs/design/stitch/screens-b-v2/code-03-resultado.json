                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"xs\": \"4px\",\n                        \"md\": \"24px\",\n                        \"base\": \"8px\",\n                        \"margin-desktop\": \"120px\",\n                        \"lg\": \"40px\",\n                        \"sm\": \"12px\",\n                        \"xl\": \"64px\",\n                        \"gutter\": \"16px\",\n                        \"margin-mobile\": \"20px\"\n                    },\n                    \"fontFamily\": {\n                        \"label-lg\": [\"Source Serif 4\"],\n                        \"body-md\": [\"Source Serif 4\"],\n                        \"body-lg\": [\"Source Serif 4\"],\n                        \"headline-lg\": [\"Playfair Display\"],\n                        \"headline-md\": [\"Playfair Display\"],\n                        \"label-sm\": [\"Source Serif 4\"],\n                        \"headline-lg-mobile\": [\"Playfair Display\"],\n                        \"display-lg\": [\"Playfair Display\"]\n                    },\n                    \"fontSize\": {\n                        \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"600\"}],\n                        \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}],\n                        \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}],\n                        \"headline-lg\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                        \"headline-md\": [\"24px\", {\"lineHeight\": \"32px\", \"fontWeight\": \"600\"}],\n                        \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                        \"headline-lg-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}],\n                        \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}]\n                    }\n                }\n            }\n        }\n    </script>\n<style>\n        body {\n            background-color: #0F1410;\n            color: #E8DCC8; /* Cream text */\n            -webkit-font-smoothing: antialiased;\n        }\n        .glass-card {\n            background-color: rgba(26, 36, 32, 0.6);\n            backdrop-filter: blur(20px);\n            -webkit-backdrop-filter: blur(20px);\n            border: 1px solid rgba(143, 188, 143, 0.1);\n        }\n        .safe-pb {\n            padding-bottom: env(safe-area-inset-bottom);\n        }\n        .text-cream {\n            color: #E8DCC8;\n        }\n    </style>\n</head>\n<body class=\"min-h-screen pb-32\">\n<!-- Top AppBar (from JSON guidance) -->\n<header class=\"fixed top-0 z-50 w-full h-16 flex justify-between items-center px-margin-mobile bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl border-b border-error/20\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary dark:text-primary\">microbiology</span>\n<span class=\"font-headline-md text-headline-md text-primary tracking-tight\">VisionSetil</span>\n</div>\n<div class=\"font-label-lg text-label-lg text-primary dark:text-primary opacity-80\">\n            Solo orientaci├│n ┬À nunca consumo\n        </div>\n</header>\n<main class=\"pt-20 px-margin-mobile max-w-2xl mx-auto space-y-md\">\n<!-- Results Summary -->\n<section class=\"flex justify-between items-end animate-in fade-in duration-700\">\n<div class=\"space-y-1\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant uppercase tracking-widest\">Resultado del An├ílisis</p>\n<div class=\"flex items-center gap-2\">\n<h1 class=\"font-headline-lg-mobile text-headline-lg-mobile text-cream\">Predicci├│n Principal</h1>\n<span class=\"material-symbols-outlined text-primary-container text-base\">verified</span>\n</div>\n</div>\n<div class=\"glass-card px-3 py-1 rounded-full flex items-center gap-2\">\n<span class=\"w-2 h-2 rounded-full bg-primary animate-pulse\"></span>\n<span class=\"font-label-sm text-label-sm text-primary\">Open-set aceptado</span>\n</div>\n</section>\n<!-- Primary Result Card -->\n<section class=\"animate-in slide-in-from-bottom-4 duration-700\">\n<div class=\"glass-card rounded-3xl overflow-hidden relative group transition-transform active:scale-[0.98]\">\n<div class=\"aspect-[4/5] relative\">\n<img alt=\"Amanita muscaria in forest\" class=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLtRnCHC_Q9UNDRgHkcrs-sLsx5BAHNNzjXY2gBM89lv7dhcYVyjGu-E3w7EweTrShVePTmQPm87d30v5NV8KhLJEZuIEPQjIn4xoflLOsWsqrnmJQ9UMkETfE7i9dygtx06VCwJXN_XFs9W2CN_xnqZQGwUUnqBcuKoMVYQbzVucd6MK-82T_fA-y9Ic-rxXuU5WIqVgcIdHLLyMVMdtCVdPk265EvaiBm1opyK6K6fEae_A6rW_DgjEnA\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-[#0F1410] via-transparent to-transparent opacity-60\"></div>\n<!-- Risk Chip -->\n<div class=\"absolute top-4 right-4 glass-card bg-error-container/90 border-error/30 px-4 py-2 rounded-xl flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-error\" style=\"font-variation-settings: 'FILL' 1;\">warning</span>\n<span class=\"font-label-lg text-label-lg text-on-error-container\">Riesgo: Muy Alto / Mortal</span>\n</div>\n<!-- ECE Indicator -->\n<div class=\"absolute bottom-4 left-4 glass-card px-3 py-1.5 rounded-lg border-primary/20\">\n<span class=\"font-label-sm text-label-sm text-on-surface-variant\">ECE: <span class=\"text-primary font-bold\">Alta</span></span>\n</div>\n</div>\n<div class=\"p-md space-y-2\">\n<div class=\"flex justify-between items-start\">\n<div>\n<h2 class=\"font-headline-md text-headline-md text-cream italic\">Amanita muscaria</h2>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant\">Matamoscas</p>\n</div>\n<button class=\"w-12 h-12 rounded-full glass-card flex items-center justify-center text-primary hover:bg-primary-container/20 transition-colors\">\n<span class=\"material-symbols-outlined\">bookmark</span>\n</button>\n</div>\n</div>\n</div>\n</section>\n<!-- Actions -->\n<section class=\"grid grid-cols-2 gap-gutter\">\n<button class=\"bg-primary-container text-on-primary-container h-14 rounded-2xl font-label-lg text-label-lg flex items-center justify-center gap-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-sm\">compare_arrows</span>\n                Comparar en Lookalike Studio\n            </button>\n<button class=\"glass-card text-cream h-14 rounded-2xl font-label-lg text-label-lg flex items-center justify-center gap-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-sm\">menu_book</span>\n                Ver en Enciclopedia\n            </button>\n</section>\n<!-- Lookalikes Section -->\n<section class=\"space-y-md\">\n<div class=\"flex items-center justify-between\">\n<h3 class=\"font-headline-md text-headline-md text-cream\">Especies Similares (Lookalikes)</h3>\n<span class=\"material-symbols-outlined text-on-surface-variant\">info</span>\n</div>\n<div class=\"space-y-gutter\">\n<!-- Item 1 -->\n<div class=\"glass-card rounded-2xl flex p-base gap-md hover:bg-surface-bright/20 transition-colors\">\n<div class=\"w-24 h-24 rounded-xl overflow-hidden shrink-0\">\n<img alt=\"Amanita caesarea\" class=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLu4DSAlNRfhxOQ5YYjs6lCpsuM_kBItJq1iFKNnCjeVCwqTzksGt6BU5ZCmVX4VAadGLm5HuhGnDwk49LQHZM22DoMdlN3qzOWiDCqxiCo1Bp7tn0TPev0OGqYhMvd7gJXDIoq7iLNDKqhItpE5FGZZuRVn4By08h_JEduzDA_DfCWw-AKCFpROABAvx3nCn7nvq0gHuAuDjZQ9syCXsSdYLKp1ITjnvASQeUh9lBepXdLc-Eiygh6IgY0\"/>\n</div>\n<div class=\"flex flex-col justify-between py-1 flex-1\">\n<div>\n<h4 class=\"font-label-lg text-label-lg text-cream italic\">Amanita caesarea</h4>\n<p class=\"font-label-s
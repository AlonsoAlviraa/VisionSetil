{"screenId":"825206f7400c4a15bbcc957b5aa82d9f","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Setadle - Mycological Habitat Sorting</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;family=Source+Serif+4:ital,wght@0,400;0,600;1,400&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"surface-container-highest\": \"#313631\",\n                        \"on-primary-fixed\": \"#002107\",\n                        \"tertiary-fixed\": \"#dae5df\",\n                        \"surface-bright\": \"#353a36\",\n                        \"on-background\": \"#dfe4dd\",\n                        \"on-secondary\": \"#363022\",\n                        \"on-primary-container\": \"#234c29\",\n                        \"error\": \"#ffb4ab\",\n                        \"secondary-fixed-dim\": \"#d1c5b2\",\n                        \"tertiary-container\": \"#a8b3ad\",\n                        \"surface-container-lowest\": \"#0a0f0b\",\n                        \"on-tertiary\": \"#28332e\",\n                        \"inverse-primary\": \"#3e6842\",\n                        \"tertiary\": \"#c3cfc8\",\n                        \"surface-tint\": \"#a4d2a4\",\n                        \"surface\": \"#101511\",\n                        \"on-tertiary-fixed-variant\": \"#3f4944\",\n                        \"on-error-container\": \"#ffdad6\",\n                        \"primary-container\": \"#8fbc8f\",\n                        \"error-container\": \"#93000a\",\n                        \"on-tertiary-container\": \"#3b4641\",\n                        \"surface-container-low\": \"#181d19\",\n                        \"primary\": \"#aad8a9\",\n                        \"surface-variant\": \"#313631\",\n                        \"surface-container\": \"#1c211c\",\n                        \"primary-fixed-dim\": \"#a4d2a4\",\n                        \"secondary-fixed\": \"#ede1cd\",\n                        \"on-error\": \"#690005\",\n                        \"on-tertiary-fixed\": \"#141e1a\",\n                        \"primary-fixed\": \"#bfefbe\",\n                        \"tertiary-fixed-dim\": \"#bec9c3\",\n                        \"on-secondary-fixed-variant\": \"#4d4637\",\n                        \"on-secondary-fixed\": \"#201b0f\",\n                        \"surface-container-high\": \"#262b27\",\n                        \"on-surface-variant\": \"#c2c9be\",\n                        \"on-surface\": \"#dfe4dd\",\n                        \"inverse-surface\": \"#dfe4dd\",\n                        \"background\": \"#101511\",\n                        \"inverse-on-surface\": \"#2c322d\",\n                        \"secondary\": \"#d1c5b2\",\n                        \"secondary-container\": \"#4d4637\",\n                        \"outline\": \"#8c9389\",\n                        \"on-primary-fixed-variant\": \"#274f2c\",\n                        \"on-primary\": \"#0e3817\",\n                        \"outline-variant\": \"#424940\",\n                        \"on-secondary-container\": \"#bfb4a1\",\n                        \"surface-dim\": \"#101511\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"lg\": \"40px\",\n                        \"base\": \"8px\",\n                        \"xs\": \"4px\",\n                        \"xl\": \"64px\",\n                        \"margin-mobile\": \"20px\",\n                        \"md\": \"24px\",\n                        \"sm\": \"12px\",\n                        \"margin-desktop\": \"120px\",\n                        \"gutter\": \"16px\"\n                    },\n                    \"fontFamily\": {\n                        \"body-md\": [\"\\\"Source Serif 4\\\"\"],\n                        \"label-sm\": [\"\\\"Source Serif 4\\\"\"],\n                        \"headline-lg\": [\"Playfair Display\"],\n                        \"body-lg\": [\"\\\"Source Serif 4\\\"\"],\n                        \"display-lg\": [\"Playfair Display\"],\n                        \"label-lg\": [\"\\\"Source Serif 4\\\"\"],\n                        \"headline-lg-mobile\": [\"Playfair Display\"],\n                        \"headline-md\": [\"Playfair Display\"]\n                    },\n                    \"fontSize\": {\n                        \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}],\n                        \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                        \"headline-lg\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                        \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}],\n                        \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                        \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"600\"}],\n                        \"headline-lg-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}],\n                        \"headline-md\": [\"24px\", {\"lineHeight\": \"32px\", \"fontWeight\": \"600\"}]\n                    }\n                }\n            }\n        }\n    </script>\n<style>\n        body {\n            background-color: #101511;\n            color: #dfe4dd;\n            font-family: \"Source Serif 4\", serif;\n            -webkit-tap-highlight-color: transparent;\n        }\n        .glass-card {\n            background-color: rgba(26, 36, 32, 0.6);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(143, 188, 143, 0.1);\n        }\n        .active-chip {\n            background-color: #8fbc8f;\n            color: #0e3817;\n            box-shadow: 0 0 15px rgba(143, 188, 143, 0.3);\n        }\n        .drop-zone-active {\n            border: 2px dashed #8fbc8f;\n            background-color: rgba(143, 188, 143, 0.05);\n        }\n        ::-webkit-scrollbar {\n            width: 6px;\n        }\n        ::-webkit-scrollbar-thumb {\n            background: #313631;\n            border-radius: 10px;\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"min-h-screen flex flex-col overflow-x-hidden\">\n<!-- TopAppBar -->\n<header class=\"fixed top-0 z-50 w-full h-16 flex justify-between items-center px-margin-mobile bg-surface-container/60 backdrop-blur-xl border-b border-error/20\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary font-bold\">microbiology</span>\n<h1 class=\"font-headline-md text-headline-md text-primary tracking-tight\">Setadle</h1>\n</div>\n<div class=\"hidden md:block\">\n<p class=\"font-label-lg text-label-lg text-on-surface-variant italic\">Solo orientaci├│n ┬À nunca consumo</p>\n</div>\n<div class=\"flex items-center gap-4\">\n<button class=\"material-symbols-outlined text-on-surface-variant hover:bg-surface-bright/20 p-2 rounded-full transition-colors active:scale-95\">help_outline</button>\n</div>\n</header>\n<!-- Mobile Warning Strip (Always visible for safety) -->\n<div class=\"mt-16 md:hidden w-full bg-error-container/20 py-2 px-margin-mobile border-b border-error/10 text-center\">\n<span class=\"font-label-sm text-label-sm text-error\">Solo orientaci├│n ┬À nunca consumo</span>\n</div>\n<!-- Main Game Canvas -->\n<main class=\"flex-grow pt-4 pb-24 px-margin-mobile max-w-screen-xl mx-auto w-full\">\n<!-- Game Header / Progress -->\n<section class=\"mb-gutter flex justify-between items-end\">\n<div>\n<span class=\"font-label-lg text-label-lg text-primary uppercase tracking-widest\">Reto Diario</span>\n<h2 class=\"font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg mt-1\">Sorteo de H├íbitat</h2>\n</div>\n<div class=\"text-right\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant\">Intentos: 0/3</p>\n<div class=\"flex gap-1 mt-1\">\n<div class=\"w-8 h-1 bg-primary-container rounded-full\"></div>\n<div class=\"w-8 h-1 bg-surface-container-highest rounded-full\"></div>\n<div class=\"w-8 h-1 bg-surface-container-highest rounded-full\"></div>\n</div>\n</div>\n</section>\n<div class=\"grid grid-cols-1 lg:grid-cols-12 gap-lg\">\n<!-- Daily Habitat Photo -->\n<section class=\"lg:col-span-7\">\n<div class=\"relative rounded-xl overflow-hidden shadow-2xl glass-card aspect-[4/3] md:aspect-video group\">\n<img class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" data-alt=\"A high-resolution, atmospheric close-up of a damp forest floor during twilight. Deep green moss covers decaying logs, while scattered orange and brown oak leaves rest on a bed of dark, rich soil. The lighting is soft and directional, highlighting the intricate textures of the forest bed and creating a moody, nocturnal field-journal aesthetic with deep shadows and vibrant organic greens.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCvPebgOsZyNlpOQ9zOxfKv3dLdeSnN15ZWzBZpydiC33vLdJE5qkCDrbmfMCQ7-Ts3k5Z4fUJls1sml5zW8QzzUKp9We7CEcKBtT1UPBY4QdKj8w5RyKVtxF8C6Kp9dLAi3nRRv8UeoDsEs79rKk4GyKmennkx69xz7BUBm1u974pKpByJ5t4pdkrHotuW8qX0lrQV6U-DQA9hEMNrG0OqiFcbkiAkNv83BCLAN6bpcrA81ynNMno36nDVuAJiqA9cLSSCt3pXuLDK\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-black/60 to-transparent\"></div>\n<div class=\"absolute bottom-4 left-4 right-4 flex justify-between items-center\">\n<div class=\"flex items-center gap-2 bg-black/40 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10\">\n<span class=\"material-symbols-outlined text-[18px] text-primary\">location_on</span>\n<span class=\"font-label-sm text-label-sm\">Sierra de Guadarrama, ES</span>\n</div>\n<button class=\"bg-primary/20 hover:bg-primary/40 backdrop-blur-md p-2 rounded-full border border-primary/30 transition-all active:scale-90\">\n<span class=\"material-symbols-outlined text-primary\">zoom_in</span>\n</button>\n</div>\n</div>\n</section>\n<!-- Habitat Sort Board -->\n<section class=\"lg:col-span-5 flex flex-col gap-gutter\">\n<div class=\"glass-card rounded-xl p-md flex flex-col gap-base\">\n<h3 class=\"font-headline-md text-headline-md text-primary\">Identificar Ecosistema</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant mb-2\">Arrastra los rasgos observados en la imagen a las celdas de clasificaci├│n.</p>\n<!-- Sorting Grid -->\n<div class=\"grid grid-cols-2 gap-base mt-4\">\n<div class=\"h-28 rounded-lg bg-surface-container-highest/40 border border-outline-variant/30 flex flex-col items-center justify-center gap-2 p-2 text-center group hover:border-primary/40 transition-colors cursor-pointer\">\n<span class=\"material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors\">forest</span>\n<span class=\"font-label-lg text-label-lg\">Tipo de Bosque</span>\n<div class=\"w-full h-px bg-outline-variant/20\"></div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant italic\">Vac├¡o</span>\n</div>\n<div class=\"h-28 rounded-lg bg-surface-container-highest/40 border border-outline-variant/30 flex flex-col items-center justify-center gap-2 p-2 text-center group hover:border-primary/40 transition-colors cursor-pointer\">\n<span class=\"material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors\">water_drop</span>\n<span class=\"font-label-lg text-label-lg\">Sustrato</span>\n<div class=\"w-full h-px bg-outline-variant/20\"></div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant italic\">Vac├¡o</span>\n</div>\n<div class=\"h-28 rounded-lg bg-surface-container-highest/40 border border-outline-variant/30 flex flex-col items-center justify-center gap-2 p-2 text-center group hover:border-primary/40 transition-colors cursor-pointer\">\n<span class=\"material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors\">thermostat</span>\n<span class=\"font-label-lg text-label-lg\">Microclima</span>\n<div class=\"w-full h-px bg-outline-variant/20\"></div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant italic\">Vac├¡o</span>\n</div>\n<div class=\"h-28 rounded-lg bg-surface-container-highest/40 border border-outline-variant/30 flex flex-col items-center justify-center gap-2 p-2 text-center group hover:border-primary/40 transition-colors cursor-pointer\">\n<span class=\"material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors\">terrain</span>\n<span class=\"font-label-lg text-label-lg\">Acidez</span>\n<div class=\"w-full h-px bg-outline-variant/20\"></div>\n<span class=\"font-label-sm text-label-sm text-on-surface-variant italic\">Vac├¡o</span>\n</div>\n</div>\n<!-- Interactive Tiles/Chips -->\n<div class=\"mt-6\">\n<h4 class=\"font-label-lg text-label-lg text-on-surface mb-3 uppercase tracking-wider\">Opciones Disponibles</h4>\n<div class=\"flex flex-wrap gap-2\">\n<button class=\"px-4 py-2 rounded-full border border-outline-variant hover:border-primary transition-all duration-200 font-label-lg text-label-lg flex items-center gap-2 active:scale-95\" onclick=\"toggleChip(this)\">\n<span class=\"w-2 h-2 rounded-full bg-primary/40\"></span> Pinar\n                            </button>\n<button class=\"px-4 py-2 rounded-full border border-outline-variant hover:border-primary transition-all duration-200 font-label-lg text-label-lg flex items-center gap-2 active:scale-95\" onclick=\"toggleChip(this)\">\n<span class=\"w-2 h-2 rounded-full bg-primary/40\"></span> Encinar\n                            </button>\n<button class=\"px-4 py-2 rounded-full border border-outline-variant hover:border-primary transition-all duration-200 font-label-lg text-label-lg flex items-center gap-2 active:scale-95\" onclick=\"toggleChip(this)\">\n<span class=\"w-2 h-2 rounded-full bg-primary/40\"></span> Suelo ├ücido\n                            </button>\n<button class=\"px-4 py-2 rounded-full border border-outline-variant hover:border-primary transition-all duration-200 font-label-lg text-label-lg flex items-center gap-2 active:scale-95\" onclick=\"toggleChip(this)\">\n<span class=\"w-2 h-2 rounded-full bg-primary/40\"></span> Humedad Alta\n                            </button>\n<button class=\"px-4 py-2 rounded-full border border-outline-variant hover:border-primary transition-all duration-200 font-label-lg text-label-lg flex items-center gap-2 active:scale-95\" onclick=\"toggleChip(this)\">\n<span class=\"w-2 h-2 rounded-full bg-primary/40\"></span> Robledal\n                            </button>\n<button class=\"px-4 py-2 rounded-full border border-outline-variant hover:border-primary transition-all duration-200 font-label-lg text-label-lg flex items-center gap-2 active:scale-95\" onclick=\"toggleChip(this)\">\n<span class=\"w-2 h-2 rounded-full bg-primary/40\"></span> Calizo\n                            </button>\n</div>\n</div>\n<button class=\"w-full mt-lg py-4 rounded-xl bg-primary text-on-primary font-headline-md text-headline-md active:scale-95 transition-transform shadow-lg shadow-primary/20\">\n                        Verificar Selecci├│n\n                    </button>\n</div>\n</section>\n</div>\n<!-- Educational Note -->\n<section class=\"mt-lg mb-gutter\">\n<div class=\"glass-card rounded-xl p-md border-l-4 border-primary\">\n<div class=\"flex items-start gap-4\">\n<div class=\"bg-primary/20 p-2 rounded-lg\">\n<span class=\"material-symbols-outlined text-primary\" style=\"font-variation-settings: 'FILL' 1;\">menu_book</span>\n</div>\n<div>\n<h4 class=\"font-headline-md text-headline-md text-primary mb-1\">Nota Educativa</h4>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed\">\n                            El an├ílisis del h├íbitat es crucial para la identificaci├│n correcta de las setas. Este juego est├í dise├▒ado ├║nicamente como una herramienta de entrenamiento visual para bot├ínicos y aficionados serios. Recuerda que la identificaci├│n en el campo requiere m├║ltiples confirmaciones f├¡sicas y nunca debe basarse solo en una fotograf├¡a. <span class=\"text-error font-semibold\">Nunca consumas setas que no hayan sido verificadas profesionalmente por un experto.</span>\n</p>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- BottomNavBar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 pb-safe bg-surface-container/60 backdrop-blur-xl rounded-t-xl shadow-lg border-t border-outline-variant/10\">\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\">home</span>\n<span class=\"font-label-sm text-label-sm\">Inicio</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\">center_focus_strong</span>\n<span class=\"font-label-sm text-label-sm\">Identificar</span>\n</a>\n<!-- ACTIVE TAB: Juegos -->\n<a class=\"flex flex-col items-center justify-center bg-primary-container/80 text-on-primary-container rounded-full px-4 py-1 active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">extension</span>\n<span class=\"font-label-sm text-label-sm\">Juegos</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\">menu_book</span>\n<span class=\"font-label-sm text-label-sm\">Enciclopedia</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\">more_horiz</span>\n<span class=\"font-label-sm text-label-sm\">M├ís</span>\n</a>\n</nav>\n<script>\n        function toggleChip(element) {\n            element.classList.toggle('active-chip');\n            element.classList.toggle('border-outline-variant');\n            element.classList.toggle('border-primary');\n            \n            // Subtle click vibration feel\n            if (window.navigator && window.navigator.vibrate) {\n                window.navigator.vibrate(5);\n            }\n        }\n\n        // Add a soft pulsing effect to the \"available\" header when interaction starts\n        document.addEventListener('DOMContentLoaded', () => {\n            const chips = document.querySelectorAll('button[onclick=\"toggleChip(this)\"]');\n            chips.forEach(chip => {\n                chip.addEventListener('mouseenter', () => {\n                    // Logic for hover states if needed beyond tailwind\n                });\n            });\n        });\n    </script>\n</body></html>"}

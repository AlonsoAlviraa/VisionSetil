{"screenId":"f3c7683d3ec140de843b0cb889ce961c","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" name=\"viewport\"/>\n<title>VisionSetil - Paquetes Offline</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&amp;family=Hanken+Grotesk:wght@400;500;600&amp;family=JetBrains+Mono:wght@500&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"surface-container\": \"#1c211c\",\n                    \"primary-fixed-dim\": \"#a4d2a4\",\n                    \"primary-container\": \"#8fbc8f\",\n                    \"surface-bright\": \"#353a36\",\n                    \"background\": \"#101511\",\n                    \"error\": \"#ffb4ab\",\n                    \"on-primary-fixed-variant\": \"#274f2c\",\n                    \"tertiary\": \"#d7cbb8\",\n                    \"on-secondary\": \"#28332e\",\n                    \"surface-container-high\": \"#262b27\",\n                    \"surface-container-lowest\": \"#0a0f0b\",\n                    \"on-surface-variant\": \"#c2c9be\",\n                    \"on-error-container\": \"#ffdad6\",\n                    \"on-tertiary-container\": \"#4a4334\",\n                    \"on-primary-fixed\": \"#002107\",\n                    \"surface-dim\": \"#101511\",\n                    \"primary\": \"#aad8a9\",\n                    \"on-primary-container\": \"#234c29\",\n                    \"on-tertiary-fixed-variant\": \"#4d4637\",\n                    \"on-tertiary-fixed\": \"#201b0f\",\n                    \"inverse-primary\": \"#3e6842\",\n                    \"on-primary\": \"#0e3817\",\n                    \"tertiary-fixed-dim\": \"#d1c5b2\",\n                    \"primary-fixed\": \"#bfefbe\",\n                    \"secondary-fixed-dim\": \"#bec9c3\",\n                    \"on-secondary-fixed-variant\": \"#3f4944\",\n                    \"secondary-container\": \"#414b47\",\n                    \"on-surface\": \"#dfe4dd\",\n                    \"inverse-surface\": \"#dfe4dd\",\n                    \"on-secondary-container\": \"#b0bbb5\",\n                    \"on-secondary-fixed\": \"#141e1a\",\n                    \"error-container\": \"#93000a\",\n                    \"outline\": \"#8c9389\",\n                    \"surface\": \"#101511\",\n                    \"secondary-fixed\": \"#dae5df\",\n                    \"surface-tint\": \"#a4d2a4\",\n                    \"outline-variant\": \"#424940\",\n                    \"inverse-on-surface\": \"#2c322d\",\n                    \"surface-container-low\": \"#181d19\",\n                    \"surface-variant\": \"#313631\",\n                    \"secondary\": \"#bec9c3\",\n                    \"on-error\": \"#690005\",\n                    \"tertiary-container\": \"#bbb09d\",\n                    \"on-background\": \"#dfe4dd\",\n                    \"on-tertiary\": \"#363022\",\n                    \"tertiary-fixed\": \"#ede1cd\",\n                    \"surface-container-highest\": \"#313631\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"element-gap\": \"12px\",\n                    \"base\": \"8px\",\n                    \"container-padding\": \"20px\",\n                    \"safe-area\": \"16px\",\n                    \"section-margin\": \"32px\"\n            },\n            \"fontFamily\": {\n                    \"headline-lg\": [\"Playfair Display\"],\n                    \"body-lg\": [\"Hanken Grotesk\"],\n                    \"headline-lg-mobile\": [\"Playfair Display\"],\n                    \"display-lg\": [\"Playfair Display\"],\n                    \"title-md\": [\"Playfair Display\"],\n                    \"label-sm\": [\"JetBrains Mono\"],\n                    \"body-md\": [\"Hanken Grotesk\"]\n            },\n            \"fontSize\": {\n                    \"headline-lg\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                    \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}],\n                    \"headline-lg-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}],\n                    \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"title-md\": [\"20px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"500\"}],\n                    \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                    \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}]\n            }\n          },\n        },\n      }\n    </script>\n<style>\n      body {\n        background-color: #0F1410;\n        color: #dfe4dd;\n        -webkit-font-smoothing: antialiased;\n      }\n      .glass-card {\n        background: rgba(26, 36, 32, 0.6);\n        backdrop-filter: blur(12px);\n        -webkit-backdrop-filter: blur(12px);\n        border: 0.5px solid rgba(143, 188, 143, 0.2);\n      }\n      .material-symbols-outlined {\n        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n      }\n      .progress-shimmer {\n        background: linear-gradient(90deg, #8fbc8f 0%, #aad8a9 50%, #8fbc8f 100%);\n        background-size: 200% 100%;\n        animation: shimmer 2s infinite linear;\n      }\n      @keyframes shimmer {\n        0% { background-position: 200% 0; }\n        100% { background-position: -200% 0; }\n      }\n    </style>\n</head>\n<body class=\"flex flex-col min-h-screen font-body-md text-body-md pb-24\">\n<!-- Top Warning Bar -->\n<header class=\"fixed top-0 w-full z-50 bg-error-container text-on-error-container shadow-[0_0_20px_rgba(147,0,10,0.4)] flex items-center justify-center h-10 px-4 transition-opacity duration-200\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[16px]\">warning</span>\n<span class=\"font-label-sm text-label-sm font-bold tracking-widest uppercase\">SOLO ORIENTACI├ôN, NUNCA CONSUMO</span>\n</div>\n</header>\n<main class=\"mt-14 px-container-padding flex flex-col gap-section-margin\">\n<!-- Header Section -->\n<section class=\"mt-4\">\n<h1 class=\"font-headline-lg-mobile text-headline-lg-mobile text-on-surface mb-2\">Paquetes Offline</h1>\n<p class=\"font-body-md text-on-surface-variant leading-relaxed\">\n                Asegura tu expedici├│n. Descarga la cartograf├¡a y gu├¡as micol├│gicas para mantener la seguridad en zonas de sombra de red o bosques profundos.\n            </p>\n</section>\n<!-- Active Download Card -->\n<section>\n<div class=\"glass-card rounded-xl p-5 relative overflow-hidden\">\n<div class=\"absolute top-0 left-0 w-full h-1 bg-surface-container-low\">\n<div class=\"h-full progress-shimmer\" style=\"width: 65%;\"></div>\n</div>\n<div class=\"flex justify-between items-start mb-4 pt-2\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-sm text-primary uppercase mb-1\">Descargando...</span>\n<h2 class=\"font-title-md text-title-md text-on-surface\">Gu├¡a de Oto├▒o - Soria</h2>\n<p class=\"font-body-md text-on-surface-variant text-sm\">Sistema Central y alrededores</p>\n</div>\n<div class=\"text-right\">\n<span class=\"font-headline-lg-mobile text-primary\">65%</span>\n</div>\n</div>\n<div class=\"flex items-center justify-between mt-6\">\n<span class=\"font-label-sm text-on-surface-variant\">1.2GB / 1.8GB</span>\n<button class=\"flex items-center gap-2 text-on-error-container bg-error-container/20 px-3 py-1.5 rounded-full transition-all active:scale-95\">\n<span class=\"material-symbols-outlined text-[18px]\">pause</span>\n<span class=\"font-label-sm\">Pausar</span>\n</button>\n</div>\n</div>\n</section>\n<!-- Available List -->\n<section class=\"flex flex-col gap-element-gap\">\n<h3 class=\"font-label-sm text-on-surface-variant uppercase tracking-widest px-1\">Biblioteca Local</h3>\n<!-- Item 1: Downloaded -->\n<div class=\"glass-card rounded-xl p-4 flex items-center justify-between border-l-4 border-l-primary-container\">\n<div class=\"flex items-center gap-4\">\n<div class=\"w-12 h-12 rounded-lg overflow-hidden bg-surface-container-highest flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary\">check_circle</span>\n</div>\n<div>\n<h4 class=\"font-title-md text-on-surface text-base\">Gu├¡a de Primavera</h4>\n<p class=\"font-body-md text-xs text-on-surface-variant\">Descargado ÔÇó 840 MB</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant\">more_vert</span>\n</div>\n<!-- Item 2 -->\n<div class=\"glass-card rounded-xl p-4 flex items-center justify-between\">\n<div class=\"flex items-center gap-4\">\n<div class=\"w-12 h-12 rounded-lg overflow-hidden bg-surface-container-highest flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-secondary\">map</span>\n</div>\n<div>\n<h4 class=\"font-title-md text-on-surface text-base\">Mapas Topogr├íficos</h4>\n<p class=\"font-body-md text-xs text-on-surface-variant\">Disponible ÔÇó 2.4 GB</p>\n</div>\n</div>\n<button class=\"p-2 rounded-full hover:bg-white/5 active:scale-90 transition-all\">\n<span class=\"material-symbols-outlined text-primary\">download</span>\n</button>\n</div>\n<!-- Item 3 -->\n<div class=\"glass-card rounded-xl p-4 flex items-center justify-between\">\n<div class=\"flex items-center gap-4\">\n<div class=\"w-12 h-12 rounded-lg overflow-hidden bg-surface-container-highest flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-secondary\">psychology</span>\n</div>\n<div>\n<h4 class=\"font-title-md text-on-surface text-base\">Modelos IA de baja latencia</h4>\n<p class=\"font-body-md text-xs text-on-surface-variant\">Disponible ÔÇó 450 MB</p>\n</div>\n</div>\n<button class=\"p-2 rounded-full hover:bg-white/5 active:scale-90 transition-all\">\n<span class=\"material-symbols-outlined text-primary\">download</span>\n</button>\n</div>\n</section>\n<!-- Visual Anchor: Field Image -->\n<section class=\"rounded-xl overflow-hidden glass-card\">\n<div class=\"h-48 w-full relative\">\n<img class=\"w-full h-full object-cover opacity-60\" data-alt=\"A professional close-up macro photograph of a wild mushroom emerging from a lush forest floor in Spain. The scene is captured at twilight, featuring deep mossy greens, damp fallen leaves, and a soft atmospheric bokeh. The lighting is moody and organic, emphasizing the tactile textures of the fungal gills and the surrounding ecosystem in a modern naturalist style.\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLv9F1NngRZMGjTxRQYKiPvpD7A9hSxejzmW887CYfr7Y6IAC6tnmHS3l84f8AUutQQSCx6UODZ1xoPa_jSCsIzRVlLtubWlezlz-q9rZyVRFHLD5-TSETsFZ9lGDkJiIInVZKFvho-EvyyhKECC0SYj9iFGIFbH6Rr8mcC5QUHns1ylOeCOT01qbDLfmwrbrPJ_P-kTqN8NMMGoOlPv1WfI5CB7unldQNB-As5mKnuhGilDHqalB1yoKgs\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-background to-transparent\"></div>\n<div class=\"absolute bottom-4 left-4 right-4\">\n<span class=\"font-label-sm text-primary uppercase bg-background/80 px-2 py-1 rounded backdrop-blur-sm\">Campo Real: Amanita Muscaria</span>\n</div>\n</div>\n</section>\n<!-- Honesty Message -->\n<section class=\"glass-card bg-surface-container-low/30 p-4 rounded-xl border-dashed border-outline-variant\">\n<div class=\"flex gap-3\">\n<span class=\"material-symbols-outlined text-tertiary\">info</span>\n<p class=\"font-body-md text-sm text-on-surface-variant italic\">\n                    El modo offline permite la consulta de la enciclopedia y mapas, pero la identificaci├│n por IA requiere conexi├│n para m├íxima precisi├│n.\n                </p>\n</div>\n</section>\n<!-- Main Action Button -->\n<section class=\"px-2\">\n<button class=\"w-full bg-primary-container text-on-primary-container py-4 rounded-xl font-title-md flex items-center justify-center gap-3 shadow-lg active:scale-[0.98] transition-transform\">\n<span class=\"material-symbols-outlined\">download_for_offline</span>\n                Descargar Todo\n            </button>\n</section>\n</main>\n<!-- Bottom Navigation Shell -->\n<nav class=\"fixed bottom-0 w-full z-50 rounded-t-xl backdrop-blur-xl bg-surface-container/60 border-t border-primary/20 flex justify-around items-center px-4 py-2 pb-safe\">\n<!-- Inicio -->\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant hover:bg-white/5 active:scale-95 transition-all duration-300\">\n<span class=\"material-symbols-outlined\">home</span>\n<span class=\"font-body-md text-[10px]\">Inicio</span>\n</div>\n<!-- Identificar -->\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant hover:bg-white/5 active:scale-95 transition-all duration-300\">\n<span class=\"material-symbols-outlined\">center_focus_strong</span>\n<span class=\"font-body-md text-[10px]\">Identificar</span>\n</div>\n<!-- Juegos -->\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant hover:bg-white/5 active:scale-95 transition-all duration-300\">\n<span class=\"material-symbols-outlined\">sports_esports</span>\n<span class=\"font-body-md text-[10px]\">Juegos</span>\n</div>\n<!-- Enciclopedia -->\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant hover:bg-white/5 active:scale-95 transition-all duration-300\">\n<span class=\"material-symbols-outlined\">menu_book</span>\n<span class=\"font-body-md text-[10px]\">Enciclopedia</span>\n</div>\n<!-- M├ís (Active) -->\n<div class=\"flex flex-col items-center justify-center text-primary dark:text-primary bg-primary-container/20 rounded-xl px-3 py-1 active:scale-95 transition-all duration-300\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">more_horiz</span>\n<span class=\"font-body-md text-[10px]\">M├ís</span>\n</div>\n</nav>\n<script>\n      // Lightweight micro-interaction for the progress bar\n      let progress = 65;\n      const progressBar = document.querySelector('.progress-shimmer');\n      const progressText = document.querySelector('.text-primary.font-headline-lg-mobile');\n\n      function updateProgress() {\n        if (progress < 100) {\n          progress += Math.random() * 0.1;\n          if (progressBar) progressBar.style.width = `${progress}%`;\n          if (progressText) progressText.innerText = `${Math.floor(progress)}%`;\n          requestAnimationFrame(updateProgress);\n        }\n      }\n      \n      // Start the subtle progress simulation\n      setTimeout(() => {\n        requestAnimationFrame(updateProgress);\n      }, 1000);\n    </script>\n</body></html>"}

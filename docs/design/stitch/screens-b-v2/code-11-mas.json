{"screenId":"b3f7d79009a346f0b9a3fe597ade2501","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" name=\"viewport\"/>\n<title>VisionSetil - M├ís</title>\n<!-- Fonts -->\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;family=Hanken+Grotesk:wght@400;600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Material Symbols -->\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"tertiary-fixed-dim\": \"#ffb4a8\",\n                    \"on-secondary-container\": \"#b9baa3\",\n                    \"primary-container\": \"#2d4c3b\",\n                    \"inverse-primary\": \"#466553\",\n                    \"on-tertiary\": \"#690000\",\n                    \"on-secondary-fixed\": \"#1b1d0e\",\n                    \"surface-container\": \"#1e201e\",\n                    \"on-background\": \"#e3e3df\",\n                    \"secondary-fixed\": \"#e4e4cc\",\n                    \"inverse-surface\": \"#e3e3df\",\n                    \"error-container\": \"#93000a\",\n                    \"tertiary\": \"#ffb4a8\",\n                    \"surface-variant\": \"#333533\",\n                    \"inverse-on-surface\": \"#2f312f\",\n                    \"surface-container-highest\": \"#333533\",\n                    \"on-primary-fixed\": \"#012113\",\n                    \"background\": \"#0F1410\", // Updated to Brand OLED Black\n                    \"on-primary\": \"#173627\",\n                    \"tertiary-fixed\": \"#ffdad4\",\n                    \"surface-tint\": \"#accfb8\",\n                    \"on-tertiary-fixed-variant\": \"#920703\",\n                    \"primary-fixed-dim\": \"#accfb8\",\n                    \"surface-container-high\": \"#292a29\",\n                    \"outline-variant\": \"#424843\",\n                    \"on-error\": \"#690005\",\n                    \"on-tertiary-container\": \"#ff9787\",\n                    \"tertiary-container\": \"#900502\",\n                    \"primary-fixed\": \"#c7ebd4\",\n                    \"surface\": \"#0F1410\",\n                    \"on-surface-variant\": \"#c2c8c1\",\n                    \"on-primary-fixed-variant\": \"#2e4d3c\",\n                    \"secondary\": \"#c8c8b0\",\n                    \"secondary-container\": \"#494a38\",\n                    \"on-surface\": \"#E8DCC8\", // Updated to Brand Cream\n                    \"primary\": \"#8FBC8F\", // Updated to Moss Green\n                    \"surface-bright\": \"#383a38\",\n                    \"on-error-container\": \"#ffdad6\",\n                    \"outline\": \"#8c928c\",\n                    \"surface-container-lowest\": \"#0d0f0d\",\n                    \"surface-dim\": \"#0F1410\",\n                    \"on-tertiary-fixed\": \"#410000\",\n                    \"on-primary-container\": \"#99bca6\",\n                    \"secondary-fixed-dim\": \"#c8c8b0\",\n                    \"error\": \"#ffb4ab\",\n                    \"on-secondary-fixed-variant\": \"#474836\",\n                    \"surface-container-low\": \"#1a1c1a\",\n                    \"on-secondary\": \"#303221\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"stack-lg\": \"48px\",\n                    \"container-padding\": \"20px\",\n                    \"stack-sm\": \"12px\",\n                    \"gutter\": \"16px\",\n                    \"stack-md\": \"24px\",\n                    \"base\": \"8px\"\n            },\n            \"fontFamily\": {\n                    \"body-md\": [\"Hanken Grotesk\"],\n                    \"title-lg\": [\"Hanken Grotesk\"],\n                    \"headline-md\": [\"Playfair Display\"],\n                    \"label-sm\": [\"Hanken Grotesk\"],\n                    \"headline-md-mobile\": [\"Playfair Display\"],\n                    \"display-lg\": [\"Playfair Display\"],\n                    \"body-lg\": [\"Hanken Grotesk\"]\n            },\n            \"fontSize\": {\n                    \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}],\n                    \"title-lg\": [\"20px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"600\"}],\n                    \"headline-md\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                    \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"700\"}],\n                    \"headline-md-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}],\n                    \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}]\n            }\n          },\n        },\n      }\n    </script>\n<style>\n        .glass-card {\n            background: rgba(26, 36, 32, 0.6);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(232, 220, 200, 0.1);\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .active-glow {\n            box-shadow: 0 0 15px rgba(143, 188, 143, 0.3);\n        }\n        body {\n            background-color: #0F1410;\n            color: #E8DCC8;\n        }\n        .safe-bottom {\n            padding-bottom: env(safe-area-inset-bottom, 24px);\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"font-body-md text-body-md overflow-x-hidden\">\n<!-- Top Warning Bar (JSON Small Type) -->\n<header class=\"sticky top-0 left-0 w-full z-50 bg-tertiary-container dark:bg-tertiary-container flex items-center justify-center py-2 px-4 text-center\">\n<span class=\"material-symbols-outlined text-on-tertiary-container mr-2 text-sm\">warning</span>\n<span class=\"font-label-sm text-label-sm text-on-tertiary-container uppercase tracking-wider\">Solo orientaci├│n, nunca consumo</span>\n</header>\n<!-- Main Content Scroll Area -->\n<main class=\"px-container-margin pt-gutter pb-40 min-h-screen space-y-stack-md\">\n<!-- Header Branding -->\n<div class=\"pt-4 pb-2\">\n<h1 class=\"font-headline-md-mobile text-headline-md-mobile text-primary\">VisionSetil</h1>\n<p class=\"font-body-md text-on-surface-variant\">Centro de operaciones y recursos</p>\n</div>\n<!-- Aprender Section -->\n<section class=\"space-y-base\">\n<h2 class=\"font-label-sm text-label-sm text-primary uppercase tracking-widest px-1\">Aprender</h2>\n<div class=\"space-y-2\">\n<div class=\"glass-card rounded-xl p-4 flex items-center justify-between active:scale-95 transition-transform\">\n<div class=\"flex items-center space-x-4\">\n<div class=\"w-10 h-10 rounded-full bg-primary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary\">school</span>\n</div>\n<div>\n<p class=\"font-title-lg text-title-lg\">Educaci├│n</p>\n<p class=\"text-xs text-on-surface-variant\">Cursos de micolog├¡a t├íctica</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant\">chevron_right</span>\n</div>\n<div class=\"glass-card rounded-xl p-4 flex items-center justify-between active:scale-95 transition-transform\">\n<div class=\"flex items-center space-x-4\">\n<div class=\"w-10 h-10 rounded-full bg-primary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary\">biotech</span>\n</div>\n<div>\n<p class=\"font-title-lg text-title-lg\">Lookalike Studio</p>\n<p class=\"text-xs text-on-surface-variant\">Compara especies similares</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant\">chevron_right</span>\n</div>\n</div>\n</section>\n<!-- Campo Section (Bento Inspired Layout) -->\n<section class=\"space-y-base\">\n<h2 class=\"font-label-sm text-label-sm text-primary uppercase tracking-widest px-1\">Campo</h2>\n<div class=\"grid grid-cols-2 gap-2\">\n<div class=\"glass-card rounded-xl p-4 col-span-2 flex items-center justify-between active:scale-95 transition-transform\">\n<div class=\"flex items-center space-x-4\">\n<div class=\"w-10 h-10 rounded-full bg-primary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary\">map</span>\n</div>\n<div>\n<p class=\"font-title-lg text-title-lg\">Mapa Espa├▒a cotos</p>\n<p class=\"text-xs text-on-surface-variant\">Zonas de recolecci├│n permitida</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant\">chevron_right</span>\n</div>\n<div class=\"glass-card rounded-xl p-4 flex flex-col justify-between h-32 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-primary text-3xl\">book_2</span>\n<div>\n<p class=\"font-title-lg text-body-md font-bold\">Cuaderno</p>\n<p class=\"text-[10px] text-on-surface-variant\">Historial de hallazgos</p>\n</div>\n</div>\n<div class=\"glass-card rounded-xl p-4 flex flex-col justify-between h-32 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-primary text-3xl\">cloud_download</span>\n<div>\n<p class=\"font-title-lg text-body-md font-bold\">Offline pack</p>\n<p class=\"text-[10px] text-on-surface-variant\">Datos sin conexi├│n</p>\n</div>\n</div>\n</div>\n</section>\n<!-- Comunidad Section (Visual Card) -->\n<section class=\"space-y-base\">\n<h2 class=\"font-label-sm text-label-sm text-primary uppercase tracking-widest px-1\">Comunidad</h2>\n<div class=\"relative rounded-xl overflow-hidden h-40 glass-card active:scale-95 transition-transform\" data-alt=\"A cinematic, low-angle photograph of a mystical mossy forest floor at dawn. Soft morning light filters through ancient trees, illuminating small, dew-covered mushrooms in the foreground. The color palette is rich in deep forest greens and earth tones, reflecting a scholarly and professional nature photography style. The atmosphere is calm, quiet, and mysterious, perfect for an expert mico-community background.\">\n<div class=\"absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent\"></div>\n<!-- Background Image Placeholder -->\n<div class=\"absolute inset-0 -z-10 bg-cover bg-center opacity-60\" data-alt=\"A detailed professional photograph of a dense forest floor at night, featuring bioluminescent moss and intricate mushroom structures. The lighting is cinematic with deep emerald greens and soft amber glows, creating a professional and mysterious atmosphere for a mycological community forum background.\" style=\"background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAWIkCGXPRbXL_O9ZAMRUKOAtc-kuh0--dnAeGf2mWAMY1jfcW_sBaQxZDFJmd8Qo43safOc4zKY22e5TXw8s-9B4dn-nFJpw8MnVJCltxIwfxdx9y2HgAT5zIKfwwaE2n1kRCVU8vod-XROB8jcpK4MwNBtbRcuyhwlbrwuWQGjO1qHypO42PQ5gd7qrEvp_q1j6axaAZZzTvFA3Ut2-VO_lJOrjwXiOdTxrhEI_bgzM7G_FJK--yeDVKJ3gFsV7hH77mRdQWHKy22')\"></div>\n<div class=\"absolute bottom-0 left-0 p-4 w-full flex justify-between items-end\">\n<div>\n<p class=\"font-headline-md-mobile text-lg text-on-surface leading-tight\">Comunidad (foros)</p>\n<p class=\"text-xs text-primary font-bold uppercase\">├Ünete a la expedici├│n</p>\n</div>\n<div class=\"w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center\">\n<span class=\"material-symbols-outlined\">forum</span>\n</div>\n</div>\n</div>\n<div class=\"glass-card rounded-xl p-4 flex items-center justify-between active:scale-95 transition-transform\">\n<div class=\"flex items-center space-x-4\">\n<div class=\"w-10 h-10 rounded-full bg-primary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary\">verified_user</span>\n</div>\n<div>\n<p class=\"font-title-lg text-title-lg\">Revisi├│n experta</p>\n<p class=\"text-xs text-on-surface-variant\">Validaci├│n por mic├│logos reales</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant\">chevron_right</span>\n</div>\n</section>\n<!-- Configuraci├│n Section -->\n<section class=\"space-y-base\">\n<h2 class=\"font-label-sm text-label-sm text-primary uppercase tracking-widest px-1\">Configuraci├│n</h2>\n<div class=\"space-y-2\">\n<!-- ML Dashboard locked state -->\n<div class=\"glass-card rounded-xl p-4 flex items-center justify-between opacity-80 cursor-not-allowed\">\n<div class=\"flex items-center space-x-4\">\n<div class=\"w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-on-surface-variant\">monitoring</span>\n</div>\n<div>\n<p class=\"font-title-lg text-title-lg text-on-surface-variant\">ML dashboard ops</p>\n<p class=\"text-xs text-tertiary\">Acceso bloqueado ┬À Requiere nivel Admin</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-tertiary\">lock</span>\n</div>\n<div class=\"glass-card rounded-xl p-4 flex items-center justify-between active:scale-95 transition-transform\">\n<div class=\"flex items-center space-x-4\">\n<div class=\"w-10 h-10 rounded-full bg-primary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-primary\">bug_report</span>\n</div>\n<div>\n<p class=\"font-title-lg text-title-lg\">Feedback beta</p>\n<p class=\"text-xs text-on-surface-variant\">Ay├║danos a mejorar VisionSetil</p>\n</div>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant\">chevron_right</span>\n</div>\n<div class=\"pt-4\">\n<button class=\"w-full h-14 bg-primary text-on-primary font-bold rounded-xl flex items-center justify-center space-x-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\">login</span>\n<span>Acceder</span>\n</button>\n<p class=\"text-center text-[10px] text-on-surface-variant mt-4 opacity-50\">VisionSetil v2.4.0-nightly ÔÇó OLED Optimized</p>\n</div>\n</div>\n</section>\n</main>\n<!-- Bottom Navigation Bar (JSON Structure) -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 bg-surface dark:bg-surface-dim rounded-t-xl shadow-[0px_-4px_20px_rgba(45,74,43,0.08)] flex justify-around items-center px-4 pt-2 safe-bottom\">\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-variant p-2 rounded-lg transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">home</span>\n<span class=\"font-label-md text-[10px] mt-1\">Inicio</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-variant p-2 rounded-lg transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">visibility</span>\n<span class=\"font-label-md text-[10px] mt-1\">Identificar</span>\n</a>\n<!-- FAB style center button -->\n<a class=\"flex flex-col items-center justify-center -mt-8\" href=\"#\">\n<div class=\"w-14 h-14 rounded-full bg-primary-container text-primary flex items-center justify-center shadow-lg active-glow border border-primary/20\">\n<span class=\"material-symbols-outlined text-3xl\" style=\"font-variation-settings: 'FILL' 1;\">extension</span>\n</div>\n<span class=\"font-label-md text-[10px] mt-1 text-primary-container\">Juegos</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:bg-surface-variant p-2 rounded-lg transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">book_2</span>\n<span class=\"font-label-md text-[10px] mt-1\">Biblioteca</span>\n</a>\n<a class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-full px-4 py-1 active-glow\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">more_horiz</span>\n<span class=\"font-label-md text-[10px] font-bold\">M├ís</span>\n</a>\n</nav>\n<script>\n        // Simple haptic-like interaction feel\n        document.querySelectorAll('a, .glass-card, button').forEach(el => {\n            el.addEventListener('touchstart', () => {\n                if (window.navigator.vibrate) window.navigator.vibrate(5);\n            });\n        });\n\n        // Dynamic glass effect on scroll\n        window.addEventListener('scroll', () => {\n            const scroll = window.scrollY;\n            const topBar = document.querySelector('header');\n            if (scroll > 10) {\n                topBar.classList.add('shadow-md');\n            } else {\n                topBar.classList.remove('shadow-md');\n            }\n        });\n    </script>\n</body></html>"}

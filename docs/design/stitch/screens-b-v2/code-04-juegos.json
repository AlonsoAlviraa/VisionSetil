{"screenId":"6a1d2fcf7ccd4266b0c027dd989b2948","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" name=\"viewport\"/>\n<title>MicoJuegos Hub - VisionSetil</title>\n<!-- Material Symbols -->\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Google Fonts -->\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&amp;family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n      tailwind.config = {\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"tertiary\": \"#c3cfc8\",\n                    \"on-error-container\": \"#ffdad6\",\n                    \"on-surface-variant\": \"#c2c9be\",\n                    \"surface-container-lowest\": \"#0a0f0b\",\n                    \"on-primary-fixed-variant\": \"#274f2c\",\n                    \"on-background\": \"#dfe4dd\",\n                    \"surface\": \"#101511\",\n                    \"on-tertiary-container\": \"#3b4641\",\n                    \"on-secondary\": \"#363022\",\n                    \"on-error\": \"#690005\",\n                    \"on-primary-fixed\": \"#002107\",\n                    \"background\": \"#101511\",\n                    \"surface-container-highest\": \"#313631\",\n                    \"secondary\": \"#d1c5b2\",\n                    \"outline-variant\": \"#424940\",\n                    \"surface-container-high\": \"#262b27\",\n                    \"on-tertiary-fixed-variant\": \"#3f4944\",\n                    \"error-container\": \"#93000a\",\n                    \"on-tertiary-fixed\": \"#141e1a\",\n                    \"on-secondary-container\": \"#bfb4a1\",\n                    \"on-surface\": \"#dfe4dd\",\n                    \"secondary-fixed\": \"#ede1cd\",\n                    \"on-primary\": \"#0e3817\",\n                    \"inverse-on-surface\": \"#2c322d\",\n                    \"error\": \"#ffb4ab\",\n                    \"secondary-container\": \"#4d4637\",\n                    \"on-secondary-fixed-variant\": \"#4d4637\",\n                    \"surface-container-low\": \"#181d19\",\n                    \"secondary-fixed-dim\": \"#d1c5b2\",\n                    \"tertiary-fixed\": \"#dae5df\",\n                    \"surface-bright\": \"#353a36\",\n                    \"primary-fixed-dim\": \"#a4d2a4\",\n                    \"inverse-surface\": \"#dfe4dd\",\n                    \"primary\": \"#aad8a9\",\n                    \"inverse-primary\": \"#3e6842\",\n                    \"surface-tint\": \"#a4d2a4\",\n                    \"surface-variant\": \"#313631\",\n                    \"on-secondary-fixed\": \"#201b0f\",\n                    \"outline\": \"#8c9389\",\n                    \"on-tertiary\": \"#28332e\",\n                    \"surface-container\": \"#1c211c\",\n                    \"primary-container\": \"#8fbc8f\",\n                    \"surface-dim\": \"#101511\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"margin-desktop\": \"120px\",\n                    \"base\": \"8px\",\n                    \"lg\": \"40px\",\n                    \"md\": \"24px\",\n                    \"margin-mobile\": \"20px\",\n                    \"xl\": \"64px\",\n                    \"xs\": \"4px\",\n                    \"sm\": \"12px\",\n                    \"gutter\": \"16px\"\n            },\n            \"fontFamily\": {\n                    \"label-sm\": [\"\\\"Source Serif 4\\\"\"],\n                    \"headline-lg-mobile\": [\"Playfair Display\"],\n                    \"display-lg\": [\"Playfair Display\"],\n                    \"headline-md\": [\"Playfair Display\"],\n                    \"body-lg\": [\"\\\"Source Serif 4\\\"\"],\n                    \"label-lg\": [\"\\\"Source Serif 4\\\"\"],\n                    \"headline-lg\": [\"Playfair Display\"],\n                    \"body-md\": [\"\\\"Source Serif 4\\\"\"]\n            },\n            \"fontSize\": {\n                    \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"headline-lg-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}],\n                    \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"headline-md\": [\"24px\", {\"lineHeight\": \"32px\", \"fontWeight\": \"600\"}],\n                    \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}],\n                    \"label-lg\": [\"14px\", {\"lineHeight\": \"20px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"600\"}],\n                    \"headline-lg\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                    \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}]\n            }\n          },\n        },\n      }\n    </script>\n<style>\n        body {\n            background-color: #0F1410;\n            color: #dfe4dd;\n            -webkit-font-smoothing: antialiased;\n        }\n        .glass-card {\n            background: rgba(26, 36, 32, 0.6);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(143, 188, 143, 0.1);\n            transition: transform 0.3s ease, border-color 0.3s ease;\n        }\n        .glass-card:hover {\n            transform: translateY(-4px);\n            border-color: rgba(143, 188, 143, 0.3);\n        }\n        .mesh-gradient {\n            background: radial-gradient(circle at 50% 50%, #1A2420 0%, #0F1410 100%);\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .nav-active .material-symbols-outlined {\n            font-variation-settings: 'FILL' 1;\n        }\n    </style>\n</head>\n<body class=\"flex flex-col min-h-screen\">\n<!-- TopAppBar -->\n<header class=\"bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl docked full-width top-0 z-50 border-b border-error/20 flex justify-between items-center px-margin-mobile w-full h-16 fixed\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary\" style=\"font-size: 24px;\">microbiology</span>\n<h1 class=\"font-headline-md text-headline-md text-[#E8DCC8] tracking-tight\">MicoJuegos</h1>\n</div>\n<div class=\"hidden md:flex gap-6\">\n<span class=\"font-label-lg text-label-lg text-on-surface-variant\">Solo orientaci├│n ┬À nunca consumo</span>\n</div>\n<button class=\"material-symbols-outlined text-on-surface-variant active:scale-95 transition-transform\">search</button>\n</header>\n<!-- Sticky Warning Strip Mobile -->\n<div class=\"md:hidden sticky top-16 z-40 bg-surface-container-high/80 backdrop-blur-md px-margin-mobile py-2 border-b border-outline-variant/10\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant text-center\">Solo orientaci├│n ┬À nunca consumo</p>\n</div>\n<!-- Main Content Canvas -->\n<main class=\"flex-grow pt-24 pb-32 px-margin-mobile md:px-margin-desktop max-w-7xl mx-auto w-full\">\n<header class=\"mb-lg space-y-2\">\n<h2 class=\"font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-secondary\">MicoJuegos Hub</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant max-w-xl\">Entrena tu vista y tus conocimientos micol├│gicos con nuestros retos diarios dise├▒ados por expertos en micolog├¡a forestal.</p>\n</header>\n<!-- Bento Grid for Games -->\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-gutter\">\n<!-- Card 1: Setadle -->\n<div class=\"glass-card rounded-xl overflow-hidden flex flex-col h-[500px]\">\n<div class=\"relative h-2/3 overflow-hidden\">\n<img alt=\"Mysterious forest floor\" class=\"w-full h-full object-cover transition-transform duration-700 hover:scale-105\" data-alt=\"A moody, atmospheric macro photograph of a mysterious temperate forest floor at dusk. Soft moonlight filters through tall pine trees, illuminating patches of damp emerald moss, scattered autumn leaves, and decaying wood. The deep forest greens and earthen browns create a scholarly, adventurous field journal aesthetic with high-end nature photography detail.\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLu4DSAlNRfhxOQ5YYjs6lCpsuM_kBItJq1iFKNnCjeVCwqTzksGt6BU5ZCmVX4VAadGLm5HuhGnDwk49LQHZM22DoMdlN3qzOWiDCqxiCo1Bp7tn0TPev0OGqYhMvd7gJXDIoq7iLNDKqhItpE5FGZZuRVn4By08h_JEduzDA_DfCWw-AKCFpROABAvx3nCn7nvq0gHuAuDjZQ9syCXsSdYLKp1ITjnvASQeUh9lBepXdLc-Eiygh6IgY0\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-background/80 to-transparent\"></div>\n<div class=\"absolute bottom-4 left-4\">\n<span class=\"bg-primary/20 text-primary px-3 py-1 rounded-full font-label-sm text-label-sm backdrop-blur-md border border-primary/20\">Habitat Puzzle</span>\n</div>\n</div>\n<div class=\"p-md flex flex-col justify-between flex-grow\">\n<div>\n<h3 class=\"font-headline-md text-headline-md text-on-surface mb-2\">Setadle</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant line-clamp-2\">Adivina la ubicaci├│n exacta bas├índote en las se├▒ales del ecosistema.</p>\n</div>\n<button class=\"bg-primary-container/80 hover:bg-primary-container text-on-primary-container w-full py-3 rounded-lg font-label-lg text-label-lg transition-all active:scale-95 mt-4\">JUGAR</button>\n</div>\n</div>\n<!-- Card 2: Wordle de setas -->\n<div class=\"glass-card rounded-xl overflow-hidden flex flex-col h-[500px]\">\n<div class=\"relative h-2/3 overflow-hidden\">\n<img alt=\"Red Amanita mushroom\" class=\"w-full h-full object-cover transition-transform duration-700 hover:scale-105\" data-alt=\"A stunning close-up of a vibrant red Amanita Muscaria mushroom with its iconic white spots, standing tall against a blurred dark forest background. The lighting is dramatic, highlighting the texture of the cap and the delicate gills underneath. The composition is artistic and premium, emphasizing the vibrant scarlet color against deep OLED blacks and mossy greens.\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLtRnCHC_Q9UNDRgHkcrs-sLsx5BAHNNzjXY2gBM89lv7dhcYVyjGu-E3w7EweTrShVePTmQPm87d30v5NV8KhLJEZuIEPQjIn4xoflLOsWsqrnmJQ9UMkETfE7i9dygtx06VCwJXN_XFs9W2CN_xnqZQGwUUnqBcuKoMVYQbzVucd6MK-82T_fA-y9Ic-rxXuU5WIqVgcIdHLLyMVMdtCVdPk265EvaiBm1opyK6K6fEae_A6rW_DgjEnA\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-background/80 to-transparent\"></div>\n<div class=\"absolute bottom-4 left-4\">\n<span class=\"bg-tertiary-container/20 text-tertiary px-3 py-1 rounded-full font-label-sm text-label-sm backdrop-blur-md border border-tertiary/20\">Identificaci├│n</span>\n</div>\n</div>\n<div class=\"p-md flex flex-col justify-between flex-grow\">\n<div>\n<h3 class=\"font-headline-md text-headline-md text-on-surface mb-2\">Wordle de setas</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant line-clamp-2\">Cinco intentos para identificar la especie del d├¡a. ┬┐Aceptas el reto?</p>\n</div>\n<button class=\"bg-surface-bright/20 border border-primary/40 hover:bg-surface-bright/40 text-primary w-full py-3 rounded-lg font-label-lg text-label-lg transition-all active:scale-95 mt-4\">WORDLE</button>\n</div>\n</div>\n<!-- Card 3: Reto diario -->\n<div class=\"glass-card rounded-xl overflow-hidden flex flex-col h-[500px]\">\n<div class=\"relative h-2/3 overflow-hidden\">\n<img alt=\"Macro fungal detail\" class=\"w-full h-full object-cover transition-transform duration-700 hover:scale-105\" data-alt=\"An extreme macro photograph showcasing the intricate gills and texture of a rare mushroom species. The focus is incredibly sharp on the organic geometric patterns, with a shallow depth of field that turns the rest of the forest into a soft, glowing bokeh of moss green and amber. The image evokes precision, scholarly discovery, and the tactile elegance of a field biologist's observation.\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLv9F1NngRZMGjTxRQYKiPvpD7A9hSxejzmW887CYfr7Y6IAC6tnmHS3l84f8AUutQQSCx6UODZ1xoPa_jSCsIzRVlLtubWlezlz-q9rZyVRFHLD5-TSETsFZ9lGDkJiIInVZKFvho-EvyyhKECC0SYj9iFGIFbH6Rr8mcC5QUHns1ylOeCOT01qbDLfmwrbrPJ_P-kTqN8NMMGoOlPv1WfI5CB7unldQNB-As5mKnuhGilDHqalB1yoKgs\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-background/80 to-transparent\"></div>\n<div class=\"absolute bottom-4 left-4\">\n<span class=\"bg-secondary-container/20 text-secondary px-3 py-1 rounded-full font-label-sm text-label-sm backdrop-blur-md border border-secondary/20\">Lookalike Quiz</span>\n</div>\n</div>\n<div class=\"p-md flex flex-col justify-between flex-grow\">\n<div>\n<h3 class=\"font-headline-md text-headline-md text-on-surface mb-2\">Reto diario</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant line-clamp-2\">Diferencia entre comestibles y t├│xicas en im├ígenes de alta resoluci├│n.</p>\n</div>\n<button class=\"bg-secondary-container/80 hover:bg-secondary-container text-on-secondary-container w-full py-3 rounded-lg font-label-lg text-label-lg transition-all active:scale-95 mt-4\">RETO</button>\n</div>\n</div>\n</div>\n<section class=\"mt-xl p-md border border-outline-variant/10 rounded-xl bg-surface-container-low/30 backdrop-blur-sm\">\n<h4 class=\"font-label-lg text-label-lg text-tertiary mb-base flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[18px]\">info</span>\n                Nota Educativa\n            </h4>\n<p class=\"font-body-md text-body-md text-on-surface-variant italic\">\n                Estos juegos est├ín dise├▒ados ├║nicamente con fines educativos y de entretenimiento. La identificaci├│n visual a trav├®s de una pantalla nunca debe sustituir el juicio de un experto en el campo. Nunca consumas ejemplares si no tienes certeza absoluta de su identificaci├│n.\n            </p>\n</section>\n</main>\n<!-- Footer Policy Line -->\n<footer class=\"w-full py-8 px-margin-mobile border-t border-outline-variant/10 text-center mb-24 md:mb-0\">\n<p class=\"font-label-sm text-label-sm text-on-surface-variant\">Solo orientaci├│n educativa, nunca consumo ┬À ┬® 2024 VisionSetil Mycology Hub</p>\n</footer>\n<!-- BottomNavBar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 pb-safe bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl rounded-t-xl shadow-lg border-t border-outline-variant/10 md:hidden\">\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\">home</span>\n<span class=\"font-label-sm text-label-sm mt-1\">Inicio</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\">center_focus_strong</span>\n<span class=\"font-label-sm text-label-sm mt-1\">Identificar</span>\n</a>\n<a class=\"flex flex-col items-center justify-center bg-primary-container/80 text-on-primary-container rounded-full px-4 py-1 transition-all active:scale-90 duration-200 nav-active\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">extension</span>\n<span class=\"font-label-sm text-label-sm\">Juegos</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\">menu_book</span>\n<span class=\"font-label-sm text-label-sm mt-1\">Enciclopedia</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\">more_horiz</span>\n<span class=\"font-label-sm text-label-sm mt-1\">M├ís</span>\n</a>\n</nav>\n<!-- Floating Action Button (Only on Mobile for active context) -->\n<button class=\"md:hidden fixed bottom-24 right-6 w-14 h-14 bg-primary text-on-primary rounded-full shadow-2xl flex items-center justify-center z-40 active:scale-90 transition-transform\">\n<span class=\"material-symbols-outlined\" style=\"font-size: 28px;\">camera</span>\n</button>\n<script>\n        // Smooth reveal animations for cards\n        document.addEventListener('DOMContentLoaded', () => {\n            const cards = document.querySelectorAll('.glass-card');\n            cards.forEach((card, index) => {\n                card.style.opacity = '0';\n                card.style.transform = 'translateY(20px)';\n                setTimeout(() => {\n                    card.style.transition = 'all 0.6s cubic-bezier(0.23, 1, 0.32, 1)';\n                    card.style.opacity = '1';\n                    card.style.transform = 'translateY(0)';\n                }, 100 * index);\n            });\n        });\n    </script>\n</body></html>"}

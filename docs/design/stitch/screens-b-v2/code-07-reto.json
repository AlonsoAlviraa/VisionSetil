{"screenId":"9e82598b6f174ffca43b5083e8dfb22a","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>Reto Diario - VisionSetil</title>\n<!-- Google Fonts: Playfair Display for headlines, Source Serif 4 for body/labels -->\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&amp;family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&amp;display=swap\" rel=\"stylesheet\"/>\n<!-- Material Symbols Outlined -->\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"primary\": \"#aad8a9\",\n                        \"inverse-on-surface\": \"#2c322d\",\n                        \"tertiary\": \"#c3cfc8\",\n                        \"on-tertiary-container\": \"#3b4641\",\n                        \"on-primary-container\": \"#234c29\",\n                        \"primary-container\": \"#8fbc8f\",\n                        \"secondary\": \"#d1c5b2\",\n                        \"inverse-primary\": \"#3e6842\",\n                        \"surface-container-high\": \"#262b27\",\n                        \"on-tertiary-fixed-variant\": \"#3f4944\",\n                        \"surface-tint\": \"#a4d2a4\",\n                        \"surface-container-highest\": \"#313631\",\n                        \"surface-container\": \"#1c211c\",\n                        \"on-tertiary-fixed\": \"#141e1a\",\n                        \"secondary-container\": \"#4d4637\",\n                        \"outline-variant\": \"#424940\",\n                        \"on-error-container\": \"#ffdad6\",\n                        \"background\": \"#101511\",\n                        \"on-secondary\": \"#363022\",\n                        \"on-primary\": \"#0e3817\",\n                        \"on-secondary-fixed\": \"#201b0f\",\n                        \"on-background\": \"#dfe4dd\",\n                        \"surface-container-low\": \"#181d19\",\n                        \"on-secondary-container\": \"#bfb4a1\",\n                        \"on-primary-fixed-variant\": \"#274f2c\",\n                        \"on-tertiary\": \"#28332e\",\n                        \"on-secondary-fixed-variant\": \"#4d4637\",\n                        \"surface-container-lowest\": \"#0a0f0b\",\n                        \"surface\": \"#101511\",\n                        \"inverse-surface\": \"#dfe4dd\",\n                        \"tertiary-container\": \"#a8b3ad\",\n                        \"surface-bright\": \"#353a36\",\n                        \"error-container\": \"#93000a\",\n                        \"primary-fixed-dim\": \"#a4d2a4\",\n                        \"tertiary-fixed-dim\": \"#bec9c3\",\n                        \"on-surface\": \"#dfe4dd\",\n                        \"on-error\": \"#690005\",\n                        \"on-primary-fixed\": \"#002107\",\n                        \"surface-variant\": \"#313631\",\n                        \"secondary-fixed\": \"#ede1cd\",\n                        \"primary-fixed\": \"#bfefbe\",\n                        \"outline\": \"#8c9389\",\n                        \"on-surface-variant\": \"#c2c9be\",\n                        \"tertiary-fixed\": \"#dae5df\",\n                        \"surface-dim\": \"#101511\",\n                        \"secondary-fixed-dim\": \"#d1c5b2\",\n                        \"error\": \"#ffb4ab\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"gutter\": \"16px\",\n                        \"sm\": \"12px\",\n                        \"margin-mobile\": \"20px\",\n                        \"md\": \"24px\",\n                        \"xs\": \"4px\",\n                        \"lg\": \"40px\",\n                        \"xl\": \"64px\",\n                        \"margin-desktop\": \"120px\",\n                        \"base\": \"8px\"\n                    },\n                    \"fontFamily\": {\n                        \"headline-md\": [\"Playfair Display\"],\n                        \"headline-lg-mobile\": [\"Playfair Display\"],\n                        \"label-sm\": [\"Source Serif 4\"],\n                        \"body-md\": [\"Source Serif 4\"],\n                        \"body-lg\": [\"Source Serif 4\"],\n                        \"display-lg\": [\"Playfair Display\"],\n                        \"label-lg\": [\"Source Serif 4\"],\n                        \"headline-lg\": [\"Playfair Display\"]\n                    },\n                    \"fontSize\": {\n                        \"headline-md\": [\"24px\", { \"lineHeight\": \"32px\", \"fontWeight\": \"600\" }],\n                        \"headline-lg-mobile\": [\"28px\", { \"lineHeight\": \"36px\", \"fontWeight\": \"600\" }],\n                        \"label-sm\": [\"12px\", { \"lineHeight\": \"16px\", \"fontWeight\": \"400\" }],\n                        \"body-md\": [\"16px\", { \"lineHeight\": \"24px\", \"fontWeight\": \"400\" }],\n                        \"body-lg\": [\"18px\", { \"lineHeight\": \"28px\", \"fontWeight\": \"400\" }],\n                        \"display-lg\": [\"48px\", { \"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\" }],\n                        \"label-lg\": [\"14px\", { \"lineHeight\": \"20px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"600\" }],\n                        \"headline-lg\": [\"32px\", { \"lineHeight\": \"40px\", \"fontWeight\": \"600\" }]\n                    }\n                },\n            },\n        }\n    </script>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .glass-card {\n            background-color: rgba(26, 36, 32, 0.6);\n            backdrop-filter: blur(20px);\n            -webkit-backdrop-filter: blur(20px);\n            border: 1px solid rgba(143, 188, 143, 0.1);\n        }\n        .active-glass-card {\n            background-color: rgba(26, 36, 32, 0.85);\n            border: 1px solid rgba(143, 188, 143, 0.4);\n            box-shadow: 0 0 15px rgba(170, 216, 169, 0.1);\n        }\n        body {\n            background-color: #0F1410;\n        }\n        /* Custom scrollbar for subtle aesthetic */\n        ::-webkit-scrollbar { width: 4px; }\n        ::-webkit-scrollbar-track { background: #0F1410; }\n        ::-webkit-scrollbar-thumb { background: #1A2420; border-radius: 10px; }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"text-on-background min-h-screen flex flex-col font-body-md overflow-x-hidden\">\n<!-- Top Warning Strip (Custom Identity Element) -->\n<div class=\"sticky top-0 z-[60] w-full bg-error-container/20 backdrop-blur-md border-b border-error/10 py-1.5 px-margin-mobile flex justify-center items-center\">\n<span class=\"font-label-sm text-error uppercase tracking-[0.1em] text-[10px] sm:text-xs\">\n            Solo orientaci├│n ┬À nunca consumo\n        </span>\n</div>\n<!-- Top Bar Component -->\n<header class=\"sticky top-10 z-50 flex justify-between items-center px-margin-mobile w-full h-16 bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl border-b border-error/20\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary text-2xl\" data-icon=\"microbiology\">microbiology</span>\n<h1 class=\"font-headline-md text-headline-md text-primary tracking-tight\">VisionSetil</h1>\n</div>\n<div class=\"hidden md:block\">\n<span class=\"font-label-lg text-label-lg text-on-surface-variant italic\">Identificaci├│n acad├®mica</span>\n</div>\n</header>\n<main class=\"flex-grow w-full max-w-2xl mx-auto px-margin-mobile py-base space-y-md\">\n<!-- Header Section: Reto Diario Progress -->\n<section class=\"flex justify-between items-end pt-4\">\n<div>\n<h2 class=\"font-headline-lg-mobile text-headline-lg-mobile text-on-surface\">Reto Diario</h2>\n<p class=\"font-label-lg text-label-lg text-primary/80\">Pregunta 3 de 10</p>\n</div>\n<div class=\"flex gap-1 mb-1\">\n<div class=\"w-2 h-2 rounded-full bg-primary\"></div>\n<div class=\"w-2 h-2 rounded-full bg-primary\"></div>\n<div class=\"w-2 h-2 rounded-full bg-primary\"></div>\n<div class=\"w-2 h-2 rounded-full bg-surface-container-highest\"></div>\n<div class=\"w-2 h-2 rounded-full bg-surface-container-highest\"></div>\n<div class=\"w-2 h-2 rounded-full bg-surface-container-highest\"></div>\n<div class=\"w-2 h-2 rounded-full bg-surface-container-highest\"></div>\n<div class=\"w-2 h-2 rounded-full bg-surface-container-highest\"></div>\n<div class=\"w-2 h-2 rounded-full bg-surface-container-highest\"></div>\n<div class=\"w-2 h-2 rounded-full bg-surface-container-highest\"></div>\n</div>\n</section>\n<!-- Main Content: Field Photo & Multi-view -->\n<section class=\"space-y-sm\">\n<div class=\"relative w-full aspect-[4/5] rounded-xl overflow-hidden shadow-2xl glass-card\">\n<img class=\"w-full h-full object-cover transition-opacity duration-500\" data-alt=\"A high-resolution macro photograph of an Amanita muscaria mushroom in a misty forest floor setting. The mushroom has a vibrant red cap with distinct white warts. The forest floor is covered in deep green moss and damp autumn leaves. The lighting is ethereal and atmospheric, with moonlight filtering through the canopy, highlighting the fine gill structures underneath the cap. Scholarly field journal aesthetic.\" id=\"main-challenge-image\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCgmTYG1ma-4gWVAVEx4bQTL2wbv8FNUPpBvoaO3pB0OdYDwM3Y3B4OdDgX983FShTbpAuetqBEmB75bhj1jYbhVhdQX9-hVjEkss93RKZLlYf9JXUHuJLsx-neRKlfPWLecVU27HWONa92kWW-mCPk7l7cVnPZ2VG9Us3wpzpqpVI-zF4fxBCU4SetJtT5ijlJNP9Zhi9CRrw2_kAUhNTZNZNcfnPNowEUb17khsnxe8TWY42OT9DerBkhh1urmq8QEGvNUG2u57U2\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent\"></div>\n<div class=\"absolute bottom-4 left-4 right-4\">\n<p class=\"font-label-sm text-on-surface-variant flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"location_on\">location_on</span>\n                        Bosque templado, humedad 85%\n                    </p>\n</div>\n</div>\n<!-- Multi-view Thumbnails (Interactive Selection) -->\n<div class=\"flex justify-between gap-2 overflow-x-auto pb-2 px-1 no-scrollbar\">\n<button class=\"view-btn flex-shrink-0 w-20 text-center space-y-1 active-glass-card rounded-lg p-1 transition-all\" onclick=\"changeView('perfil')\">\n<div class=\"aspect-square rounded-md overflow-hidden bg-surface-container\">\n<img class=\"w-full h-full object-cover grayscale-[0.5] hover:grayscale-0 transition-all\" data-alt=\"A side profile view of a majestic Amanita muscaria mushroom showing the full stalk, the ring or annulus, and the vibrant red cap. Set against a dark, moody forest background with atmospheric bokeh.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBH661IPX14QOTkZ4fNiO__DWd2XI7Ie02ARz-Jipzq1Hhs91kCPUWPKFDFeQSiKEEZVEFrIci08sm7BqDhD8ko9SEB2amNUVqlRiT4Ly9vFGeI83DqRS1BFHidv4LAyoXvI8cLEHhtVcn91O8KwPkqAvlWtpm6mqIK0gIW8TUxXvmI7rs06_OrViEzDXiCjdqq879l0QjZVQNMBK1yoRbR7euLTi_UGCrxbgWRcin_MnglqhRDMT8XiPkUS3axYq37Cy5MnirH7-s3\"/>\n</div>\n<span class=\"block font-label-sm text-[10px] text-primary\">Perfil</span>\n</button>\n<button class=\"view-btn flex-shrink-0 w-20 text-center space-y-1 glass-card rounded-lg p-1 transition-all\" onclick=\"changeView('laminillas')\">\n<div class=\"aspect-square rounded-md overflow-hidden bg-surface-container\">\n<img class=\"w-full h-full object-cover grayscale-[0.5] hover:grayscale-0 transition-all\" data-alt=\"Close-up macro detail of the underside of a mushroom cap showing the intricate, delicate white gills or lamellae radiating from the stem. Extreme close-up photography with high contrast and sharp focus.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuA0IQnJZoIwNptPDirao9mCWpsjJBtz5xcfm4Tfn6H2JLmo4KX3KAIR2KJW2EHVLj-lNn06K-RKuG87BnhOqNoKPHlp6cqQLrMxf7RjT0jfzLxSJ7SXH5jOXBi0SWUvpqwZ5Ngty6pa9QzPmMrdbfgDixUE37poohQ9poL8j-pSEiT5dzPvN4SaBAyDUnsR_leg-lpwKmOw_jcYzUKralgYf1bYkn8pvSE4_E4BEcSOCgYt5Xmh9BMB0om9BbyAZ1CfXeWZv6cI3Xng\"/>\n</div>\n<span class=\"block font-label-sm text-[10px] text-on-surface-variant\">L├íminas</span>\n</button>\n<button class=\"view-btn flex-shrink-0 w-20 text-center space-y-1 glass-card rounded-lg p-1 transition-all\" onclick=\"changeView('habitat')\">\n<div class=\"aspect-square rounded-md overflow-hidden bg-surface-container\">\n<img class=\"w-full h-full object-cover grayscale-[0.5] hover:grayscale-0 transition-all\" data-alt=\"Wide shot of a cluster of mushrooms growing at the base of a birch tree in a damp, shadowy European forest. The soil is covered in pine needles and decaying organic matter. Cinematic nature photography.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDlByF6s_UWGQhJph8ds5ETvnacTQ9LQFVXYNIMsGV_ygEKsqWsWyAEStdi66Jm9Dyi0WF5Y6RNQzv55MY6XdT63AWXpZl00a7y1mLmDowAP7aKvTnpJ_76jDxdulMs8LdtwOchJKrcv9WjowO83E4jqqV-KB4bZimi1-FZ2VlxeITwnLSycqv-K02mDKGk7WGENz_ipvYAk5SpNJe28QtSkuu0Y_Hvy7pWnGGUq54ODUJIjmi1dHNoJfJPX9_AGu8XG9ESvPDo21HW\"/>\n</div>\n<span class=\"block font-label-sm text-[10px] text-on-surface-variant\">H├íbitat</span>\n</button>\n<button class=\"view-btn flex-shrink-0 w-20 text-center space-y-1 glass-card rounded-lg p-1 transition-all\" onclick=\"changeView('detalle')\">\n<div class=\"aspect-square rounded-md overflow-hidden bg-surface-container\">\n<img class=\"w-full h-full object-cover grayscale-[0.5] hover:grayscale-0 transition-all\" data-alt=\"Macro extreme detail of the white scales on the cap of an Amanita muscaria mushroom. The texture is rough and calcified against the smooth red skin of the cap. Scientific observation style.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuC37fx81Y9OLJu3g5ORIvoesuOBEbSVD48M5DcOlFixu68hle7dwxyleVaMPvzl6TE1ffB3hZ1T0lJJRFAA_h13WWjnMJJPwcBzDn58_fKPxUfFGBBIN3cvKLigIAqBhpFQKcHJRY5SeASAVc6VSronuxPnWgapbDjT5KGXTxzekZvokIixdLPRr6_Q-cp4WVQSzo48PKX07hoz7gYaD8GVHdAGy3vHT-mqYL4LUeT1PKuItlEmITmugNmnWsrV9YuAIYPAw8hruEJb\"/>\n</div>\n<span class=\"block font-label-sm text-[10px] text-on-surface-variant\">Detalle</span>\n</button>\n</div>\n</section>\n<!-- Question Section -->\n<section class=\"space-y-md\">\n<div class=\"glass-card p-md rounded-xl space-y-base\">\n<p class=\"font-body-lg text-body-lg text-on-surface leading-relaxed\">\n                    ┬┐Qu├® especie es esta? Ten en cuenta sus <span class=\"text-primary italic\">l├íminas</span> y el <span class=\"text-primary italic\">anillo</span>.\n                </p>\n</div>\n<!-- Options (Bento Style Grid) -->\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-sm\">\n<button class=\"option-btn glass-card p-md rounded-xl text-left font-label-lg text-label-lg text-on-surface hover:border-primary/40 transition-all flex justify-between items-center group\" onclick=\"selectOption(this)\">\n<span>Amanita muscaria</span>\n<span class=\"material-symbols-outlined opacity-0 group-hover:opacity-100 text-primary transition-opacity\" data-icon=\"check_circle\">check_circle</span>\n</button>\n<button class=\"option-btn glass-card p-md rounded-xl text-left font-label-lg text-label-lg text-on-surface hover:border-primary/40 transition-all flex justify-between items-center group\" onclick=\"selectOption(this)\">\n<span>Amanita caesarea</span>\n<span class=\"material-symbols-outlined opacity-0 group-hover:opacity-100 text-primary transition-opacity\" data-icon=\"check_circle\">check_circle</span>\n</button>\n<button class=\"option-btn glass-card p-md rounded-xl text-left font-label-lg text-label-lg text-on-surface hover:border-primary/40 transition-all flex justify-between items-center group\" onclick=\"selectOption(this)\">\n<span>Russula emetica</span>\n<span class=\"material-symbols-outlined opacity-0 group-hover:opacity-100 text-primary transition-opacity\" data-icon=\"check_circle\">check_circle</span>\n</button>\n<button class=\"option-btn glass-card p-md rounded-xl text-left font-label-lg text-label-lg text-on-surface hover:border-primary/40 transition-all flex justify-between items-center group\" onclick=\"selectOption(this)\">\n<span>Amanita pantherina</span>\n<span class=\"material-symbols-outlined opacity-0 group-hover:opacity-100 text-primary transition-opacity\" data-icon=\"check_circle\">check_circle</span>\n</button>\n</div>\n</section>\n<!-- Spacer for Bottom Nav -->\n<div class=\"h-24\"></div>\n</main>\n<!-- Fixed Footer Action -->\n<div class=\"fixed bottom-20 left-0 w-full px-margin-mobile z-40 md:static md:px-0 md:pb-lg\">\n<div class=\"max-w-2xl mx-auto\">\n<button class=\"w-full bg-primary-container text-on-primary-container font-label-lg text-label-lg py-4 rounded-xl shadow-lg hover:brightness-110 active:scale-95 transition-all flex items-center justify-center gap-2 uppercase tracking-widest\">\n<span>Verificar</span>\n<span class=\"material-symbols-outlined\" data-icon=\"arrow_forward\">arrow_forward</span>\n</button>\n</div>\n</div>\n<!-- Bottom Navigation Bar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 pb-safe bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl border-t border-outline-variant/10 shadow-lg rounded-t-xl\">\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"home\">home</span>\n<span class=\"font-label-sm text-label-sm\">Inicio</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"center_focus_strong\">center_focus_strong</span>\n<span class=\"font-label-sm text-label-sm\">Identificar</span>\n</a>\n<a class=\"flex flex-col items-center justify-center bg-primary-container/80 text-on-primary-container rounded-full px-4 py-1 active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"extension\" style=\"font-variation-settings: 'FILL' 1;\">extension</span>\n<span class=\"font-label-sm text-label-sm\">Juegos</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"menu_book\">menu_book</span>\n<span class=\"font-label-sm text-label-sm\">Enciclopedia</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"more_horiz\">more_horiz</span>\n<span class=\"font-label-sm text-label-sm\">M├ís</span>\n</a>\n</nav>\n<script>\n        function selectOption(el) {\n            // Remove active classes from all\n            document.querySelectorAll('.option-btn').forEach(btn => {\n                btn.classList.remove('active-glass-card', 'border-primary/60');\n                btn.querySelector('.material-symbols-outlined').classList.add('opacity-0');\n            });\n            // Add active classes to selected\n            el.classList.add('active-glass-card', 'border-primary/60');\n            el.querySelector('.material-symbols-outlined').classList.remove('opacity-0');\n        }\n\n        function changeView(view) {\n            // In a real app, this would change the src of #main-challenge-image\n            // and update button states. For this demo, we'll just toggle button styles.\n            document.querySelectorAll('.view-btn').forEach(btn => {\n                btn.classList.remove('active-glass-card');\n                btn.classList.add('glass-card');\n                btn.querySelector('span').classList.replace('text-primary', 'text-on-surface-variant');\n            });\n            \n            const clickedBtn = event.currentTarget;\n            clickedBtn.classList.remove('glass-card');\n            clickedBtn.classList.add('active-glass-card');\n            clickedBtn.querySelector('span').classList.replace('text-on-surface-variant', 'text-primary');\n\n            // Subtle opacity transition on main image to simulate load\n            const img = document.getElementById('main-challenge-image');\n            img.style.opacity = '0.7';\n            setTimeout(() => {\n                img.style.opacity = '1';\n            }, 300);\n        }\n    </script>\n</body></html>"}

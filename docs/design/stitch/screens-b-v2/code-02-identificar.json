{"screenId":"a12b45ad4d134bf08fa65e8a00d6e73f","projectId":"12549746111619294405","htmlContent":"<!DOCTYPE html>\n\n<html class=\"dark\" lang=\"es\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" name=\"viewport\"/>\n<title>VisionSetil - Identificar</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&amp;family=Hanken+Grotesk:wght@400;600;700&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"primary-fixed-dim\": \"#accfb8\",\n                        \"tertiary-container\": \"#900502\",\n                        \"inverse-surface\": \"#e3e3df\",\n                        \"secondary-container\": \"#494a38\",\n                        \"on-error\": \"#690005\",\n                        \"primary\": \"#accfb8\",\n                        \"on-primary\": \"#173627\",\n                        \"on-tertiary-container\": \"#ff9787\",\n                        \"on-secondary\": \"#303221\",\n                        \"tertiary-fixed\": \"#ffdad4\",\n                        \"on-tertiary\": \"#690000\",\n                        \"on-surface-variant\": \"#c2c8c1\",\n                        \"inverse-primary\": \"#466553\",\n                        \"surface-container-highest\": \"#333533\",\n                        \"surface\": \"#121412\",\n                        \"secondary-fixed-dim\": \"#c8c8b0\",\n                        \"primary-fixed\": \"#c7ebd4\",\n                        \"secondary-fixed\": \"#e4e4cc\",\n                        \"surface-variant\": \"#333533\",\n                        \"on-secondary-fixed\": \"#1b1d0e\",\n                        \"on-error-container\": \"#ffdad6\",\n                        \"inverse-on-surface\": \"#2f312f\",\n                        \"error-container\": \"#93000a\",\n                        \"background\": \"#121412\",\n                        \"surface-tint\": \"#accfb8\",\n                        \"tertiary-fixed-dim\": \"#ffb4a8\",\n                        \"on-surface\": \"#e3e3df\",\n                        \"surface-dim\": \"#121412\",\n                        \"tertiary\": \"#ffb4a8\",\n                        \"on-primary-container\": \"#99bca6\",\n                        \"on-secondary-container\": \"#b9baa3\",\n                        \"on-primary-fixed-variant\": \"#2e4d3c\",\n                        \"surface-container-high\": \"#292a29\",\n                        \"on-background\": \"#e3e3df\",\n                        \"on-primary-fixed\": \"#012113\",\n                        \"surface-container\": \"#1e201e\",\n                        \"on-tertiary-fixed-variant\": \"#920703\",\n                        \"surface-bright\": \"#383a38\",\n                        \"primary-container\": \"#2d4c3b\",\n                        \"outline-variant\": \"#424843\",\n                        \"outline\": \"#8c928c\",\n                        \"on-secondary-fixed-variant\": \"#474836\",\n                        \"on-tertiary-fixed\": \"#410000\",\n                        \"surface-container-lowest\": \"#0d0f0d\",\n                        \"surface-container-low\": \"#1a1c1a\",\n                        \"secondary\": \"#c8c8b0\",\n                        \"error\": \"#ffb4ab\",\n                        \"glass\": \"#1A2420\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"container-padding\": \"20px\",\n                        \"stack-md\": \"24px\",\n                        \"stack-lg\": \"48px\",\n                        \"gutter\": \"16px\",\n                        \"base\": \"8px\",\n                        \"stack-sm\": \"12px\"\n                    },\n                    \"fontFamily\": {\n                        \"display-lg\": [\"Playfair Display\"],\n                        \"headline-md-mobile\": [\"Playfair Display\"],\n                        \"body-md\": [\"Hanken Grotesk\"],\n                        \"label-sm\": [\"Hanken Grotesk\"],\n                        \"headline-md\": [\"Playfair Display\"],\n                        \"title-lg\": [\"Hanken Grotesk\"],\n                        \"body-lg\": [\"Hanken Grotesk\"]\n                    },\n                    \"fontSize\": {\n                        \"display-lg\": [\"48px\", {\"lineHeight\": \"56px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                        \"headline-md-mobile\": [\"28px\", {\"lineHeight\": \"36px\", \"fontWeight\": \"600\"}],\n                        \"body-md\": [\"16px\", {\"lineHeight\": \"24px\", \"fontWeight\": \"400\"}],\n                        \"label-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"700\"}],\n                        \"headline-md\": [\"32px\", {\"lineHeight\": \"40px\", \"fontWeight\": \"600\"}],\n                        \"title-lg\": [\"20px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"600\"}],\n                        \"body-lg\": [\"18px\", {\"lineHeight\": \"28px\", \"fontWeight\": \"400\"}]\n                    }\n                }\n            }\n        }\n    </script>\n<style>\n        body {\n            background-color: #121412; /* OLED Night Field */\n            color: #e3e3df;\n            -webkit-tap-highlight-color: transparent;\n            overflow-x: hidden;\n        }\n        .glass-card {\n            background: rgba(26, 36, 32, 0.4);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(232, 220, 200, 0.1);\n        }\n        .framing-guide {\n            border: 1.5px dashed rgba(172, 207, 184, 0.4);\n        }\n        .mesh-bg {\n            position: fixed;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            z-index: -1;\n            background: radial-gradient(circle at 50% 50%, #1a2420 0%, #121412 100%);\n        }\n        .safe-bottom {\n            padding-bottom: calc(80px + env(safe-area-inset-bottom));\n        }\n    </style>\n</head>\n<body class=\"font-body-md text-body-md selection:bg-primary-container\">\n<div class=\"mesh-bg\"></div>\n<!-- Top Navigation Anchor (Warning Banner) -->\n<header class=\"fixed top-0 left-0 w-full z-50\">\n<div class=\"bg-tertiary-container text-white py-1.5 px-4 text-center\">\n<span class=\"font-label-sm text-label-sm tracking-widest uppercase\">Solo orientaci├│n ┬À nunca consumo</span>\n</div>\n<div class=\"bg-surface-container/60 backdrop-blur-xl border-b border-error/20 h-16 flex items-center justify-between px-5\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary text-2xl\">microbiology</span>\n<h1 class=\"font-headline-md-mobile text-headline-md-mobile text-primary tracking-tight\">VisionSetil</h1>\n</div>\n<div class=\"flex items-center gap-2\">\n<button class=\"w-10 h-10 flex items-center justify-center rounded-full hover:bg-surface-bright/20 transition-colors active:scale-90\">\n<span class=\"material-symbols-outlined text-on-surface-variant\">search</span>\n</button>\n</div>\n</div>\n</header>\n<!-- Main Content -->\n<main class=\"pt-24 px-5 safe-bottom\">\n<!-- Section Header -->\n<div class=\"mb-6\">\n<h2 class=\"font-headline-md-mobile text-headline-md-mobile text-on-surface mb-2\">Identificaci├│n Multi-vista</h2>\n<div class=\"glass-card rounded-xl p-4 flex items-start gap-4\">\n<span class=\"material-symbols-outlined text-primary mt-0.5\">info</span>\n<p class=\"font-label-sm text-label-sm text-on-surface-variant leading-relaxed\">\n                    Capturar m├║ltiples ├íngulos cr├¡ticos aumenta la precisi├│n del an├ílisis por IA en un 40%. Sigue las gu├¡as visuales para mejores resultados.\n                </p>\n</div>\n</div>\n<!-- Multi-view Slot Wizard -->\n<div class=\"grid grid-cols-2 gap-4 mb-8\">\n<!-- Slot 1: Laminillas -->\n<div class=\"flex flex-col gap-2\">\n<div class=\"aspect-square glass-card rounded-2xl overflow-hidden relative group active:scale-[0.98] transition-transform cursor-pointer\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A macro low-light photography of the underside of a mushroom cap showing detailed pinkish-brown gills, artistic and scientific style, moss green highlights, OLED black background.\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAc2T6fxzwmNGqWR-jLtcTsUvsi3s6rvoMosq7USPfwU34MlHSfGv-KeZXlX7o0mwFNZPFIvTv5b9wGYVbE3ZqXhNqxLKYZn31vnuVoTfd5SIFm_95do9_iuVi8nRb2QGyH3oxJJPlOI9c-vB6cB3b4MFHcW1XXo-BgNUaA4it2X8uZxUtG_-vbFbdQXBimaNfxrs2l8mBjwUgLA3nrSm9g46kJp889THW3wNRJNDo0wH5kshsxjCQp9Oge_Pp3jiypeuCcsjPsycWF\"/>\n<div class=\"absolute inset-0 framing-guide rounded-2xl m-3 pointer-events-none\"></div>\n<div class=\"absolute top-3 right-3 bg-primary text-on-primary w-6 h-6 rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n</div>\n<label class=\"font-label-sm text-label-sm text-center text-on-surface-variant\">Laminillas</label>\n</div>\n<!-- Slot 2: Perfil -->\n<div class=\"flex flex-col gap-2\">\n<div class=\"aspect-square glass-card rounded-2xl overflow-hidden relative group active:scale-[0.98] transition-transform cursor-pointer\">\n<img class=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLtRnCHC_Q9UNDRgHkcrs-sLsx5BAHNNzjXY2gBM89lv7dhcYVyjGu-E3w7EweTrShVePTmQPm87d30v5NV8KhLJEZuIEPQjIn4xoflLOsWsqrnmJQ9UMkETfE7i9dygtx06VCwJXN_XFs9W2CN_xnqZQGwUUnqBcuKoMVYQbzVucd6MK-82T_fA-y9Ic-rxXuU5WIqVgcIdHLLyMVMdtCVdPk265EvaiBm1opyK6K6fEae_A6rW_DgjEnA\"/>\n<div class=\"absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors\"></div>\n<div class=\"absolute top-3 right-3 bg-primary text-on-primary w-6 h-6 rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n</div>\n<label class=\"font-label-sm text-label-sm text-center text-on-surface-variant\">Perfil</label>\n</div>\n<!-- Slot 3: H├íbitat -->\n<div class=\"flex flex-col gap-2\">\n<div class=\"aspect-square glass-card rounded-2xl overflow-hidden relative group flex flex-col items-center justify-center border-dashed border-2 border-primary/30 active:scale-[0.98] transition-transform cursor-pointer\">\n<span class=\"material-symbols-outlined text-primary/50 text-3xl mb-2\">forest</span>\n<span class=\"font-label-sm text-label-sm text-primary/60\">A├▒adir H├íbitat</span>\n<div class=\"absolute inset-0 framing-guide rounded-2xl m-3 pointer-events-none\"></div>\n</div>\n<label class=\"font-label-sm text-label-sm text-center text-on-surface-variant\">H├íbitat</label>\n</div>\n<!-- Slot 4: Detalle -->\n<div class=\"flex flex-col gap-2\">\n<div class=\"aspect-square glass-card rounded-2xl overflow-hidden relative group active:scale-[0.98] transition-transform cursor-pointer\">\n<img class=\"w-full h-full object-cover\" src=\"https://lh3.googleusercontent.com/aida/AP1WRLvFsZU-B-2sHcMCEltwm4lp_depThybb8Xxr1kpRzy8wtMHWqf5_5iupOo1DC4U9dQjPns0NIWtDY6pz87JV_HTQoiqDRyXLKjU61EjV09mjLTVpTs6RFv0fT3UVZhuYgbZIB4Eh5MDIi_6rHa_MCjDist8cCGEZWpizabmkZymbkyoRpsCFFeOgfsuDEnwL87F7UD1muO13aiw7ikC8Q-KSmMFIEqScCEIj6-XS56XoI7SOAzcnqjvbNYB\"/>\n<div class=\"absolute top-3 right-3 bg-primary text-on-primary w-6 h-6 rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n</div>\n<label class=\"font-label-sm text-label-sm text-center text-on-surface-variant\">Detalle</label>\n</div>\n</div>\n<!-- Metadata Chips -->\n<div class=\"flex flex-wrap gap-2 mb-10\">\n<div class=\"glass-card px-4 py-2 rounded-full flex items-center gap-2 border-primary/20\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">signal_cellular_alt</span>\n<span class=\"font-label-sm text-label-sm text-primary\">Densidad: Alta</span>\n</div>\n<div class=\"glass-card px-4 py-2 rounded-full flex items-center gap-2 border-primary/20\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">wb_twilight</span>\n<span class=\"font-label-sm text-label-sm text-primary\">Luz: Bosque sombr├¡o</span>\n</div>\n<div class=\"glass-card px-4 py-2 rounded-full flex items-center gap-2 border-primary/20\">\n<span class=\"material-symbols-outlined text-primary text-[18px]\">location_on</span>\n<span class=\"font-label-sm text-label-sm text-primary\">GPS: Activo</span>\n</div>\n</div>\n<!-- Primary Action -->\n<button class=\"w-full py-5 bg-primary text-on-primary rounded-2xl font-title-lg text-title-lg shadow-2xl active:scale-95 transition-all mb-4 relative overflow-hidden group\">\n<span class=\"relative z-10 flex items-center justify-center gap-2\">\n<span class=\"material-symbols-outlined\">analytics</span>\n                Analizar\n            </span>\n<div class=\"absolute inset-0 bg-white/20 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-500 pointer-events-none\"></div>\n</button>\n<p class=\"text-center text-on-surface-variant/50 font-label-sm text-[10px] uppercase tracking-widest px-8\">\n            El an├ílisis requiere conexi├│n a red para procesamiento neuronal remoto.\n        </p>\n</main>\n<!-- Bottom Navigation Bar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-4 py-2 pb-safe bg-surface-container/60 dark:bg-surface-container/60 backdrop-blur-xl border-t border-outline-variant/10 rounded-t-xl shadow-lg\">\n<!-- Inicio -->\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined\">home</span>\n<span class=\"font-label-sm text-label-sm\">Inicio</span>\n</div>\n<!-- Identificar (Active) -->\n<div class=\"flex flex-col items-center justify-center bg-primary-container/80 text-on-primary-container rounded-full px-4 py-1 active:scale-90 transition-all duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">center_focus_strong</span>\n<span class=\"font-label-sm text-label-sm\">Identificar</span>\n</div>\n<!-- Juegos -->\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined\">extension</span>\n<span class=\"font-label-sm text-label-sm\">Juegos</span>\n</div>\n<!-- Enciclopedia -->\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined\">menu_book</span>\n<span class=\"font-label-sm text-label-sm\">Enciclopedia</span>\n</div>\n<!-- M├ís -->\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant hover:text-primary transition-colors active:scale-90 transition-all duration-200 cursor-pointer\">\n<span class=\"material-symbols-outlined\">more_horiz</span>\n<span class=\"font-label-sm text-label-sm\">M├ís</span>\n</div>\n</nav>\n<script>\n        // Simple Micro-interaction for slots\n        document.querySelectorAll('.aspect-square').forEach(slot => {\n            slot.addEventListener('click', () => {\n                // Haptic feedback simulation\n                if (window.navigator && window.navigator.vibrate) {\n                    window.navigator.vibrate(10);\n                }\n            });\n        });\n\n        // Background subtle pulse\n        const bg = document.querySelector('.mesh-bg');\n        let opacity = 1;\n        let direction = -1;\n        setInterval(() => {\n            opacity += direction * 0.005;\n            if (opacity < 0.8 || opacity > 1) direction *= -1;\n            bg.style.opacity = opacity;\n        }, 100);\n    </script>\n</body></html>"}

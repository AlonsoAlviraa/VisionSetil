# VisionSetil Frontend Environment Variables
# Copy to .env.local and customize.
# Production / beta preview: set these in the host dashboard, then rebuild
# (Vite bakes import.meta.env at build time).
# See docs/HOSTING_DEPLOY_BETA.md

# Backend API URL (use /api in dev for proxy; same-origin /api recommended for beta)
VITE_API_URL=/api

# API Key (only if backend has API_KEYS enabled for browser clients)
VITE_API_KEY=

# Public HTTPS URL of this app (invite links, GTM share copy).
# Production: https only (http allowed only for localhost / 127.0.0.1).
# Example: https://beta.yourdomain.example
# If empty, Home shows ops warning; betaInviteMessageEs falls back to
# https://app.visionsetil.local placeholder — pass appUrl explicitly for real invites.
# VITE_PUBLIC_APP_URL=https://beta.YOURDOMAIN.example

# GTM beta cohort feedback form (Google Form / Typeform).
# If empty, Home/footer use mailto fallback — set before inviting real cohort.
# See docs/GTM_BETA_COHORT.md
# VITE_BETA_FEEDBACK_URL=https://forms.gle/YOUR_FORM_ID
